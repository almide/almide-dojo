test "hidden: negatives have one leading minus" {
  let us = Grouped { group: ",", decimal: "." }
  assert_eq(us.format(-12345), "-123.45")
  assert_eq(us.format(-123456), "-1,234.56")
  assert_eq(us.format(-50), "-0.50")
  assert_eq(us.format(-100000000), "-1,000,000.00")
}
test "hidden: group boundaries" {
  let us = Grouped { group: ",", decimal: "." }
  assert_eq(us.format(99900), "999.00")
  assert_eq(us.format(100000), "1,000.00")
  assert_eq(us.format(10000000), "100,000.00")
  assert_eq(us.format(0), "0.00")
  assert_eq(us.format(7), "0.07")
}
test "hidden: credits in an invoice" {
  let eu = Grouped { group: " ", decimal: "," }
  assert_eq(invoice_in(Local(eu), [("refund", -250000), ("fee", 100)]), ["refund: -2 500,00", "fee: 1,00", "total: -2 499,00"])
  assert_eq(invoice_in(Raw(PlainFormat {}), []), ["total: 0.00"])
}
