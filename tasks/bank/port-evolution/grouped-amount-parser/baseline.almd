// An amount-parsing port: text to cents, or why the text is not an amount.
protocol AmountParser {
  fn parse(p: Self, text: String) -> Int!
}

fn all_digits(s: String) -> Bool = s != "" and string.is_digit(s)

// Digits, optionally "." and exactly two digits: "12", "12.50".
type Plain: AmountParser = {}
fn Plain.parse(p: Plain, text: String) -> Int! =
  match string.split_once(text, ".") {
    none => if all_digits(text) then ok((int.parse(text)!) * 100) else err("bad amount: " + text),
    some((whole, cents)) =>
      if all_digits(whole) and all_digits(cents) and string.len(cents) == 2 then ok((int.parse(whole)!) * 100 + int.parse(cents)!)
      else err("bad amount: " + text),
  }

// The total of every amount; the first bad text (in order) is the error.
fn sum_all[P: AmountParser](p: P, texts: List[String]) -> Int! = {
  var total = 0
  for t in texts {
    total = total + p.parse(t)!
  }
  total
}
