test "hidden: window wraps past midnight" {
  let q = QuietHours { inner: Sms { max_len: 20 }, start: 1320, end: 420 }
  assert_eq(q.send(1400, "a", "x"), err("quiet hours"))
  assert_eq(q.send(30, "a", "x"), err("quiet hours"))
  assert_eq(q.send(1320, "a", "x"), err("quiet hours"))
  assert_eq(q.send(420, "a", "x"), ok("sms:a@420"))
  assert_eq(q.send(1319, "a", "x"), ok("sms:a@1319"))
}
test "hidden: bounds of a daytime window and the empty window" {
  let q = QuietHours { inner: Sms { max_len: 20 }, start: 720, end: 780 }
  assert_eq(q.send(720, "a", "x"), err("quiet hours"))
  assert_eq(q.send(780, "a", "x"), ok("sms:a@780"))
  let none_quiet = QuietHours { inner: Sms { max_len: 20 }, start: 600, end: 600 }
  assert_eq(broadcast_via(Quiet(none_quiet), 600, ["a"], "x"), ["ok sms:a@600"])
}
test "hidden: inner errors pass through outside quiet hours" {
  let q = QuietHours { inner: Sms { max_len: 3 }, start: 0, end: 60 }
  assert_eq(broadcast_via(Quiet(q), 61, ["a", "b"], "long"), ["failed a: too long: 4", "failed b: too long: 4"])
  assert_eq(broadcast_via(Quiet(q), 59, ["a"], "long"), ["failed a: quiet hours"])
  assert_eq(delivered(q, 100, ["a", "b"], "ok"), 2)
}
