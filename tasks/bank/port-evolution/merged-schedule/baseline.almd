// A schedule port: the first firing time strictly after `t`, if any.
protocol Schedule {
  fn next_after(s: Self, t: Int) -> Int?
}

// Fires at offset, offset + period, offset + 2*period, ... (period >= 1).
type Every: Schedule = { period: Int, offset: Int }
fn Every.next_after(s: Every, t: Int) -> Int? =
  if t < s.offset then some(s.offset)
  else some(s.offset + ((t - s.offset) / s.period + 1) * s.period)

// Fires once, at `at`.
type Once: Schedule = { at: Int }
fn Once.next_after(s: Once, t: Int) -> Int? = if s.at > t then some(s.at) else none

// The next `n` firing times after `t`, fewer when the schedule runs out.
fn upcoming[S: Schedule](s: S, t: Int, n: Int) -> List[Int] =
  if n <= 0 then []
  else match s.next_after(t) {
    some(x) => [x] + upcoming(s, x, n - 1),
    none => [],
  }
