// An access-log format port.
type Hit = { method: String, path: String, status: Int, agent: String }

protocol LogFormat {
  fn line(f: Self, h: Hit) -> String
}

// "GET /a 200 curl/8" (fields separated by single spaces).
type Common: LogFormat = {}
fn Common.line(f: Common, h: Hit) -> String =
  h.method + " " + h.path + " " + int.to_string(h.status) + " " + h.agent

// One line per hit; hits with a status below `min_status` are left out.
fn dump[F: LogFormat](f: F, hits: List[Hit], min_status: Int) -> String =
  hits |> list.filter((h) => h.status >= min_status) |> list.map((h) => f.line(h)) |> list.join("\n")
