test "hidden: negative seeds lose no key" {
  let h = Hashed { seed: -1000 }
  assert_eq(h.bucket("", 7), 1)
  assert_eq(h.bucket("a", 10), 7)
  let keys = ["", "a", "b", "zz"]
  let counts = spread(h, keys, 5) |> list.map((b) => list.len(b)) |> list.sum
  assert_eq(counts, 4)
  assert_eq(histogram_with(Hash(h), ["", "a"], 4), "b0=1 b1=1 b2=0 b3=0")
}
test "hidden: one bucket and the empty key" {
  assert_eq(histogram_with(Hash(Hashed { seed: -5 }), ["x", "y"], 1), "b0=2")
  assert_eq(Hashed { seed: 12 }.bucket("", 5), 2)
}
test "hidden: length scheme unchanged" {
  assert_eq(spread(ByLength {}, ["aaa", "b", ""], 2), [[""], ["aaa", "b"]])
}
