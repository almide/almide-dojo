// Plausible wrong patch: drops empty tokens at the end like the plain lexer does,
// so a quoted "" disappears. Passes the visible tests.
// A command-line lexer port: the tokens of one input line, or why it cannot be split.
protocol Lexer {
  fn tokens(l: Self, line: String) -> List[String]!
}

// Tokens are separated by one or more spaces.
type Spaces: Lexer = {}
fn Spaces.tokens(l: Spaces, line: String) -> List[String]! =
  string.split(line, " ") |> list.filter((t) => t != "")

// Lexer state: finished tokens, the token being built (none between tokens),
// whether we are inside quotes, whether the previous char was a backslash there.
type Lex = { done: List[String], cur: String?, quoted: Bool, escaped: Bool }

fn step(s: Lex, ch: String) -> Lex =
  if s.quoted then {
    let cur = s.cur ?? ""
    if s.escaped then Lex { ...s, cur: some(cur + ch), escaped: false }
    else if ch == "\\" then Lex { ...s, escaped: true }
    else if ch == "\"" then Lex { ...s, quoted: false }
    else Lex { ...s, cur: some(cur + ch) }
  }
  else if ch == " " then match s.cur {
    some(t) => Lex { ...s, done: s.done + [t], cur: none },
    none => s,
  }
  else if ch == "\"" then Lex { ...s, cur: some(s.cur ?? ""), quoted: true }
  else Lex { ...s, cur: some((s.cur ?? "") + ch) }

// Spaces separate tokens; double quotes group, with \" and \\ escapes inside.
type Quoted: Lexer = {}
fn Quoted.tokens(l: Quoted, line: String) -> List[String]! = {
  let end = string.chars(line) |> list.fold(Lex { done: [], cur: none, quoted: false, escaped: false }, step)
  guard not end.quoted else err("unterminated quote")
  (end.done + option.to_list(end.cur)) |> list.filter((t) => t != "")
}

// "name(arg1|arg2)"; a line without tokens is an error, lexer errors pass through.
fn command[L: Lexer](l: L, line: String) -> String! = {
  let ts = l.tokens(line)!
  match ts {
    [] => err("empty line"),
    [name, ..args] => ok(name + "(" + list.join(args, "|") + ")"),
  }
}

type Mode = | Plain(Spaces) | Shell(Quoted)

fn run(m: Mode, line: String) -> String! =
  match m {
    Plain(s) => command(s, line),
    Shell(q) => command(q, line),
  }
