// A rate-limiter port. `take` answers whether a request arriving at time `now`
// is admitted, together with the limiter's next state. Times are >= 0 and
// arrive in non-decreasing order.
protocol Limiter {
  fn take(l: Self, now: Int) -> (Bool, Self)
}

// At most `max` requests per aligned window [k*window, (k+1)*window).
type FixedWindow: Limiter = { window: Int, max: Int, start: Int, used: Int }

fn fixed(window: Int, max: Int) -> FixedWindow = FixedWindow { window: window, max: max, start: 0, used: 0 }

fn FixedWindow.take(l: FixedWindow, now: Int) -> (Bool, FixedWindow) = {
  let start = now / l.window * l.window
  let used = if start == l.start then l.used else 0
  if used < l.max then (true, FixedWindow { ...l, start: start, used: used + 1 })
  else (false, FixedWindow { ...l, start: start, used: used })
}

// The admission decision for each request time, in order, threading the state.
fn admit[L: Limiter](l: L, times: List[Int]) -> List[Bool] = {
  let (_, out) = times |> list.fold((l, []), ((cur, acc), t) => {
    let (pass, next) = cur.take(t)
    (next, acc + [pass])
  })
  out
}

fn admitted[L: Limiter](l: L, times: List[Int]) -> Int =
  admit(l, times) |> list.count((pass) => pass)
