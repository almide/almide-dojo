// An access-policy port with three answers.
type Decision: Eq, Repr = | Allow | Deny | Abstain

protocol Policy {
  fn decide(p: Self, user: String, res: String) -> Decision
}

// One rule: for `user` ("*" = anyone) on resources starting with `prefix`, allow
// or deny; any other request is not its business.
type Rule: Policy = { user: String, prefix: String, allow: Bool }
fn Rule.decide(r: Rule, user: String, res: String) -> Decision =
  if (r.user == "*" or r.user == user) and string.starts_with(res, r.prefix) then
    (if r.allow then Allow else Deny)
  else Abstain

// Only an explicit Allow grants access.
fn permitted[P: Policy](p: P, user: String, res: String) -> Bool = p.decide(user, res) == Allow

fn explain[P: Policy](p: P, user: String, res: String) -> String =
  match p.decide(user, res) {
    Allow => user + " may use " + res,
    Deny => user + " is denied " + res,
    Abstain => "no rule for " + user + " on " + res,
  }
