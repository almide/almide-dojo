// A package-registry port: the direct dependencies of a package, none if unknown.
protocol Registry {
  fn deps(r: Self, pkg: String) -> List[String]?
}

type Index: Registry = { packages: Map[String, List[String]] }
fn Index.deps(r: Index, pkg: String) -> List[String]? = map.get(r.packages, pkg)

// Depth-first: a package's dependencies (in listed order) before the package, each
// package once. Unknown packages and cycles are errors.
fn visit[R: Registry](r: R, pkg: String, path: List[String], done: List[String]) -> List[String]! = {
  guard not list.contains(path, pkg) else err("cycle at " + pkg)
  if list.contains(done, pkg) then ok(done)
  else {
    let ds = option.to_result(r.deps(pkg), "unknown package: " + pkg)!
    var acc = done
    for d in ds {
      acc = visit(r, d, path + [pkg], acc)!
    }
    ok(acc + [pkg])
  }
}

fn install_order[R: Registry](r: R, root: String) -> List[String]! = visit(r, root, [], [])
