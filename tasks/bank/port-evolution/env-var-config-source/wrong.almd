// Plausible wrong patch: returns an empty variable as the text "", so it is read
// as a bad int instead of falling back. Passes the visible tests.
// A configuration-source port: the raw text of a setting such as "db.pool-size".
protocol Config {
  fn raw(c: Self, key: String) -> String?
}

type FileConfig: Config = { entries: Map[String, String] }
fn FileConfig.raw(c: FileConfig, key: String) -> String? = map.get(c.entries, key)

fn var_name(prefix: String, key: String) -> String =
  prefix + "_" + string.to_upper(string.replace(string.replace(key, ".", "_"), "-", "_"))

// Environment variables.
type EnvConfig: Config = { prefix: String, vars: Map[String, String] }
fn EnvConfig.raw(c: EnvConfig, key: String) -> String? =
  map.get(c.vars, var_name(c.prefix, key))

// An integer setting; a missing setting is `fallback`, unreadable text is an error.
fn get_int[C: Config](c: C, key: String, fallback: Int) -> Int! =
  match c.raw(key) {
    none => ok(fallback),
    some(text) => int.parse(text) |> result.map_err((_) => "bad int for " + key + ": " + text),
  }

// "key=value" for each key with its integer value (fallback 0); the first error wins.
fn summary[C: Config](c: C, keys: List[String]) -> String! = {
  var parts: List[String] = []
  for k in keys {
    parts = parts + [k + "=" + int.to_string(get_int(c, k, 0)!)]
  }
  list.join(parts, " ")
}

type Source = | File(FileConfig) | Env(EnvConfig)

fn summary_from(s: Source, keys: List[String]) -> String! =
  match s {
    File(f) => summary(f, keys),
    Env(e) => summary(e, keys),
  }
