// A retry-delay port: how long to wait (ms) before retry number `attempt`
// (1-based), or none to give up.
protocol Backoff {
  fn delay(b: Self, attempt: Int) -> Int?
}

// The same pause every time, for at most `attempts` retries.
type Steady: Backoff = { ms: Int, attempts: Int }
fn Steady.delay(b: Steady, attempt: Int) -> Int? =
  if attempt < 1 or attempt > b.attempts then none else some(b.ms)

// Every delay from attempt 1 until the policy gives up (at most 200 retries).
fn plan[B: Backoff](b: B) -> List[Int] = collect(b, 1)

fn collect[B: Backoff](b: B, attempt: Int) -> List[Int] =
  if attempt > 200 then []
  else match b.delay(attempt) {
    some(d) => [d] + collect(b, attempt + 1),
    none => [],
  }

fn total_wait[B: Backoff](b: B) -> Int = list.sum(plan(b))
