// A key-value store port with fallible writes that return the next state.
protocol Store {
  fn put(s: Self, key: String, value: String) -> Self!
  fn get(s: Self, key: String) -> String?
}

type Mem: Store = { data: Map[String, String] }
fn Mem.put(s: Mem, key: String, value: String) -> Mem! = {
  guard key != "" else err("empty key")
  Mem { data: map.set(s.data, key, value) }
}
fn Mem.get(s: Mem, key: String) -> String? = map.get(s.data, key)

// Every write in order; the first failure aborts the whole batch.
fn apply[S: Store](s: S, writes: List[(String, String)]) -> S! =
  writes |> list.fold(ok(s), (acc, w) => match acc {
    ok(cur) => cur.put(w.0, w.1),
    err(e) => err(e),
  })

fn dump[S: Store](s: S, keys: List[String]) -> String =
  keys |> list.map((k) => k + "=" + (s.get(k) ?? "-")) |> list.join(" ")
