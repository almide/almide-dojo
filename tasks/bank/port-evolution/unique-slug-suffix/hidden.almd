test "hidden: smallest free suffix" {
  let u = Unique { inner: Basic {} }
  assert_eq(u.slug("Hello", ["hello", "hello-world", "hello-there"]), "hello-2")
  assert_eq(u.slug("Hello", ["hello", "hello-2", "hello-4"]), "hello-3")
  assert_eq(u.slug("Fresh", ["hello"]), "fresh")
}
test "hidden: repeated titles in one batch" {
  let u = Unique { inner: Basic {} }
  assert_eq(slugs_with(Strict(u), ["Go", "Go 2", "go", "GO!"], []), ["go", "go-2", "go-3", "go-4"])
}
