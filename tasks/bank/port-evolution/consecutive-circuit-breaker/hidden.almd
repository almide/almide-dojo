test "hidden: a success resets the count" {
  let b = Backend { down: ["x"], calls: 0 }
  assert_eq(run_guarded(b, 2, ["x", "a", "x", "a", "x"]), (["err down: x", "ok re:a", "err down: x", "ok re:a", "err down: x"], 5))
}
test "hidden: open calls never reach the backend" {
  let b = Backend { down: ["x"], calls: 10 }
  assert_eq(run_guarded(b, 1, ["x", "a", "b"]), (["err down: x", "err circuit open", "err circuit open"], 11))
  assert_eq(run_guarded(b, 3, []), ([], 10))
}
test "hidden: the backend alone" {
  let (lines, after) = run_all(Backend { down: ["q"], calls: 0 }, ["q", "q", "q"])
  assert_eq(lines, ["err down: q", "err down: q", "err down: q"])
  assert_eq(after.calls, 3)
}
