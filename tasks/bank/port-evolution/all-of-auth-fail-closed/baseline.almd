// An authorization port: may `user` perform `action`?
protocol Auth {
  fn allows(a: Self, user: String, action: String) -> Bool
}

// Grant rules written "user:action"; "user:*" grants every action to that user.
type Grants: Auth = { rules: List[String] }
fn Grants.allows(g: Grants, user: String, action: String) -> Bool =
  list.contains(g.rules, user + ":" + action) or list.contains(g.rules, user + ":*")

// The actions `user` may perform, in the order asked (duplicates kept).
fn permitted[A: Auth](a: A, user: String, actions: List[String]) -> List[String] =
  actions |> list.filter((act) => a.allows(user, act))

// "user: read=yes, write=no"
fn audit[A: Auth](a: A, user: String, actions: List[String]) -> String = {
  let parts = actions |> list.map((act) => act + "=" + (if a.allows(user, act) then "yes" else "no"))
  user + ": " + list.join(parts, ", ")
}
