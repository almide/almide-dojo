// Checkout queues, one text per queue: customers "arrival:service" (seconds)
// separated by ",", in arrival order. One cashier serves them in order; a
// customer starts when they have arrived AND the previous one is done.
fn fields(q: String) -> List[List[Int]] =
  string.split(q, ",")
    |> list.map((c) => string.split(c, ":") |> list.filter_map((x) => int.parse(x)?))
    |> list.filter((f) => list.len(f) == 2)

fn customers(q: String) -> List[(Int, Int)] = fields(q) |> list.map((f) => (list.get(f, 0) ?? 0, list.get(f, 1) ?? 0))

fn busy_time(q: String) -> Int = customers(q) |> list.map(((_, s)) => s) |> list.sum

fn longest_service(q: String) -> Int = customers(q) |> list.map(((_, s)) => s) |> list.max ?? 0

// Plausible wrong patch: parses every queue first and simulates afterwards,
// so every queue's customer list is live at once.
fn total_waits(queues: List[String]) -> List[Int] = {
  let parsed = queues |> list.map((q) => customers(q))
  parsed |> list.map((cs) => {
    let (_, waited) = cs |> list.fold((0, 0), (st, c) => {
      let (free_at, w) = st
      let (arr, svc) = c
      let start = int.max(arr, free_at)
      (start + svc, w + start - arr)
    })
    waited
  })
}
