// Match results per team, one comma-separated string per team: "2-1,0-0,1-3"
// (goals for - goals against). An empty string means no matches yet.
// A win is worth 3 points, a draw 1, a loss 0.
fn parse_score(s: String) -> Result[(Int, Int), String] =
  match string.split(s, "-") {
    [a, b] => match int.parse(a) {
      ok(f) => match int.parse(b) {
        ok(g) => if f >= 0 and g >= 0 then ok((f, g)) else err("bad score: " + s),
        err(_) => err("bad score: " + s),
      },
      err(_) => err("bad score: " + s),
    },
    _ => err("bad score: " + s),
  }

fn parse_results(results: String) -> Result[List[(Int, Int)], String] =
  if results == "" then ok([]) else string.split(results, ",") |> list.map((r) => parse_score(r)!)

fn points(f: Int, g: Int) -> Int = if f > g then 3 else if f == g then 1 else 0

fn team_points(results: String) -> Result[Int, String] = {
  let scores = parse_results(results)!
  ok(scores |> list.fold(0, (a, s) => {
    let (f, g) = s
    a + points(f, g)
  }))
}
