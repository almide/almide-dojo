test "hidden: n/a after zero jumps" {
  let s = [Sensor { id: "x", readings: [] }, Sensor { id: "y", readings: [3, 3] }, Sensor { id: "z", readings: [7] }]
  assert_eq(jump_ranking(s), ["y:0", "x:n/a", "z:n/a"])
}
test "hidden: ties keep input order" {
  let s = [Sensor { id: "p", readings: [0, -2] }, Sensor { id: "q", readings: [5, 3, 9] }, Sensor { id: "r", readings: [1, 3] }]
  assert_eq(jump_ranking(s), ["q:6", "p:2", "r:2"])
  assert_eq(jump_ranking([]), [])
}
test "hidden: show unchanged" {
  assert_eq(show(Sensor { id: "k", readings: [4, -4] }), "k:8")
}
