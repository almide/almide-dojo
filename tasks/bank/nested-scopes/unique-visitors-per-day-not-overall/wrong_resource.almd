// Visit logs, one text per day: visitor ids separated by ",". The same
// visitor may visit several times a day and on several days.
fn visits(day: String) -> List[String] = string.split(day, ",") |> list.filter((v) => v != "")

fn total_visits(days: List[String]) -> Int = days |> list.fold(0, (a, d) => a + list.len(visits(d)))

fn visited_on(day: String, id: String) -> Bool = list.contains(visits(day), id)

// Plausible wrong patch: builds every day's visitor set first and counts
// afterwards, so every day's set is live at once.
fn daily_uniques(days: List[String]) -> List[Int] = {
  let sets = days |> list.map((d) => set.from_list(visits(d)))
  sets |> list.map((s) => set.len(s))
}
