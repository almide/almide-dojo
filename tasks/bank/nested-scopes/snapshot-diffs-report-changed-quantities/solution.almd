// Inventory snapshots as text: "item=qty" entries separated by ";".
fn parse_snapshot(s: String) -> Map[String, Int] =
  string.split(s, ";") |> list.filter((e) => e != "") |> list.fold(map.new(), (m, e) =>
    match string.split(e, "=") {
      [k, v] => map.set(m, k, int.parse(v) ?? 0),
      _ => m,
    })

fn items(s: String) -> List[String] = map.keys(parse_snapshot(s))

fn quantity(s: String, item: String) -> Int = map.get(parse_snapshot(s), item) ?? 0

// Each pair's two maps are built and dropped inside its own step.
fn diffs(pairs: List[(String, String)]) -> List[String] =
  pairs |> list.map(((before, after)) => {
    let b = parse_snapshot(before)
    let a = parse_snapshot(after)
    let changed = map.entries(a) |> list.filter_map(((k, q)) => match map.get(b, k) {
      some(old) => if old != q then some("~" + k) else none,
      none => some("+" + k),
    })
    let gone = map.keys(b) |> list.filter((k) => not map.contains(a, k)) |> list.map((k) => "-" + k)
    let all = changed + gone
    if list.is_empty(all) then "same" else list.join(all, " ")
  })
