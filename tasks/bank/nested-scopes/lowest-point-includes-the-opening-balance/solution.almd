// Account statements: one text per account, signed movements separated by
// commas, e.g. "+50,-20,+5". Every account OPENS at balance 0.
fn movements(stmt: String) -> List[Int] =
  string.split(stmt, ",") |> list.filter((m) => m != "") |> list.map((m) => int.parse(m) ?? 0)

fn closing(stmt: String) -> Int = list.sum(movements(stmt))

fn running(stmt: String) -> List[Int] = movements(stmt) |> list.scan(0, (b, m) => b + m)

// Each statement's balances are walked inside its own step, from 0.
fn lowest_points(stmts: List[String]) -> List[Int] =
  stmts |> list.map((s) => {
    let (_, low) = movements(s) |> list.fold((0, 0), (st, m) => {
      let (b, lo) = st
      (b + m, int.min(lo, b + m))
    })
    low
  })
