// Resource probe: __K__ documents of 3,000 distinct words. Each document's
// table belongs to its own step, so the batch grows by the input only;
// computing every table first keeps them all live.
effect fn main() -> Unit = {
  let letters = ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j"]
  let docs = list.range(0, __K__) |> list.map((i) =>
    list.range(0, 3000) |> list.map((j) => "w" + (int.to_string(j * 10 + i) |> string.chars |> list.map((c) => list.get(letters, int.parse(c) ?? 0) ?? "a") |> list.join(""))) |> list.join(" "))
  println(int.to_string(top_words(docs) |> list.fold(0, (a, s) => a + string.len(s))))
}
