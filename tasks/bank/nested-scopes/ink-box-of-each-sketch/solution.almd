// ASCII sketches, one text each: rows separated by "\n", "#" is ink, any other
// character is paper.
fn rows(sketch: String) -> List[String] = string.split(sketch, "\n")

fn ink(sketch: String) -> Int = rows(sketch) |> list.fold(0, (a, r) => a + string.count(r, "#"))

fn blank(sketch: String) -> Bool = ink(sketch) == 0

// Each sketch's rows are scanned inside its own step.
fn ink_boxes(sketches: List[String]) -> List[String] =
  sketches |> list.map((s) => {
    let marks = rows(s) |> list.enumerate |> list.filter_map(((r, row)) =>
      option.zip(string.index_of(row, "#"), string.last_index_of(row, "#")) |> option.map(((a, b)) => (r, a, b)))
    let top = marks |> list.map(((r, _, _)) => r) |> list.min
    let bottom = marks |> list.map(((r, _, _)) => r) |> list.max
    let left = marks |> list.map(((_, a, _)) => a) |> list.min
    let right = marks |> list.map(((_, _, b)) => b) |> list.max
    match (top, bottom, left, right) {
      (some(t), some(b), some(l), some(rr)) => int.to_string(rr - l + 1) + "x" + int.to_string(b - t + 1),
      _ => "empty",
    }
  })
