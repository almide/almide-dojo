// Resource probe: __K__ sketches of 4,000 short rows, one text each. Each
// sketch's rows belong to its own step, so the batch grows by the input texts
// only; splitting every sketch first keeps all the row lists live.
effect fn main() -> Unit = {
  let sketches = list.range(0, __K__) |> list.map((i) => string.repeat(".#\n", 4000) + int.to_string(i))
  println(int.to_string(ink_boxes(sketches) |> list.fold(0, (a, s) => a + string.len(s))))
}
