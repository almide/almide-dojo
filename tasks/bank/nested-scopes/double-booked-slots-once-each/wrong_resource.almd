// Timetables: one line per student, "name: SLOT SLOT ...", e.g.
// "ann: MON9 TUE10 MON9". Slots are separated by single spaces.
fn name_of(line: String) -> String = string.split(line, ":") |> list.first ?? ""

fn slots(line: String) -> List[String] =
  string.split(string.drop(line, string.len(name_of(line)) + 1), " ") |> list.filter((s) => s != "")

fn load(line: String) -> Int = list.len(slots(line))

// Plausible wrong patch: splits every student's slots first and counts
// afterwards, so every slot list is live at once.
fn clashes(lines: List[String]) -> List[String] = {
  let split = lines |> list.map((line) => (name_of(line), slots(line)))
  split |> list.map(((name, ss)) => {
    let counts = ss |> list.fold(map.new(), (m, s) => map.set(m, s, (map.get(m, s) ?? 0) + 1))
    let twice = map.entries(counts) |> list.filter(((_, n)) => n > 1) |> list.map(((s, _)) => s)
    name + ": " + (if list.is_empty(twice) then "ok" else list.join(twice, ","))
  })
}
