// Resource probe: __K__ sequences of 5,000 one-digit values, one text each.
// Each value list belongs to its own step, so the batch grows by the input
// texts only; parsing every sequence first keeps all the value lists live.
effect fn main() -> Unit = {
  let seqs = list.range(0, __K__) |> list.map((i) => string.repeat("1 2 3 ", 1666) + int.to_string(i))
  println(int.to_string(longest_rises(seqs) |> list.fold(0, (a, n) => a + n)))
}
