// Markdown-ish documents: a heading is 1 to 6 '#' followed by a space.
// "#tag" (no space) and "####### x" (seven) are not headings.
fn heading_level(line: String) -> Int? = {
  let hashes = string.chars(line) |> list.take_while((c) => c == "#") |> list.len
  if hashes >= 1 and hashes <= 6 and string.get(line, hashes) == some(" ") then some(hashes) else none
}

fn headings(doc: List[String]) -> List[(Int, String)] =
  doc |> list.filter_map((l) => match heading_level(l) {
    some(n) => some((n, string.trim(string.drop(l, n)))),
    none => none,
  })

fn outline(doc: List[String]) -> List[String] =
  headings(doc) |> list.map(((n, t)) => string.repeat("  ", n - 1) + t)

// Each document's heading list is built and dropped inside its own step.
fn titles(docs: List[List[String]]) -> List[String] =
  docs |> list.map((doc) =>
    headings(doc) |> list.find(((n, _)) => n == 1) |> option.map(((_, t)) => t) ?? "(untitled)")
