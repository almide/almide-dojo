// Service logs, one text per service, lines separated by "\n". A line is
// "OK ..." or "ERR ..."; anything else is ignored (neither a success nor an
// error).
fn classify(line: String) -> Int =
  if string.starts_with(line, "ERR ") then 1 else if string.starts_with(line, "OK ") then 0 else -1

// (errors, counted lines) of one log text.
fn tally(log: String) -> (Int, Int) =
  string.split(log, "\n") |> list.fold((0, 0), (acc, l) => {
    let (e, n) = acc
    match classify(l) {
      1 => (e + 1, n + 1),
      0 => (e, n + 1),
      _ => acc,
    }
  })

fn pct(e: Int, n: Int) -> String = if n == 0 then "n/a" else int.to_string(e * 100 / n) + "%"

// Plausible wrong patch: the "all" line averages the per-log percentages
// (skipping n/a logs), which weighs a one-line log like a thousand-line one.
fn error_rates(logs: List[(String, String)]) -> List[String] = {
  let rates = logs |> list.map(((name, log)) => {
    let (e, n) = tally(log)
    (name, e, n)
  })
  let lines = rates |> list.map(((name, e, n)) => name + ": " + pct(e, n))
  let counted = rates |> list.filter(((_, _, n)) => n > 0)
  let avg = if list.is_empty(counted) then "n/a" else int.to_string((counted |> list.fold(0, (a, r) => {
    let (_, e, n) = r
    a + e * 100 / n
  })) / list.len(counted)) + "%"
  lines + ["all: " + avg]
}
