// Service logs, one text per service, lines separated by "\n". A line is
// "OK ..." or "ERR ..."; anything else is ignored (neither a success nor an
// error).
fn classify(line: String) -> Int =
  if string.starts_with(line, "ERR ") then 1 else if string.starts_with(line, "OK ") then 0 else -1

// (errors, counted lines) of one log text.
fn tally(log: String) -> (Int, Int) =
  string.split(log, "\n") |> list.fold((0, 0), (acc, l) => {
    let (e, n) = acc
    match classify(l) {
      1 => (e + 1, n + 1),
      0 => (e, n + 1),
      _ => acc,
    }
  })

fn pct(e: Int, n: Int) -> String = if n == 0 then "n/a" else int.to_string(e * 100 / n) + "%"

// Plausible wrong patch: splits every log into lines first and counts
// afterwards, so every log's line list is live at once.
fn error_rates(logs: List[(String, String)]) -> List[String] = {
  let split = logs |> list.map(((name, log)) => (name, string.split(log, "\n")))
  let (lines, errs, total) = split |> list.fold(([], 0, 0), (acc, c) => {
    let (out, e0, n0) = acc
    let (name, ls) = c
    let e = ls |> list.count((l) => classify(l) == 1)
    let n = ls |> list.count((l) => classify(l) >= 0)
    (out + [name + ": " + pct(e, n)], e0 + e, n0 + n)
  })
  lines + ["all: " + pct(errs, total)]
}
