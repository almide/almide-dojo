// Resource probe: __K__ districts of 5,000 short ballots, one text each. Each
// ballot list belongs to its own step, so the batch grows by the input texts
// only; splitting every district first keeps all the ballot lists live.
effect fn main() -> Unit = {
  let ds = list.range(0, __K__) |> list.map((i) => string.repeat("a,b,a,", 1666) + int.to_string(i))
  println(int.to_string(results(ds) |> list.fold(0, (a, s) => a + string.len(s))))
}
