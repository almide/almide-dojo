// Chess tournaments, one text each: games "white-black:result" separated by
// ";", result "1-0", "0-1" or "1/2" (a draw, half a point each).
fn games(t: String) -> List[(String, String, String)] =
  string.split(t, ";") |> list.filter_map((g) => match string.split(g, ":") {
    [players, r] => match string.split(players, "-") {
      [w, b] => some((w, b, r)),
      _ => none,
    },
    _ => none,
  })

fn players(t: String) -> List[String] = games(t) |> list.flat_map(((w, b, _)) => [w, b]) |> list.unique

fn decisive(t: String) -> Int = games(t) |> list.count(((_, _, r)) => r != "1/2")

// Plausible wrong patch: counts wins only (draws score nothing), so a player
// with several draws is overlooked.
fn winners(ts: List[String]) -> List[String] =
  ts |> list.map((t) => {
    let wins = games(t) |> list.fold(map.new(), (m, g) => {
      let (w, b, r) = g
      match r {
        "1-0" => map.set(m, w, (map.get(m, w) ?? 0) + 1),
        "0-1" => map.set(m, b, (map.get(m, b) ?? 0) + 1),
        _ => m,
      }
    })
    let best = players(t) |> list.fold(none, (acc, p) => {
      let n = map.get(wins, p) ?? 0
      match acc {
        some((_, bn)) => if n > bn then some((p, n)) else acc,
        none => some((p, n)),
      }
    })
    match best {
      some((p, n)) => p + " " + int.to_string(n),
      none => "-",
    }
  })
