// Warehouse stock per SKU, and orders made of (sku, quantity) lines. An order
// may name the same SKU on several lines; they add up.
type Order = { id: String, lines: List[(String, Int)] }

// Quantity wanted per SKU (SKUs in order of first line).
fn wanted(o: Order) -> Map[String, Int] =
  list.group_by(o.lines, ((sku, _)) => sku) |> map.map((ls) => ls |> list.map(((_, q)) => q) |> list.sum)

fn stock_of(stock: Map[String, Int], sku: String) -> Int = map.get_or(stock, sku, 0)

fn total_units(o: Order) -> Int = o.lines |> list.map(((_, q)) => q) |> list.sum

fn skus(o: Order) -> List[String] = map.keys(wanted(o))
