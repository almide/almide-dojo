// Resource probe: __K__ files of 5,000 short lines, one text each. Each
// file's line list belongs to its own step, so the batch grows by the input
// texts only; splitting every file first keeps all the line lists live.
effect fn main() -> Unit = {
  let files = list.range(0, __K__) |> list.map((i) => ("f" + int.to_string(i), string.repeat("ab\n", 5000) + "needle"))
  println(int.to_string(list.len(grep(files, "needle"))))
}
