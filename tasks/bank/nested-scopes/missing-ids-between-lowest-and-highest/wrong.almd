// Received packet ids per stream, one text per stream: ids separated by " ",
// in ARRIVAL order (packets arrive out of order).
fn ids(stream: String) -> List[Int] = string.split(stream, " ") |> list.filter_map((x) => int.parse(x)?)

fn received(stream: String) -> Int = list.len(list.unique(ids(stream)))

fn first_arrival(stream: String) -> Int? = list.first(ids(stream))

// Plausible wrong patch: measures from the first to the last ARRIVAL, which
// is the range only when packets arrive in order.
fn gaps(streams: List[String]) -> List[Int] =
  streams |> list.map((s) => {
    let xs = ids(s)
    match option.zip(list.first(xs), list.last(xs)) {
      some((a, b)) => int.max(0, int.abs(b - a) + 1 - list.len(list.unique(xs))),
      none => 0,
    }
  })
