// Password change histories, one text per account: password fingerprints in
// the order they were set, separated by ",". A new password is refused when
// it equals one of the LAST THREE passwords before it; older ones may be
// reused.
fn history(h: String) -> List[String] = string.split(h, ",") |> list.filter((x) => x != "")

fn changes(h: String) -> Int = int.max(0, list.len(history(h)) - 1)
