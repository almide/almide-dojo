// Min and max of a non-empty group, via a temporary sorted copy.
fn stats(xs: List[Int]) -> (Int, Int) = {
  let s = list.sort(xs)
  (list.first(s) ?? 0, list.last(s) ?? 0)
}

// Plausible wrong patch: every group is sorted up front and the ends are read
// afterwards, so all the sorted copies are live at once instead of one per
// inner call. Same pairs, in the same order.
fn stats_batch(groups: List[List[Int]]) -> List[(Int, Int)] = {
  let sorted = groups |> list.map((g) => list.sort(g))
  sorted |> list.map((s) => (list.first(s) ?? 0, list.last(s) ?? 0))
}
