// Min and max of a non-empty group, via a temporary sorted copy.
fn stats(xs: List[Int]) -> (Int, Int) = {
  let s = list.sort(xs)
  (list.first(s) ?? 0, list.last(s) ?? 0)
}

// One (min, max) per group; each group's sorted copy is a temporary of the
// inner call and the batch keeps only the pairs.
fn stats_batch(groups: List[List[Int]]) -> List[(Int, Int)] =
  groups |> list.map((g) => stats(g))
