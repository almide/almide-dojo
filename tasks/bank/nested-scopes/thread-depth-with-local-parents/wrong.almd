// Conversations, one text each: "id>parent" lines (parent "-" for a new
// topic). Message ids are only unique WITHIN a conversation; a message whose
// parent is not in the same conversation starts a new topic.
fn parse_msgs(conv: String) -> List[(String, String)] =
  string.split(conv, "\n") |> list.filter_map((l) => match string.split(l, ">") {
    [id, p] => some((id, p)),
    _ => none,
  })

fn message_count(conv: String) -> Int = list.len(parse_msgs(conv))

fn topics(conv: String) -> Int = parse_msgs(conv) |> list.count(((_, p)) => p == "-")

// Plausible wrong patch: builds ONE depth table for the whole batch (walking
// every conversation in order), so a parent from an earlier conversation is
// found and the chain continues across conversations.
fn depths(convs: List[String]) -> List[Int] = {
  let (_, out) = convs |> list.fold((map.new(), []), (st, c) => {
    let (table, acc) = st
    let (t2, best) = parse_msgs(c) |> list.fold((table, 0), (inner, msg) => {
      let (m, b) = inner
      let (id, p) = msg
      let d = (map.get(m, p) ?? 0) + 1
      (map.set(m, id, d), int.max(b, d))
    })
    (t2, acc + [best])
  })
  out
}
