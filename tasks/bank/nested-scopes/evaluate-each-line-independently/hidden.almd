test "hidden: blank lines are skipped" {
  assert_eq(eval_all(["", "2 3 *", "   ", "x"]), ["=6", "!bad token: x"])
}
test "hidden: failures do not stop the batch" {
  assert_eq(eval_all(["+", "1 2", "7 2 -"]), ["!stack underflow", "!expected one result, got 2", "=5"])
  assert_eq(eval_all([]), [])
}
test "hidden: eval unchanged" {
  assert_eq(eval("  5   1 - "), ok(4))
  assert_eq(eval(""), err("expected one result, got 0"))
}
