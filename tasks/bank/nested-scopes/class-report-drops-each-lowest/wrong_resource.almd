// A student's average with the lowest score dropped (when there are at least
// two scores), rounded down. No scores: 0.
type Student = { name: String, scores: List[Int] }

fn average_drop_lowest(scores: List[Int]) -> Int = {
  let sorted = list.sort(scores)
  let kept = if list.len(sorted) >= 2 then list.drop(sorted, 1) else sorted
  if list.is_empty(kept) then 0 else list.sum(kept) / list.len(kept)
}

fn line_for(s: Student) -> String = s.name + ":" + int.to_string(average_drop_lowest(s.scores))

// Plausible wrong patch: every student's scores are sorted up front, so all
// the sorted copies are live at once. Same lines, same order.
fn class_report(students: List[Student]) -> List[String] = {
  let sorted = students |> list.map((s) => (s.name, list.sort(s.scores)))
  sorted |> list.map(((name, ss)) => {
    let kept = if list.len(ss) >= 2 then list.drop(ss, 1) else ss
    if list.is_empty(ss) then name + ":-" else name + ":" + int.to_string(list.sum(kept) / list.len(kept))
  })
}
