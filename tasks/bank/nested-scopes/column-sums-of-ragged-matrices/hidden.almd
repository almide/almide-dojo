test "hidden: the longest row sets the width" {
  assert_eq(column_sums_batch([[[1], [2, 3, 4]], [[], [7, -7]]]), ["3,3,4", "7,-7"])
}
test "hidden: empty matrices" {
  assert_eq(column_sums_batch([[], [[]]]), ["", ""])
  assert_eq(column_sums_batch([]), [])
}
test "hidden: transpose unchanged" {
  assert_eq(transpose([[1, 2], [3]]), [[1, 3], [2, 0]])
}
