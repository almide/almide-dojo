// Monthly expenses by category, checked against per-category limits.
type Month = { name: String, expenses: List[(String, Int)] }

// Category totals for one month, categories in order of first expense.
fn totals(expenses: List[(String, Int)]) -> Map[String, Int] =
  expenses |> list.fold(map.new(), (m, e) => {
    let (cat, amt) = e
    map.set(m, cat, (map.get(m, cat) ?? 0) + amt)
  })

fn spent(m: Month) -> Int = m.expenses |> list.fold(0, (a, e) => {
  let (_, amt) = e
  a + amt
})

// Plausible wrong patch: computes every month's totals map first and reports
// afterwards, so every month's map is live at once.
fn budget_report(limits: Map[String, Int], months: List[Month]) -> List[String] = {
  let all = months |> list.map((m) => (m.name, totals(m.expenses)))
  all |> list.map(((name, ts)) => {
    let over = map.entries(ts)
      |> list.filter(((cat, t)) => match map.get(limits, cat) {
        some(lim) => t > lim,
        none => false,
      })
      |> list.map(((cat, _)) => cat)
    name + ": " + (if list.is_empty(over) then "ok" else list.join(over, ","))
  })
}
