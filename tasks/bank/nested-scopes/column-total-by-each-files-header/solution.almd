// CSV exports from different tools: each file's FIRST line is its own header,
// and tools order their columns differently. Values are integers; a missing
// or bad cell counts as 0.
fn header_of(text: String) -> List[String] = string.split(string.lines(text) |> list.first ?? "", ",")

fn column_index(header: List[String], name: String) -> Int? = list.index_of(header, name)

fn rows_of(text: String) -> List[List[String]] = string.lines(text) |> list.drop(1) |> list.map((l) => string.split(l, ","))

// Each file's own header locates the column; its rows stay in its step.
fn column_totals(files: List[String], column: String) -> List[String] =
  files |> list.map((text) => match column_index(header_of(text), column) {
    none => "missing",
    some(i) => int.to_string(rows_of(text) |> list.fold(0, (a, r) => a + (list.get(r, i) |> option.flat_map((c) => int.parse(c)?) ?? 0))),
  })
