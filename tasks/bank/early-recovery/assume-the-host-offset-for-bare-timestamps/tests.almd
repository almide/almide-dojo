test "a timestamp without offset uses its host's default offset" {
  assert_eq(merge(["web": "+02:00"], ["web 12:00:00 start", "db 10:30:00+00:00 ping"]), ok(["10:00:00Z web start", "10:30:00Z db ping"]))
}
test "a malformed timestamp is still fatal" {
  assert_eq(merge(["web": "+02:00"], ["web 1200 start"]), err(BadStamp("1200")))
}
