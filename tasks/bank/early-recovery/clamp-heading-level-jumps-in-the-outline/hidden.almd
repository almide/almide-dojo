test "hidden: later headings are compared with the level actually used" {
  assert_eq(outline(["# A", "### B", "#### C", "### D"]) |> result.map((o) => render(o)),
    ok("1 A; 1.1 B; 1.1.1 C; 1.1.2 D | line 2: level 3 after 1, using 2; line 3: level 4 after 2, using 3"))
}
test "hidden: the first heading jumping from nothing is clamped to level 1" {
  assert_eq(outline(["", "## Start", "# Next"]) |> result.map((o) => render(o)), ok("1 Start; 2 Next | line 2: level 2 after 0, using 1"))
}
test "hidden: other errors stay fatal, before or after a clamp" {
  assert_eq(outline(["# A", "#### B", "####### C"]) |> result.map((o) => render(o)), err(TooDeep(3, 7)))
  assert_eq(outline(["# A", "###    "]) |> result.map((o) => render(o)), err(EmptyTitle(2)))
  assert_eq(outline(["# A", "text"]) |> result.map((o) => render(o)), err(NotHeading(2)))
}
test "hidden: going back up any number of levels is not a jump" {
  assert_eq(outline(["# A", "## B", "### C", "# D", "## E"]) |> result.map((o) => render(o)), ok("1 A; 1.1 B; 1.1.1 C; 2 D; 2.1 E"))
}
