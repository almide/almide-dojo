let STOCK = ["cola": 0, "soda": 3, "tonic": 4, "water": 10]
let ALTS = ["cola": ["soda", "tonic"], "soda": ["water"]]

test "hidden: alternatives are judged by the stock left at that moment" {
  assert_eq(fulfil(STOCK, ALTS, ["cola 2", "cola 2"]), ok(Picked { picks: ["soda x2", "tonic x2"], left: ["cola=0", "soda=1", "tonic=2", "water=10"], notes: ["line 1: cola replaced by soda", "line 2: cola replaced by tonic"] }))
  assert_eq(fulfil(STOCK, ALTS, ["soda 2", "cola 3"]), ok(Picked { picks: ["soda x2", "tonic x3"], left: ["cola=0", "soda=1", "tonic=1", "water=10"], notes: ["line 2: cola replaced by tonic"] }))
}
test "hidden: nothing covers it, the original error stays" {
  assert_eq(fulfil(STOCK, ALTS, ["cola 3", "cola 3", "cola 3"]), err(OutOfStock(3, "cola", 0)))
  assert_eq(fulfil(STOCK, ALTS, ["tonic 5"]), err(OutOfStock(1, "tonic", 4)))
  assert_eq(fulfil(STOCK, ALTS, ["cola 5"]), err(OutOfStock(1, "cola", 0)))
}
test "hidden: a substitute can itself be replaced later, other errors stay fatal" {
  assert_eq(fulfil(STOCK, ALTS, ["cola 3", "soda 1"]), ok(Picked { picks: ["soda x3", "water x1"], left: ["cola=0", "soda=0", "tonic=4", "water=9"], notes: ["line 1: cola replaced by soda", "line 2: soda replaced by water"] }))
  assert_eq(fulfil(STOCK, ALTS, ["cola 9", "soda 0"]), err(OutOfStock(1, "cola", 0)))
  assert_eq(fulfil(STOCK, ALTS, ["cola 1", "soda 0"]), err(BadQty(2)))
}
