test "a plugin that needs a newer host is skipped" {
  assert_eq(load("2.4", ["core 1.0", "shiny 3.1", "extra 2.0 core"]) |> result.map((l) => show(l)), ok("core extra | shiny skipped (needs host 3.1)"))
}
test "a malformed manifest is still fatal" {
  assert_eq(load("2.4", ["core 1.0", "bad x.y"]) |> result.map((l) => show(l)), err(Malformed("bad")))
}
