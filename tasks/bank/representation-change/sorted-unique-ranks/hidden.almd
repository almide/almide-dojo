test "hidden: rank above every number" {
  let s = seats([10, 20, 30])
  assert_eq(rank(s, 31), 3)
  assert_eq(rank(s, 1000), 3)
  assert_eq(between(s, 15, 99), 2)
  assert_eq(rank(s, 10), 0)
  assert_eq(rank(s, -5), 0)
}
test "hidden: duplicates, ranges and empty sets" {
  let s = add(add(seats([4, 8]), 8), 6)
  assert_eq(s, seats([8, 6, 4]))
  assert_eq(count(s), 3)
  assert_eq(between(s, 4, 8), 3)
  assert_eq(between(s, 9, 3), 0)
  assert_eq(rank(seats([]), 5), 0)
  assert_eq(render(seats([])), "")
}
