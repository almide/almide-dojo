test "fractions render" {
  assert_eq(render_qty(ratio(3, 2)), "1 1/2")
  assert_eq(render_qty(ratio(2, 4)), "1/2")
  assert_eq(render_qty(ratio(6, 2)), "3")
  assert_eq(line(ingredient("flour", ratio(9, 4))), "flour: 2 1/4")
}
test "scale and total" {
  let r = [ingredient("a", ratio(1, 2)), ingredient("b", ratio(3, 4))]
  assert_eq(total(r), ratio(5, 4))
  assert_eq(scale(r, ratio(2, 3)), [ingredient("a", ratio(1, 3)), ingredient("b", ratio(1, 2))])
}
