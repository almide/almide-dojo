test "hidden: normal form" {
  assert_eq(ratio(1, -2), Ratio { num: -1, den: 2 })
  assert_eq(ratio(-6, -4), Ratio { num: 3, den: 2 })
  assert_eq(ratio(0, -7), Ratio { num: 0, den: 1 })
  assert_eq(total([]), ratio(0, 1))
}
test "hidden: negative quantities render with one sign" {
  assert_eq(render_qty(ratio(-3, 2)), "-1 1/2")
  assert_eq(render_qty(ratio(-1, 2)), "-1/2")
  assert_eq(render_qty(ratio(-4, 2)), "-2")
  assert_eq(render_qty(ratio(0, 3)), "0")
  assert_eq(render_qty(ratio(7, -3)), "-2 1/3")
}
test "hidden: changes compare exact values" {
  let before = [ingredient("a", ratio(2, 4)), ingredient("b", ratio(3, 2)), ingredient("c", ratio(1, 3))]
  let after = [ingredient("a", ratio(1, 2)), ingredient("b", ratio(1, 4)), ingredient("d", ratio(5, 3)), ingredient("c", ratio(1, 2))]
  assert_eq(changes(before, after), ["b -1 1/4", "d +1 2/3", "c +1/6"])
}
test "hidden: scaling normalizes" {
  assert_eq(scale([ingredient("x", ratio(3, 4))], ratio(4, 3)), [ingredient("x", ratio(1, 1))])
  assert_eq(scale([ingredient("x", ratio(3, 4))], ratio(0, 5)), [ingredient("x", ratio(0, 1))])
}
