test "hidden: the line break belongs to its line" {
  let doc = ["ab", "", "c"]
  assert_eq(render(doc, Cursor { offset: 2 }), "1:3")
  assert_eq(render(doc, right(doc, Cursor { offset: 2 })), "2:1")
  assert_eq(render(doc, right_by(doc, Cursor { offset: 2 }, 2)), "3:1")
  assert_eq(char_at(doc, Cursor { offset: 2 }), none)
  assert_eq(char_at(doc, Cursor { offset: 3 }), none)
  assert_eq(char_at(doc, Cursor { offset: 4 }), some("c"))
}
test "hidden: the end of the text" {
  let doc = ["ab", "c"]
  assert_eq(right_by(doc, at(doc, 2, 1), 5), at(doc, 2, 2))
  assert_eq(render(doc, at(doc, 2, 2)), "2:2")
  assert_eq(char_at(doc, at(doc, 2, 2)), none)
}
test "hidden: text between cursors" {
  let doc = ["ab", "", "cd"]
  assert_eq(between(doc, at(doc, 1, 2), at(doc, 3, 2)), "b\n\nc")
  assert_eq(between(doc, at(doc, 1, 1), at(doc, 1, 1)), "")
}
