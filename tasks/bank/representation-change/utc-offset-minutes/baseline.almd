// Meeting invitations across time zones. A zone offset is canonical text
// "+HH:MM" / "-HH:MM" (e.g. "+05:30", "-03:30", "+00:00").
type Invite: Eq, Repr = { city: String, offset: String }

fn invite(city: String, offset: String) -> Invite = Invite { city: city, offset: offset }

// Offset in minutes east of UTC.
fn offset_min(text: String) -> Int = {
  let sign = if string.starts_with(text, "-") then -1 else 1
  let h = int.parse(string.slice(text, 1, 3)) ?? 0
  let m = int.parse(string.slice(text, 4, 6)) ?? 0
  sign * (h * 60 + m)
}

fn pad2(n: Int) -> String = string.pad_start(int.to_string(n), 2, "0")

// The local wall-clock time "HH:MM" of a UTC minute-of-day, wrapping around midnight.
fn local_time(i: Invite, utc_min: Int) -> String = {
  let t = ((utc_min + offset_min(i.offset)) % 1440 + 1440) % 1440
  pad2(t / 60) + ":" + pad2(t % 60)
}

fn line(i: Invite, utc_min: Int) -> String = i.city + " " + local_time(i, utc_min) + " (UTC" + i.offset + ")"

// Cities from the westernmost offset to the easternmost; equal offsets keep list order.
fn west_to_east(is: List[Invite]) -> List[String] =
  is |> list.sort_by((i) => offset_min(i.offset)) |> list.map((i) => i.city)
