test "hidden: releasing next to free seats joins the runs" {
  let r = release(book(empty_row(8), 2, 3), 2, 3)
  assert_eq(r, empty_row(8))
  let s = release(book(empty_row(10), 3, 4), 3, 2)
  assert_eq(s.free, [(0, 5), (7, 3)])
  assert_eq(first_block(s, 5), some(0))
}
test "hidden: a block across former runs" {
  let r = release(release(book(empty_row(9), 0, 9), 2, 2), 4, 2)
  assert_eq(r.free, [(2, 4)])
  assert_eq(first_block(r, 4), some(2))
  assert_eq(render(r), "XX....XXX")
}
test "hidden: overlapping bookings and edges" {
  let r = book(book(empty_row(6), 1, 2), 2, 3)
  assert_eq(r.free, [(0, 1), (5, 1)])
  assert_eq(release(r, 0, 6), empty_row(6))
  assert_eq(first_block(r, 2), none)
  assert_eq(empty_row(0), Row { size: 0, free: [] })
  assert_eq(is_free(r, 5), true)
  assert_eq(is_free(r, 6), false)
}
