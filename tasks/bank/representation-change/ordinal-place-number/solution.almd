// Race results; `place` is the finishing place.
type Result: Eq, Repr = { runner: String, place: Int }

fn result(runner: String, place: Int) -> Result = Result { runner: runner, place: place }

fn suffix(n: Int) -> String =
  if n % 100 >= 11 and n % 100 <= 13 then "th"
  else match n % 10 {
    1 => "st",
    2 => "nd",
    3 => "rd",
    _ => "th",
  }

fn render(r: Result) -> String = int.to_string(r.place) + suffix(r.place) + " " + r.runner

// Results by place; equal places (a tie) keep list order.
fn ranking(rs: List[Result]) -> List[String] = rs |> list.sort_by((r) => r.place) |> list.map(render)

fn podium(rs: List[Result]) -> List[String] =
  rs |> list.filter((r) => r.place <= 3) |> list.sort_by((r) => r.place) |> list.map((r) => r.runner)
