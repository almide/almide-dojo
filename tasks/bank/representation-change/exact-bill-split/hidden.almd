test "hidden: refunds split exactly" {
  assert_eq(shares(expense("refund", -100, ["ann", "bo", "cy"])), [("ann", -34), ("bo", -33), ("cy", -33)])
  assert_eq(shares(expense("refund", -5, ["a", "b"])), [("a", -3), ("b", -2)])
  assert_eq(shares(expense("r", -1, ["a", "b", "c"])), [("a", -1), ("b", 0), ("c", 0)])
}
test "hidden: small amounts" {
  assert_eq(shares(expense("gum", 2, ["a", "b", "c"])), [("a", 1), ("b", 1), ("c", 0)])
  assert_eq(shares(expense("none", 0, ["a", "b"])), [("a", 0), ("b", 0)])
}
test "hidden: balances and lines" {
  let es = [expense("x", 100, ["ann", "bo", "cy"]), expense("y", -100, ["cy", "bo", "ann"])]
  assert_eq(balances(es), [("ann", 1), ("bo", 0), ("cy", -1)])
  assert_eq(line(("bo", -333)), "bo -3.33")
  assert_eq(line(("cy", -5)), "cy -0.05")
}
