// Theme colors as numeric channels.
type Rgb: Eq, Repr = { r: Int, g: Int, b: Int }
type Swatch: Eq, Repr = { name: String, color: Rgb }

fn hexval(s: String) -> Int = int.from_hex(s) ?? 0

// Accepts "#RGB" or "#RRGGBB" in any case.
fn swatch(name: String, text: String) -> Swatch = {
  let t = string.to_lower(string.drop(text, 1))
  let six = if string.len(t) == 3 then string.chars(t) |> list.map((c) => c + c) |> list.join("") else t
  let at = (i) => hexval(string.slice(six, 2 * i, 2 * i + 2))
  Swatch { name: name, color: Rgb { r: at(0), g: at(1), b: at(2) } }
}

// Perceived brightness 0..255 (integer weights, rounded down).
fn brightness(s: Swatch) -> Int = (s.color.r * 299 + s.color.g * 587 + s.color.b * 114) / 1000

fn hex2(n: Int) -> String = string.pad_start(int.to_hex(n), 2, "0")

fn hex_text(c: Rgb) -> String = "#" + hex2(c.r) + hex2(c.g) + hex2(c.b)

fn render(s: Swatch) -> String = s.name + " " + hex_text(s.color)

fn mix(a: Swatch, b: Swatch, name: String) -> Swatch =
  Swatch { name: name, color: Rgb { r: (a.color.r + b.color.r) / 2, g: (a.color.g + b.color.g) / 2, b: (a.color.b + b.color.b) / 2 } }

// Distinct colors in first-seen order (the first name wins).
fn palette(ss: List[Swatch]) -> List[String] =
  ss |> list.unique_by((s) => s.color) |> list.map(render)
