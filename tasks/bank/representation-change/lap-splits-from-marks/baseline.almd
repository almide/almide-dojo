// A stopwatch session. `marks` are the clock readings (tenths of a second since
// the start) at the end of each lap, increasing.
type Session: Eq, Repr = { marks: List[Int] }

fn session(marks: List[Int]) -> Session = Session { marks: marks }

fn clock(t: Int) -> String =
  int.to_string(t / 600) + ":" + string.pad_start(int.to_string(t / 10 % 60), 2, "0") + "." + int.to_string(t % 10)

// Each lap's own duration.
fn laps(s: Session) -> List[Int] = list.zip(s.marks, [0] + s.marks) |> list.map((p) => p.0 - p.1)

fn total(s: Session) -> Int = list.last(s.marks) ?? 0

// The 1-based number of the fastest lap; the first one on a tie.
fn fastest(s: Session) -> Int? =
  laps(s) |> list.enumerate |> list.fold(none, (best, p) => match best {
    none => some(p),
    some(b) => if p.1 < b.1 then some(p) else some(b),
  }) |> option.map((p) => p.0 + 1)

// "L<n> <clock at the end of the lap> (+<lap duration>)" per lap.
fn table(s: Session) -> List[String] =
  list.zip(s.marks, laps(s)) |> list.enumerate |> list.map((p) =>
    "L" + int.to_string(p.0 + 1) + " " + clock((p.1).0) + " (+" + clock((p.1).1) + ")")
