// Polynomials with integer coefficients, dense: coeffs[i] is the coefficient of x^i.
// Kept trimmed: no trailing zero coefficients (the zero polynomial is []).
type Poly: Eq, Repr = { coeffs: List[Int] }

fn trim(cs: List[Int]) -> List[Int] = cs |> list.reverse |> list.drop_while((c) => c == 0) |> list.reverse

fn poly(cs: List[Int]) -> Poly = Poly { coeffs: trim(cs) }

fn coeff(p: Poly, i: Int) -> Int = list.get(p.coeffs, i) ?? 0

fn add(a: Poly, b: Poly) -> Poly = {
  let n = int.max(list.len(a.coeffs), list.len(b.coeffs))
  poly(list.range(0, n) |> list.map((i) => coeff(a, i) + coeff(b, i)))
}

fn mul(a: Poly, b: Poly) -> Poly = {
  let n = list.len(a.coeffs) + list.len(b.coeffs)
  poly(list.range(0, n) |> list.map((k) => list.range(0, k + 1) |> list.fold(0, (acc, i) => acc + coeff(a, i) * coeff(b, k - i))))
}

fn degree(p: Poly) -> Int? = if list.is_empty(p.coeffs) then none else some(list.len(p.coeffs) - 1)

fn term(c: Int, i: Int) -> String = {
  let a = int.abs(c)
  let num = if a == 1 and i > 0 then "" else int.to_string(a)
  num + (if i == 0 then "" else if i == 1 then "x" else "x^" + int.to_string(i))
}

// Highest power first: "3x^2 - x + 5"; the zero polynomial is "0".
fn render(p: Poly) -> String = {
  let terms = list.range(0, list.len(p.coeffs)) |> list.reverse |> list.filter((i) => coeff(p, i) != 0)
  match terms {
    [] => "0",
    [first, ..rest] =>
      (if coeff(p, first) < 0 then "-" else "") + term(coeff(p, first), first)
        + (rest |> list.map((i) => (if coeff(p, i) < 0 then " - " else " + ") + term(coeff(p, i), i)) |> list.join("")),
  }
}
