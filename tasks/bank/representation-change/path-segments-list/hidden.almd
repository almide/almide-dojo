test "hidden: the root" {
  let root = entry("", 10)
  assert_eq(root.path, [])
  assert_eq(depth(root), 0)
  assert_eq(parent(root), none)
  assert_eq(render(entry("/", 3)), ". 3")
  assert_eq(parent(entry("top", 1)), some([]))
}
test "hidden: usage of the root is the grand total" {
  let es = [entry("", 1), entry("a/b", 2), entry("/c/", 4)]
  assert_eq(usage(es, ""), 7)
  assert_eq(usage(es, "/"), 7)
  assert_eq(usage([], "a"), 0)
}
test "hidden: whole-segment containment" {
  let es = [entry("a/b", 1), entry("a/bc", 2), entry("a/b/c", 4), entry("a", 8)]
  assert_eq(usage(es, "a/b"), 5)
  assert_eq(usage(es, "a/b/"), 5)
  assert_eq(within(entry("a/bc", 0), "a/b"), false)
  assert_eq(within(entry("a/b", 0), "//a//b"), true)
}
