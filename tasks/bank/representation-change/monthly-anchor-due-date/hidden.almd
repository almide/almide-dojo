test "hidden: short months do not move the billing day" {
  let s = sub("rent", Date { y: 2024, m: 1, d: 31 })
  assert_eq(schedule(s, 4), ["2024-01-31", "2024-02-29", "2024-03-31", "2024-04-30"])
  assert_eq(render(due(pay(pay(s)))), "2024-03-31")
}
test "hidden: gregorian leap years and year rollover" {
  assert_eq(schedule(sub("a", Date { y: 2100, m: 1, d: 30 }), 2), ["2100-01-30", "2100-02-28"])
  assert_eq(schedule(sub("b", Date { y: 2000, m: 1, d: 30 }), 2), ["2000-01-30", "2000-02-29"])
  assert_eq(schedule(sub("c", Date { y: 2023, m: 11, d: 30 }), 4), ["2023-11-30", "2023-12-30", "2024-01-30", "2024-02-29"])
}
