test "rates in basis points" {
  assert_eq(interest(account("a", 10000, 125)), 125)
  assert_eq(rate_label(account("a", 0, 125)), "1.25%")
  assert_eq(at_least([account("a", 0, 100), account("b", 0, 250)], 200), ["b"])
}
test "accrue in bps" {
  assert_eq(accrue([account("a", 1000, 150)]), [account("a", 1015, 150)])
}
