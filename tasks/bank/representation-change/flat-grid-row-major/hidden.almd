test "hidden: columns do not wrap between rows" {
  let g = grid([[1, 2, 3], [4, 5, 6]])
  assert_eq(get(g, 0, 3), none)
  assert_eq(get(g, 1, -1), none)
  assert_eq(get(g, 2, 0), none)
  assert_eq(neighbour_sum(g, 0, 2), 3 + 6 - 1)
  assert_eq(neighbour_sum(g, 1, 0), 1 + 5)
}
test "hidden: peaks on the edges" {
  let g = grid([[5, 1, 7], [1, 1, 1]])
  assert_eq(peaks(g), ["0,0", "0,2"])
  assert_eq(peaks(grid([[3], [1], [4]])), ["0,0", "2,0"])
}
test "hidden: degenerate grids" {
  let e = grid([])
  assert_eq(e, Grid { width: 0, cells: [] })
  assert_eq(get(e, 0, 0), none)
  assert_eq(peaks(e), [])
  assert_eq(column(grid([[1, 2], [3, 4]]), 2), [])
  assert_eq(column(grid([[1, 2], [3, 4]]), 0), [1, 3])
}
