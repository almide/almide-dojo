test "flat storage" {
  let g = grid([[1, 2], [3, 4]])
  assert_eq(g, Grid { width: 2, cells: [1, 2, 3, 4] })
  assert_eq(get(g, 1, 0), some(3))
  assert_eq(neighbour_sum(g, 0, 0), 5)
}
test "peaks and columns" {
  let g = grid([[1, 2, 1], [2, 9, 2], [1, 2, 1]])
  assert_eq(peaks(g), ["1,1"])
  assert_eq(column(g, 1), [2, 9, 2])
}
