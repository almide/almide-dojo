// Configuration layers, lowest precedence first (defaults, then the file, then
// the environment). A layer is a list of (key, value) pairs; within a layer a
// later pair for the same key wins.
type Layer: Eq, Repr = { pairs: List[(String, String)] }

fn layer(pairs: List[(String, String)]) -> Layer = Layer { pairs: pairs }

fn in_layer(l: Layer, key: String) -> String? =
  l.pairs |> list.filter((p) => p.0 == key) |> list.last |> option.map((p) => p.1)

// The winning value: the last layer that sets the key decides.
fn lookup(layers: List[Layer], key: String) -> String? =
  layers |> list.reverse |> list.filter_map((l) => in_layer(l, key)) |> list.first

// The index of the layer that decides `key`, if any.
fn decided_by(layers: List[Layer], key: String) -> Int? =
  layers
    |> list.enumerate
    |> list.filter((p) => option.is_some(in_layer(p.1, key)))
    |> list.last
    |> option.map((p) => p.0)

// "key=value" for every key, keys in first-seen order (layer by layer).
fn effective(layers: List[Layer]) -> List[String] =
  layers
    |> list.flat_map((l) => l.pairs |> list.map((p) => p.0))
    |> list.unique
    |> list.map((k) => k + "=" + (lookup(layers, k) ?? ""))
