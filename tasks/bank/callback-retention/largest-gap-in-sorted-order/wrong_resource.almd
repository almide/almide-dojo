// Arrival times (minutes) of buses at a stop, in the order they were logged —
// NOT necessarily in time order.
fn earliest(ts: List[Int]) -> Int? = list.min(ts)

fn latest(ts: List[Int]) -> Int? = list.max(ts)

fn span(ts: List[Int]) -> Int =
  match (earliest(ts), latest(ts)) {
    (some(a), some(b)) => b - a,
    _ => 0,
  }

// Plausible wrong patch: sorts up front but measures inside the closure, so
// the closure captures the whole sorted copy.
fn gap_alarm(ts: List[Int]) -> (Int) -> String = {
  let s = list.sort(ts)
  (limit) => {
    let g = list.zip(s, list.drop(s, 1)) |> list.fold(0, (m, p) => {
      let (a, b) = p
      int.max(m, b - a)
    })
    "gap " + int.to_string(g) + (if g > limit then " over" else " ok")
  }
}
