// Resource probe: __K__ panels over fresh 20,000-reading lists, all held live.
// Capturing one Bool grows by a few bytes each; capturing `readings` grows by
// the whole list.
effect fn main() -> Unit = {
  let fs = list.range(0, __K__) |> list.map((i) => alarm_panel(list.range(0, 20000 + i) |> list.map((j) => 60 + (j * 7) % 30)))
  println(int.to_string(fs |> list.fold(0, (acc, f) => acc + string.len(f("t")))))
}
