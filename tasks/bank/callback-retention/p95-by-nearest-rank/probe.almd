// Resource probe: __K__ labels over fresh 20,000-latency lists, all held
// live. Capturing the value grows by a few bytes each; capturing a sorted
// copy grows by the whole list.
effect fn main() -> Unit = {
  let fs = list.range(0, __K__) |> list.map((i) => p95_label(list.range(0, 20000 + i) |> list.map((j) => (j * 7919) % 5000)))
  println(int.to_string(fs |> list.fold(0, (acc, f) => acc + string.len(f("/p")))))
}
