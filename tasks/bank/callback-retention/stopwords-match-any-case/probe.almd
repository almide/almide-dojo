// Resource probe: __K__ counters over fresh 80,000-character texts, all held
// live. Capturing the count grows by a few bytes each; capturing `text` grows
// by the whole text.
effect fn main() -> Unit = {
  let fs = list.range(0, __K__) |> list.map((i) => keyword_count(string.repeat("the quick brown fox ", 4000) + int.to_string(i)))
  println(int.to_string(fs |> list.fold(0, (acc, f) => acc + string.len(f("k")))))
}
