// Keyword statistics. Stop words ("the", "a", "an", "of", "and") are ignored
// whatever their case: "The" and "THE" are stop words too.
let STOP = ["the", "a", "an", "of", "and"]

fn is_stop(w: String) -> Bool = list.contains(STOP, string.to_lower(w))

fn words(text: String) -> List[String] = string.split(text, " ") |> list.filter((w) => w != "")

// Plausible wrong patch: the closure counts when it runs, so it captures
// `text` and keeps the whole text alive.
fn keyword_count(text: String) -> (String) -> String =
  (label) => label + ": " + int.to_string(words(text) |> list.count((w) => not is_stop(w))) + " keywords"
