// Resource probe: __K__ meters over fresh 20,000-file lists, all held live.
// Capturing the total grows by a few bytes each; capturing `sizes` grows by
// the whole list.
effect fn main() -> Unit = {
  let fs = list.range(0, __K__) |> list.map((i) => quota_meter(list.range(0, 20000 + i)))
  println(int.to_string(fs |> list.fold(0, (acc, f) => acc + string.len(f(1000000)))))
}
