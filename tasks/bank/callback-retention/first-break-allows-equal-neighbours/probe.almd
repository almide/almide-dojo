// Resource probe: __K__ audits over fresh 20,000-reading lists, all held live.
// Capturing the index grows by a few bytes each; capturing `xs` grows by the
// whole list.
effect fn main() -> Unit = {
  let fs = list.range(0, __K__) |> list.map((i) => audit(list.range(0, 20000 + i)))
  println(int.to_string(fs |> list.fold(0, (acc, f) => acc + string.len(f("m")))))
}
