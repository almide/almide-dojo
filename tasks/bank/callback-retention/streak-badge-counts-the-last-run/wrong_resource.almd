// A habit log: one Bool per day, true when the habit was done.
fn done_days(days: List[Bool]) -> Int = days |> list.count((d) => d)

fn completion(days: List[Bool]) -> String =
  if list.is_empty(days) then "no days"
  else int.to_string(done_days(days)) + "/" + int.to_string(list.len(days)) + " days"

// Plausible wrong patch: the closure scans the log when it runs, so it
// captures `days` and keeps the whole log alive.
fn streak_badge(days: List[Bool]) -> (String) -> String =
  (name) => {
    let (best, cur) = days |> list.fold((0, 0), (st, d) => {
      let (b, c) = st
      if d then (int.max(b, c + 1), c + 1) else (b, 0)
    })
    name + ": best " + int.to_string(best) + ", current " + int.to_string(cur)
  }
