// Station readings in tenths of a degree. The value -9999 is the station's
// "sensor offline" marker, not a temperature.
let MISSING = -9999

fn present(xs: List[Int]) -> Int = xs |> list.count((x) => x != MISSING)

fn tenths(x: Int) -> String = {
  let a = int.abs(x)
  (if x < 0 then "-" else "") + int.to_string(a / 10) + "." + int.to_string(a % 10)
}
