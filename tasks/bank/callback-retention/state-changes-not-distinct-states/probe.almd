// Resource probe: __K__ badges over fresh 20,000-second logs, all held live.
// Capturing the number grows by a few bytes each; capturing `xs` grows by the
// whole log.
effect fn main() -> Unit = {
  let fs = list.range(0, __K__) |> list.map((i) => change_badge(list.range(0, 20000 + i) |> list.map((j) => if j % 3 == 0 then "red" else "green")))
  println(int.to_string(fs |> list.fold(0, (acc, f) => acc + string.len(f("l")))))
}
