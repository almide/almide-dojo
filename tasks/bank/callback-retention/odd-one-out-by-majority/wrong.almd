// Readings from a set of identical sensors: all agree except, possibly, ONE
// faulty sensor. The faulty reading may be anywhere, including first.
fn agree(xs: List[Int]) -> Bool = list.len(list.unique(xs)) <= 1

fn spread(xs: List[Int]) -> Int = (list.max(xs) ?? 0) - (list.min(xs) ?? 0)

// Plausible wrong patch: compares every reading with the FIRST one, which
// blames the wrong sensor when the first reading is the faulty one.
fn faulty(xs: List[Int]) -> (String) -> String = {
  let odd = match list.first(xs) {
    some(f) => xs |> list.find_index((x) => x != f),
    none => none,
  }
  match odd {
    some(i) => (rack) => rack + ": sensor " + int.to_string(i),
    none => (rack) => rack + ": all agree",
  }
}
