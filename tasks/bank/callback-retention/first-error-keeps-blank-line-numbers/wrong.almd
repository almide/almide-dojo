// A build log. A line is an error when it starts with "error:"; the message
// is the rest of the line, trimmed. Line numbers count EVERY line from 1,
// blank lines included, as an editor shows them.
fn error_message(line: String) -> String? =
  string.strip_prefix(line, "error:") |> option.map((m) => string.trim(m))

fn error_count(lines: List[String]) -> Int =
  lines |> list.count((l) => option.is_some(error_message(l)))

fn verdict(lines: List[String]) -> String =
  match error_count(lines) {
    0 => "clean",
    1 => "1 error",
    n => int.to_string(n) + " errors",
  }

// Plausible wrong patch: drops blank lines before numbering ("they are
// noise"), so every error after a blank line gets a smaller line number.
fn locator(lines: List[String]) -> (String) -> String = {
  let found = lines
    |> list.filter((l) => string.trim(l) != "")
    |> list.enumerate
    |> list.filter_map(((i, l)) => error_message(l) |> option.map((m) => (i + 1, m)))
    |> list.first
  match found {
    some((n, m)) => (file) => file + ":" + int.to_string(n) + ": " + m,
    none => (file) => file + ": clean",
  }
}
