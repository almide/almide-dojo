// Resource probe: __K__ closures over fresh 20,000-build histories, all held
// live. Capturing the number grows by a few bytes each; capturing `builds`
// grows by the whole history.
effect fn main() -> Unit = {
  let fs = list.range(0, __K__) |> list.map((i) => streak(list.range(0, 20000 + i) |> list.map((j) => if j % 50 == 0 then "fail" else "pass")))
  println(int.to_string(fs |> list.fold(0, (acc, f) => acc + string.len(f("r")))))
}
