// Resource probe: __K__ statements over fresh 20,000-movement lists, all held
// live. Capturing two numbers grows by a few bytes each; capturing `ms` grows
// by the whole list.
effect fn main() -> Unit = {
  let fs = list.range(0, __K__) |> list.map((i) => statement(list.range(0, 20000 + i) |> list.map((j) => if j % 2 == 0 then 300 else -310)))
  println(int.to_string(fs |> list.fold(0, (acc, f) => acc + string.len(f("x")))))
}
