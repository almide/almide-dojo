// A checking account from balance 0. Movements are signed cents. A fee of 500
// is charged each time the balance CROSSES from zero-or-above to below zero
// (not again for further movements while it stays negative).
fn apply_fee(before: Int, after: Int) -> Int = if before >= 0 and after < 0 then after - 500 else after

fn deposits(ms: List[Int]) -> Int = ms |> list.filter((m) => m > 0) |> list.sum

fn withdrawals(ms: List[Int]) -> Int = ms |> list.filter((m) => m < 0) |> list.sum
