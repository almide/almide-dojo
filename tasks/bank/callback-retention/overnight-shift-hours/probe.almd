// Resource probe: __K__ timesheets over fresh 3,000-shift lists, all held
// live. Capturing the total grows by a few bytes each; capturing `shifts`
// grows by every shift's strings.
effect fn main() -> Unit = {
  let sheets = list.range(0, __K__) |> list.map((i) =>
    timesheet(list.range(0, 3000) |> list.map((j) => ("0" + int.to_string(j % 10) + ":00", "1" + int.to_string((j + i) % 10) + ":30"))))
  println(int.to_string(sheets |> list.fold(0, (acc, f) => acc + string.len(f("x")))))
}
