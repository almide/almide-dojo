// Page numbers cited in a chapter, in citation order.
fn cited(pages: List[Int], p: Int) -> Bool = list.contains(pages, p)

fn citation_count(pages: List[Int]) -> Int = list.len(pages)

// Plausible wrong patch: collapses only when exactly one page is cited, so a
// page cited several times comes out as "7-7".
fn page_label(pages: List[Int]) -> (String) -> String =
  match option.zip(list.min(pages), list.max(pages)) {
    some((lo, hi)) => (prefix) => prefix + (if list.len(pages) == 1 then int.to_string(lo) else int.to_string(lo) + "-" + int.to_string(hi)),
    none => (prefix) => prefix + "none",
  }
