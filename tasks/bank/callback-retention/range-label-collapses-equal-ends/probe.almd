// Resource probe: __K__ labels over fresh 20,000-citation lists, all held
// live. Capturing two numbers grows by a few bytes each; capturing `pages`
// grows by the whole list.
effect fn main() -> Unit = {
  let fs = list.range(0, __K__) |> list.map((i) => page_label(list.range(0, 20000 + i) |> list.map((j) => (j * 31) % 900 + 1)))
  println(int.to_string(fs |> list.fold(0, (acc, f) => acc + string.len(f("pp. ")))))
}
