// Resource probe: __K__ reports over fresh 5,000-line files, all held live.
// Capturing the counts grows by a few bytes each; capturing the lines grows by
// the whole file.
effect fn main() -> Unit = {
  let fs = list.range(0, __K__) |> list.map((i) => validity(list.range(0, 5000) |> list.map((j) => "key" + int.to_string(j + i) + "=value")))
  println(int.to_string(fs |> list.fold(0, (acc, f) => acc + string.len(f("x")))))
}
