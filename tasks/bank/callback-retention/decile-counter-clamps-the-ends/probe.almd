// Resource probe: __K__ counters over fresh 20,000-score lists, all held live.
// Capturing ten counts grows by a few bytes each; capturing `scores` grows by
// the whole list.
effect fn main() -> Unit = {
  let fs = list.range(0, __K__) |> list.map((i) => decile_counter(list.range(0, 20000 + i) |> list.map((j) => j % 105)))
  println(int.to_string(fs |> list.fold(0, (acc, f) => acc + string.len(f(50)))))
}
