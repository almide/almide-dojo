// Resource probe: __K__ uptime closures over fresh 4,000-line logs, all held
// live. Capturing the span grows by a few bytes each; capturing the parsed
// events grows by the whole log.
effect fn main() -> Unit = {
  let fs = list.range(0, __K__) |> list.map((i) =>
    uptime(list.range(0, 4000) |> list.map((j) => int.to_string(j * 10 + i) + (if j % 2 == 0 then " START" else " STOP"))))
  println(int.to_string(fs |> list.fold(0, (acc, f) => acc + string.len(f("s")))))
}
