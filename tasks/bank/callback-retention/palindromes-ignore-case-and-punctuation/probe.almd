// Resource probe: __K__ counters over fresh 3,000-line texts, all held live.
// Capturing the count grows by a few bytes each; capturing `lines` grows by
// every line.
effect fn main() -> Unit = {
  let fs = list.range(0, __K__) |> list.map((i) => palindrome_count(list.range(0, 3000) |> list.map((j) => "line number " + int.to_string(j + i))))
  println(int.to_string(fs |> list.fold(0, (acc, f) => acc + string.len(f("p")))))
}
