test "hidden: case and punctuation are ignored" {
  assert_eq(palindrome_count(["A man, a plan, a canal: Panama", "Racecar", "no x on"])("a"), "a: 3 palindromes")
  assert_eq(palindrome_count(["!!", "", "ab"])("b"), "b: 0 palindromes")
}
test "hidden: helpers unchanged" {
  assert_eq(clean("Hi, 2U!"), "hi2u")
}
