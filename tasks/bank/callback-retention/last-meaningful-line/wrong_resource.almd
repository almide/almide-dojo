// Console transcripts. Blank lines and lines of only spaces carry nothing.
fn meaningful(line: String) -> Bool = string.trim(line) != ""

fn line_count(lines: List[String]) -> Int = lines |> list.count((l) => meaningful(l))

fn first_line(lines: List[String]) -> String = lines |> list.find((l) => meaningful(l)) ?? ""

// Plausible wrong patch: the closure searches when it runs, so it captures
// `lines` and keeps the whole transcript alive.
fn last_words(lines: List[String]) -> (String) -> String =
  (fallback) => lines |> list.filter((l) => meaningful(l)) |> list.last |> option.map((l) => string.trim(l)) ?? fallback
