// Summaries of a list of readings.
fn total(xs: List[Int]) -> Int = xs |> list.fold(0, (a, x) => a + x)

// Integer mean for display, rounded toward zero; 0 for no readings.
fn mean(xs: List[Int]) -> Int =
  if list.is_empty(xs) then 0 else total(xs) / list.len(xs)

fn report(xs: List[Int]) -> String =
  "n=" + int.to_string(list.len(xs)) + ",mean~" + int.to_string(mean(xs))

// Strictly above the exact mean: x > sum / n  <=>  x * n > sum (n > 0).
// The closure captures the two numbers only.
fn above_mean(xs: List[Int]) -> (Int) -> Bool = {
  let s = total(xs)
  let n = list.len(xs)
  (x) => n > 0 and x * n > s
}
