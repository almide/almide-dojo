// Text statistics. Words are separated by ANY whitespace: spaces, tabs and
// newlines, in runs.
fn is_space(c: String) -> Bool = c == " " or c == "\t" or c == "\n"

fn words(text: String) -> List[String] =
  string.chars(text)
    |> list.map((c) => if is_space(c) then " " else c)
    |> list.join("")
    |> string.split(" ")
    |> list.filter((w) => w != "")

fn word_count(text: String) -> Int = list.len(words(text))

// Plausible wrong patch: splits on spaces only, so "ab\tcdefgh" counts as one
// long word.
fn longest_badge(text: String) -> (String) -> String = {
  let best = string.split(text, " ") |> list.fold("", (b, w) => if string.len(w) > string.len(b) then w else b)
  let n = string.len(best)
  (label) => if n == 0 then label + ": -" else label + ": " + best + " (" + int.to_string(n) + ")"
}
