// Character statistics of a text (case-sensitive).
fn occurrences(text: String, c: String) -> Int = string.count_matches(text, c)

fn distinct_chars(text: String) -> Int = list.len(list.unique(string.to_list(text)))

// Plausible wrong patch: the closure searches when it runs, so it captures
// `text` and keeps the whole text alive.
fn unique_marker(text: String) -> (String) -> String =
  (label) => label + ": " + (string.to_list(text) |> list.find((c) => string.count_matches(text, c) == 1) ?? "none")
