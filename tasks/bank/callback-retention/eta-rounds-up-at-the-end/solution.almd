// Durations in whole seconds, and samples of seconds spent per work unit.
fn pad2(n: Int) -> String = if n < 10 then "0" + int.to_string(n) else int.to_string(n)

// "1h02m03s"; below an hour "2m03s"; below a minute "3s".
fn format_secs(s: Int) -> String =
  if s >= 3600 then int.to_string(s / 3600) + "h" + pad2((s % 3600) / 60) + "m" + pad2(s % 60) + "s"
  else if s >= 60 then int.to_string(s / 60) + "m" + pad2(s % 60) + "s"
  else int.to_string(s) + "s"

fn spent(samples: List[Int]) -> String = format_secs(samples |> list.fold(0, (a, x) => a + x))

// The closure captures the two totals only; the product is rounded up once.
fn eta(samples: List[Int]) -> (Int) -> String = {
  let total = samples |> list.fold(0, (a, x) => a + x)
  let n = list.len(samples)
  (remaining) => if n == 0 then "unknown" else format_secs((remaining * total + n - 1) / n)
}
