// Resource probe: __K__ summaries over fresh 3,000-tag lists (30 distinct),
// all held live. Capturing the count grows by a few bytes each; capturing
// `tags` grows by every tag string.
effect fn main() -> Unit = {
  let fs = list.range(0, __K__) |> list.map((i) => tag_summary(list.range(0, 3000) |> list.map((j) => " Topic-" + int.to_string((j + i) % 30) + " ")))
  println(int.to_string(fs |> list.fold(0, (acc, f) => acc + string.len(f("t")))))
}
