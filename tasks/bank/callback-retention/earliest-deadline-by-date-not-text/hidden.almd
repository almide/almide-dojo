test "hidden: calendar order, not text order" {
  assert_eq(next_deadline(["9/1/2027", "10/12/2026"])("a"), "a: due 10/12/2026")
  assert_eq(next_deadline(["1/12/2026", "5/1/2026"])("b"), "b: due 5/1/2026")
  assert_eq(next_deadline(["30/1/2026", "4/1/2026"])("d"), "d: due 4/1/2026")
}
test "hidden: invalid ignored" {
  assert_eq(next_deadline(["bad", "1/1/2030"])("c"), "c: due 1/1/2030")
  assert_eq(valid_dates(["1/2/3", "1-2-3"]), 1)
}
