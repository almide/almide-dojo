// Payment events (id, cents). The same payment can be delivered more than once
// (retries); an id counts ONCE, with the amount of its FIRST delivery, even if
// a retry carries a different amount.
fn ids(events: List[(String, Int)]) -> List[String] = events |> list.map(((id, _)) => id) |> list.unique

fn deliveries(events: List[(String, Int)], id: String) -> Int = events |> list.count(((i, _)) => i == id)

fn retried(events: List[(String, Int)]) -> List[String] = ids(events) |> list.filter((id) => deliveries(events, id) > 1)

// Plausible wrong patch: removes duplicate EVENTS with list.unique, which only
// drops exact repeats — a retry with a different amount still counts.
fn deferred_total(events: List[(String, Int)], fmt: (Int) -> String) -> () -> String = {
  let total = list.unique(events) |> list.fold(0, (t, e) => {
    let (_, c) = e
    t + c
  })
  () => fmt(total)
}
