// Batches of signed adjustments. The weighted sum gives position i (from 0)
// the weight i + 1.
fn weighted(xs: List[Int]) -> Int =
  xs |> list.enumerate |> list.fold(0, (acc, p) => {
    let (i, x) = p
    acc + (i + 1) * x
  })

fn describe(xs: List[Int]) -> String =
  int.to_string(list.len(xs)) + " items, weighted " + int.to_string(weighted(xs))
