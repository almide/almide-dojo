// Ticket ids "T-<n>". Tickets get deleted, so the numbers have gaps; a
// malformed id is ignored.
fn number(id: String) -> Int? = string.strip_prefix(id, "T-") |> option.flat_map((n) => int.parse(n)?)

fn valid(ids: List[String]) -> Int = ids |> list.count((i) => option.is_some(number(i)))

fn has(ids: List[String], n: Int) -> Bool = ids |> list.any((i) => number(i) == some(n))

// Plausible wrong patch: the closure scans the ids when it runs, so it
// captures `ids` and keeps them all alive.
fn allocator(ids: List[String]) -> (String) -> String =
  (prefix) => prefix + "T-" + int.to_string((ids |> list.filter_map((i) => number(i)) |> list.max ?? 0) + 1)
