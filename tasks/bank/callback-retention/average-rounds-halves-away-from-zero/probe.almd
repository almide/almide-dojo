// Resource probe: __K__ badges over fresh 20,000-delta lists, all held live.
// Capturing one number grows by a few bytes each; capturing `xs` grows by the
// whole list.
effect fn main() -> Unit = {
  let fs = list.range(0, __K__) |> list.map((i) => avg_badge(list.range(0, 20000 + i) |> list.map((j) => j % 9 - 4)))
  println(int.to_string(fs |> list.fold(0, (acc, f) => acc + string.len(f("x")))))
}
