test "hidden: symmetric rounding for negatives" {
  assert_eq(avg_badge([-2, -3])("a"), "a: avg -3")
  assert_eq(avg_badge([-1, -2, -2])("b"), "b: avg -2")
  assert_eq(avg_badge([-1, 0])("c"), "c: avg -1")
  assert_eq(avg_badge([-1, -1, 1])("d"), "d: avg 0")
}
test "hidden: describe unchanged" {
  assert_eq(describe([-1, 3]), "2 deltas, net 2")
}
