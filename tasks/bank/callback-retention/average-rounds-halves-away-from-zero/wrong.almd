// Temperature deltas (signed integers).
fn net(xs: List[Int]) -> Int = list.sum(xs)

fn warming(xs: List[Int]) -> Bool = net(xs) > 0

fn describe(xs: List[Int]) -> String = int.to_string(list.len(xs)) + " deltas, net " + int.to_string(net(xs))

// Plausible wrong patch: the usual "(sum + n / 2) / n", which rounds halves up
// for positive means but toward zero (or the wrong way) for negative ones.
fn avg_badge(xs: List[Int]) -> (String) -> String = {
  let n = list.len(xs)
  let avg = if n == 0 then 0 else (net(xs) + n / 2) / n
  (label) => if n == 0 then label + ": avg n/a" else label + ": avg " + int.to_string(avg)
}
