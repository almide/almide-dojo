// Integer samples. Medians are shown exactly: a whole number, or a number
// ending in ".5" when the two middle values have an odd sum.
fn sorted_copy(xs: List[Int]) -> List[Int] = list.sort(xs)

fn middle_pair(xs: List[Int]) -> (Int, Int)? = {
  let s = sorted_copy(xs)
  let n = list.len(s)
  if n == 0 then none
  else some((list.get(s, (n - 1) / 2) ?? 0, list.get(s, n / 2) ?? 0))
}

fn range_text(xs: List[Int]) -> String =
  match (list.min(xs), list.max(xs)) {
    (some(lo), some(hi)) => int.to_string(lo) + ".." + int.to_string(hi),
    _ => "empty",
  }
