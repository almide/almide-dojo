test "hidden: negative halves keep their sign" {
  assert_eq(median_text([-1, 0]), "median=-0.5")
  assert_eq(median_text([0, -3]), "median=-1.5")
  assert_eq(median_text([-2, -4]), "median=-3")
}
test "hidden: mixed" {
  assert_eq(median_text([-5, 6]), "median=0.5")
  assert_eq(median_text([7]), "median=7")
  assert_eq(range_text([2, -2]), "-2..2")
}
