// Email addresses "local@domain". Domains compare case-insensitively. Only
// for gmail.com are dots in the local part ignored and a "+tag" suffix
// dropped; every other provider treats them as different mailboxes.
fn split_email(e: String) -> (String, String)? =
  match string.split(e, "@") {
    [l, d] => if l != "" and d != "" then some((l, string.to_lower(d))) else none,
    _ => none,
  }

fn valid_count(es: List[String]) -> Int = es |> list.count((e) => option.is_some(split_email(e)))

fn domains(es: List[String]) -> List[String] =
  es |> list.filter_map((e) => split_email(e) |> option.map(((_, d)) => d)) |> list.unique

fn canonical(user: String, domain: String) -> String =
  if domain == "gmail.com" then {
    let base = string.split(user, "+") |> list.first ?? user
    string.replace(base, ".", "") + "@" + domain
  } else user + "@" + domain

// Canonical addresses collected in a local set.
fn inboxes(es: List[String]) -> String = {
  let parts = es |> list.filter_map((e) => split_email(e))
  let unique = parts |> list.map(((l, d)) => canonical(l, d)) |> set.from_list |> set.len
  "unique=" + int.to_string(unique) + ",invalid=" + int.to_string(list.len(es) - list.len(parts))
}
