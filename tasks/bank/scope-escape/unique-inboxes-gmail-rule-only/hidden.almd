test "hidden: the gmail rule is gmail-only" {
  assert_eq(inboxes(["a.b@x.org", "ab@x.org", "ab+q@x.org"]), "unique=3,invalid=0")
  assert_eq(inboxes(["ab+news@GMail.com", "a.b@gmail.com", "AB@gmail.com"]), "unique=2,invalid=0")
}
test "hidden: invalid shapes" {
  assert_eq(inboxes(["@x.org", "a@", "a@b@c", ""]), "unique=0,invalid=4")
  assert_eq(domains(["a@X.org", "b@x.org"]), ["x.org"])
}
