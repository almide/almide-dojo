test "hidden: ties share a rank" {
  let t = [Score { player: "d", points: 7 }, Score { player: "a", points: 9 }, Score { player: "b", points: 7 }, Score { player: "c", points: 1 }]
  assert_eq(rank_of(t, "d"), "rank=2 of 4")
  assert_eq(rank_of(t, "b"), "rank=2 of 4")
  assert_eq(rank_of(t, "c"), "rank=4 of 4")
}
test "hidden: all equal, negatives, empty" {
  let t = [Score { player: "y", points: -3 }, Score { player: "x", points: -3 }]
  assert_eq(rank_of(t, "y"), "rank=1 of 2")
  assert_eq(rank_of([], "y"), "unranked")
}
test "hidden: leaderboard unchanged" {
  assert_eq(leaderboard([Score { player: "b", points: 2 }, Score { player: "a", points: 2 }]), ["1. a (2)", "2. b (2)"])
}
