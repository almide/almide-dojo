test "hidden: ties go to the lowest bucket" {
  assert_eq(busiest([25, 26, 5, 6], 10), "[0,10) x2")
  assert_eq(busiest([3, -3, 7, -7], 10), "[-10,0) x2")
}
test "hidden: negative buckets" {
  assert_eq(busiest([-1, -2, -15, 4], 10), "[-10,0) x2")
  assert_eq(busiest([-10], 5), "[-10,-5) x1")
}
test "hidden: histogram unchanged" {
  assert_eq(histogram([5, -5, 5], 5), ["[-5,0) 1", "[5,10) 2"])
}
