// A 4x4 sudoku as four strings of digits 1-4, "." for an empty cell. A unit
// (row, column or 2x2 box) is valid when no digit repeats in it.
fn cell(grid: List[String], r: Int, c: Int) -> String = list.get(grid, r) |> option.flat_map((row) => string.get(row, c)) ?? "."

fn repeats(cells: List[String]) -> Bool = {
  let digits = cells |> list.filter((x) => x != ".")
  list.len(digits) != list.len(list.unique(digits))
}

fn row_cells(grid: List[String], r: Int) -> List[String] = list.range(0, 4) |> list.map((c) => cell(grid, r, c))

fn filled(grid: List[String]) -> Int = list.range(0, 16) |> list.count((i) => cell(grid, i / 4, i % 4) != ".")

fn col_cells(grid: List[String], c: Int) -> List[String] = list.range(0, 4) |> list.map((r) => cell(grid, r, c))

fn box_cells(grid: List[String], b: Int) -> List[String] =
  list.range(0, 4) |> list.map((i) => cell(grid, (b / 2) * 2 + i / 2, (b % 2) * 2 + i % 2))

// Plausible wrong patch: checks unit by unit INDEX (row 1, col 1, box 1,
// row 2, ...), so a column conflict can be reported before a later row's.
fn first_conflict(grid: List[String]) -> String = {
  let units = list.range(0, 4) |> list.flat_map((i) => [
    ("row " + int.to_string(i + 1), row_cells(grid, i)),
    ("col " + int.to_string(i + 1), col_cells(grid, i)),
    ("box " + int.to_string(i + 1), box_cells(grid, i)),
  ])
  match units |> list.find(((_, cs)) => repeats(cs)) {
    some((name, _)) => name,
    none => "ok",
  }
}
