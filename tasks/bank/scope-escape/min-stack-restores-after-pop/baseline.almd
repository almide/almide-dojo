// A stack program: "push <n>", "pop", "min". "min" reports the smallest value
// currently ON the stack; after a pop, values no longer on the stack do not
// count.
fn parse_op(s: String) -> Result[(String, Int), String] =
  match string.split(s, " ") {
    ["push", n] => int.parse(n) |> result.map((v) => ("push", v)) |> result.map_err((_) => "bad op: " + s),
    ["pop"] => ok(("pop", 0)),
    ["min"] => ok(("min", 0)),
    _ => err("bad op: " + s),
  }

fn parse_program(ss: List[String]) -> Result[List[(String, Int)], String] = ss |> list.map((s) => parse_op(s)!)

fn pushes(ss: List[String]) -> Result[Int, String] = {
  let ops = parse_program(ss)!
  ok(ops |> list.count(((o, _)) => o == "push"))
}
