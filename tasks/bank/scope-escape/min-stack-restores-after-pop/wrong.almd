// A stack program: "push <n>", "pop", "min". "min" reports the smallest value
// currently ON the stack; after a pop, values no longer on the stack do not
// count.
fn parse_op(s: String) -> Result[(String, Int), String] =
  match string.split(s, " ") {
    ["push", n] => int.parse(n) |> result.map((v) => ("push", v)) |> result.map_err((_) => "bad op: " + s),
    ["pop"] => ok(("pop", 0)),
    ["min"] => ok(("min", 0)),
    _ => err("bad op: " + s),
  }

fn parse_program(ss: List[String]) -> Result[List[(String, Int)], String] = ss |> list.map((s) => parse_op(s)!)

fn pushes(ss: List[String]) -> Result[Int, String] = {
  let ops = parse_program(ss)!
  ok(ops |> list.count(((o, _)) => o == "push"))
}

// Plausible wrong patch: keeps one running minimum next to the stack; a pop
// shrinks the stack but never restores the minimum.
fn run(ss: List[String]) -> String =
  match parse_program(ss) {
    err(e) => e,
    ok(ops) => {
      let (_, _, answers) = ops |> list.fold(([], none, []), (st, op) => {
        let (stack, lo, out) = st
        match op {
          ("push", v) => (stack + [v], some(match lo {
            some(m) => int.min(m, v),
            none => v,
          }), out),
          ("pop", _) => (list.drop_end(stack, 1), if list.len(stack) <= 1 then none else lo, out),
          _ => (stack, lo, out + [match lo {
            some(m) => int.to_string(m),
            none => "empty",
          }]),
        }
      })
      list.join(answers, ",")
    },
  }
