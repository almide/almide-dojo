// Polynomial terms like "3x^2", "-x", "x^3", "7", "-4x". A term is
// coefficient * x^exponent; a missing coefficient is 1 (or -1 after "-"), "x"
// alone has exponent 1, a bare number has exponent 0.
fn parse_coeff(c: String) -> Result[Int, String] =
  match c {
    "" => ok(1),
    "-" => ok(-1),
    "+" => ok(1),
    _ => int.parse(c),
  }

fn parse_term(t: String) -> Result[(Int, Int), String] =
  match string.index_of(t, "x") {
    none => result.map_err(int.parse(t), (_) => "bad term: " + t) |> result.map((c) => (c, 0)),
    some(i) => {
      let c = parse_coeff(string.slice(t, 0, i)) |> result.map_err((_) => "bad term: " + t)
      let rest = string.drop(t, i + 1)
      let e = if rest == "" then ok(1) else match string.strip_prefix(rest, "^") {
        some(p) => int.parse(p) |> result.map_err((_) => "bad term: " + t),
        none => err("bad term: " + t),
      }
      match c {
        ok(cv) => match e {
          ok(ev) => ok((cv, ev)),
          err(m) => err(m),
        },
        err(m) => err(m),
      }
    },
  }

fn parse_poly(terms: List[String]) -> Result[List[(Int, Int)], String] =
  terms |> list.map((t) => parse_term(t)!)

// Value at x = 1: the sum of all coefficients.
fn at_one(terms: List[String]) -> Result[Int, String] = {
  let ts = parse_poly(terms)!
  ok(ts |> list.fold(0, (a, t) => {
    let (c, _) = t
    a + c
  }))
}

// Coefficients are combined per power first; the table stays local.
fn leading(terms: List[String]) -> String =
  match parse_poly(terms) {
    err(e) => e,
    ok(ts) => {
      let combined = ts |> list.fold(map.new(), (m, t) => {
        let (c, e) = t
        map.set(m, e, (map.get(m, e) ?? 0) + c)
      })
      let live = map.entries(combined) |> list.filter(((_, c)) => c != 0) |> list.sort_by(((e, _)) => 0 - e)
      match list.first(live) {
        some((e, c)) => "deg=" + int.to_string(e) + ",lead=" + int.to_string(c),
        none => "zero",
      }
    },
  }
