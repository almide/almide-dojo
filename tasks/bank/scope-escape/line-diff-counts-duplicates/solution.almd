// Two versions of a text file, as lists of lines. Lines compare exactly
// (case and spaces matter).
fn changed(old: List[String], new_lines: List[String]) -> Bool = old != new_lines

fn line_count_delta(old: List[String], new_lines: List[String]) -> String = {
  let d = list.len(new_lines) - list.len(old)
  if d > 0 then "+" + int.to_string(d) else int.to_string(d)
}

fn describe(old: List[String], new_lines: List[String]) -> String =
  if changed(old, new_lines) then "changed (" + line_count_delta(old, new_lines) + " lines)" else "unchanged"

fn counts(lines: List[String]) -> Map[String, Int] =
  lines |> list.fold(map.new(), (m, l) => map.set(m, l, (map.get(m, l) ?? 0) + 1))

// Multiset difference both ways; the count tables stay local.
fn diffstat(old: List[String], new_lines: List[String]) -> String = {
  let a = counts(old)
  let b = counts(new_lines)
  let added = map.entries(b) |> list.fold(0, (acc, e) => {
    let (l, n) = e
    acc + int.max(0, n - (map.get(a, l) ?? 0))
  })
  let removed = map.entries(a) |> list.fold(0, (acc, e) => {
    let (l, n) = e
    acc + int.max(0, n - (map.get(b, l) ?? 0))
  })
  "added=" + int.to_string(added) + ",removed=" + int.to_string(removed)
}
