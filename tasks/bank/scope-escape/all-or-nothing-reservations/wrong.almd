// Reservation requests against a stock, processed IN ORDER. A request is
// "sku:qty,sku:qty,...". A request is filled only if EVERY line can be served
// from what is left; otherwise nothing of it is taken.
fn parse_request(r: String) -> List[(String, Int)] =
  string.split(r, ",") |> list.filter_map((l) => match string.split(l, ":") {
    [s, q] => int.parse(q)? |> option.map((n) => (s, n)),
    _ => none,
  })

fn requested_units(rs: List[String]) -> Int =
  rs |> list.fold(0, (a, r) => a + (parse_request(r) |> list.fold(0, (b, l) => {
    let (_, q) = l
    b + q
  })))

// Plausible wrong patch: serves the lines one by one and marks the request
// refused if any line fails — but the lines served before the failure have
// already been taken from the stock.
fn reserve(stock: Map[String, Int], rs: List[String]) -> String = {
  let (_, filled, refused) = rs |> list.fold((stock, 0, 0), (st, r) => {
    let (left, f, x) = st
    let (after, ok_all) = parse_request(r) |> list.fold((left, true), (inner, l) => {
      let (m, good) = inner
      let (s, q) = l
      let have = map.get(m, s) ?? 0
      if have >= q then (map.set(m, s, have - q), good) else (m, false)
    })
    if ok_all then (after, f + 1, x) else (after, f, x + 1)
  })
  "filled=" + int.to_string(filled) + ",refused=" + int.to_string(refused)
}
