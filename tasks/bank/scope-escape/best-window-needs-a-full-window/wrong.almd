// Daily sales figures. A window is k CONSECUTIVE days.
fn validate_k(k: Int) -> Result[Int, String] = if k >= 1 then ok(k) else err("window must be at least 1 day")

fn window_sums(xs: List[Int], k: Int) -> List[Int] = list.windows(xs, k) |> list.map((w) => list.sum(w))

fn total(xs: List[Int]) -> Int = list.sum(xs)

// Plausible wrong patch: folds the window sums from 0, so no full window
// reports "best=0" and an all-negative series reports 0 too.
fn best_window(xs: List[Int], k: Int) -> String =
  match validate_k(k) {
    err(e) => e,
    ok(kk) => "best=" + int.to_string(window_sums(xs, kk) |> list.fold(0, (m, s) => int.max(m, s))),
  }
