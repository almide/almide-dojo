test "hidden: repeated indices add up" {
  assert_eq(dot("1:2 1:3", "1:10"), "dot=50")
  assert_eq(dot("4:1", "4:-1 4:3 5:9"), "dot=2")
}
test "hidden: errors and empties" {
  assert_eq(dot("", "1:1"), "dot=0")
  assert_eq(dot("1:1 z", "q"), "error=bad pair: z")
  assert_eq(dot("1:1", "q"), "error=bad pair: q")
}
test "hidden: norm unchanged" {
  assert_eq(norm1("2:3 2:-5 7:1"), ok(3))
}
