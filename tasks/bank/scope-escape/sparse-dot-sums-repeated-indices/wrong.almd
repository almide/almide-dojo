// Sparse vectors written as "index:value" pairs separated by spaces, e.g.
// "3:5 7:-2". An index may appear more than once; its values add up.
fn parse_pair(tok: String) -> Result[(Int, Int), String] =
  match string.split(tok, ":") {
    [i, v] => match int.parse(i) {
      ok(ix) => match int.parse(v) {
        ok(val) => ok((ix, val)),
        err(_) => err("bad pair: " + tok),
      },
      err(_) => err("bad pair: " + tok),
    },
    _ => err("bad pair: " + tok),
  }

fn parse_sparse(s: String) -> Result[List[(Int, Int)], String] =
  string.split(s, " ") |> list.filter((t) => t != "") |> list.map((t) => parse_pair(t)!)

// Sum of absolute values, index by index (repeated indices add up first).
fn norm1(s: String) -> Result[Int, String] = {
  let pairs = parse_sparse(s)!
  let by_index = pairs |> list.fold(map.new(), (m, p) => {
    let (i, v) = p
    map.set(m, i, (map.get(m, i) ?? 0) + v)
  })
  ok(map.values(by_index) |> list.fold(0, (a, v) => a + int.abs(v)))
}

// Plausible wrong patch: builds each table with map.from_list, which keeps
// only the LAST value of a repeated index instead of adding them up.
fn dot(a: String, b: String) -> String =
  match parse_sparse(a) {
    err(e) => "error=" + e,
    ok(pa) => match parse_sparse(b) {
      err(e) => "error=" + e,
      ok(pb) => {
        let ta = map.from_list(pa)
        let tb = map.from_list(pb)
        "dot=" + int.to_string(map.entries(ta) |> list.fold(0, (acc, e) => {
          let (i, v) = e
          acc + v * (map.get(tb, i) ?? 0)
        }))
      },
    },
  }
