// Jobs "name:priority:arrival". Each job takes one time unit; a higher
// priority number is more urgent.
type Job = { name: String, prio: Int, arrival: Int }

fn parse_job(s: String) -> Result[Job, String] =
  match string.split(s, ":") {
    [n, p, a] => match (int.parse(p), int.parse(a)) {
      (ok(pv), ok(av)) => ok(Job { name: n, prio: pv, arrival: av }),
      _ => err("bad job: " + s),
    },
    _ => err("bad job: " + s),
  }

fn parse_jobs(ss: List[String]) -> Result[List[Job], String] = ss |> list.map((s) => parse_job(s)!)

fn by_urgency(jobs: List[Job]) -> List[String] =
  jobs |> list.sort_by((j) => 0 - j.prio) |> list.map((j) => j.name)

fn schedule(waiting: List[Job], now: Int, done: List[String]) -> List[String] =
  if list.is_empty(waiting) then done
  else {
    let ready = waiting |> list.filter((j) => j.arrival <= now)
    match ready |> list.sort_by((j) => j.arrival) |> list.sort_by((j) => 0 - j.prio) |> list.first {
      some(j) => schedule(waiting |> list.filter((w) => w != j), now + 1, done + [j.name]),
      none => schedule(waiting, waiting |> list.map((j) => j.arrival) |> list.min ?? now, done),
    }
  }

// One job per time unit among those already arrived; the queue stays local.
fn run_order(ss: List[String]) -> String =
  match parse_jobs(ss) {
    err(e) => e,
    ok(jobs) => "order=" + list.join(schedule(jobs, 0, []), ","),
  }
