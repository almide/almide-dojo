test "hidden: same-level siblings are leaves" {
  assert_eq(outline_stats("a\n  b\n  c\nd\n  e\n"), "items=5,leaves=3")
  assert_eq(outline_stats("x\ny\nz"), "items=3,leaves=3")
}
test "hidden: the last entry is a leaf" {
  assert_eq(outline_stats("a\n  b"), "items=2,leaves=1")
  assert_eq(outline_stats("only"), "items=1,leaves=1")
  assert_eq(outline_stats("a\n  b\n    c\n\n  d"), "items=4,leaves=2")
}
test "hidden: empty" {
  assert_eq(outline_stats("\n\n"), "items=0,leaves=0")
  assert_eq(deepest("x\n      y"), 3)
}
