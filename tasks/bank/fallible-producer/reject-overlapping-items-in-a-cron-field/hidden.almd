test "hidden: overlap between different items, exact message" {
  assert_eq(schedule("0-10/5,7,5"), err("minute 5 listed twice in 0-10/5,7,5"))
  assert_eq(count("*/20,40-45"), err("minute 40 listed twice in */20,40-45"))
}
test "hidden: the first repeated minute in item order is reported" {
  assert_eq(schedule("50-55,10-20,52,12"), err("minute 52 listed twice in 50-55,10-20,52,12"))
}
test "hidden: items that only look alike are fine" {
  assert_eq(schedule("1-3,4-6"), ok([1, 2, 3, 4, 5, 6]))
  assert_eq(count("*/15,7,*/15 "), err("minute 0 listed twice in */15,7,*/15 "))
  assert_eq(count("*/15,7"), ok(5))
}
test "hidden: item errors come first, left to right" {
  assert_eq(schedule("5,5,61"), err("minute 5 listed twice in 5,5,61"))
  assert_eq(schedule("61,5,5"), err("value 61 out of range 0-59"))
  assert_eq(schedule("5,9-3,5"), err("empty range 9-3"))
}
