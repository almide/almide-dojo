test "hidden: any common factor counts, exact message" {
  assert_eq(parse_qty("3/9") |> result.map((q) => q.num), err("3/9 is not in lowest terms (use 1/3)"))
  assert_eq(scale(["1/2 cup milk", "10/15 tsp salt"], 3), err("10/15 is not in lowest terms (use 2/3)"))
}
test "hidden: a reducible fraction that is a whole number suggests the whole number" {
  assert_eq(parse_qty("4/2") |> result.map((q) => q.num), err("4/2 is not in lowest terms (use 2)"))
}
test "hidden: reduced fractions, improper ones and n/1 stay valid" {
  assert_eq(scale(["5/3 cup rice", "7/1 g yeast", "9/10 l water"], 1), ok(["5/3 cup rice", "7 g yeast", "9/10 l water"]))
}
test "hidden: older checks win" {
  assert_eq(parse_qty("0/4") |> result.map((q) => q.num), err("quantity must be positive: 0/4"))
  assert_eq(parse_qty("2/0") |> result.map((q) => q.num), err("zero denominator in 2/0"))
  assert_eq(scale(["2/4 cup a", "x cup b"], 1), err("2/4 is not in lowest terms (use 1/2)"))
}
