// Path resolver for a sandboxed file tree. Paths are relative, "/"-separated;
// "." is the current directory and ".." the parent. `resolve(base, rel)` joins
// a relative path onto a base directory; "." stands for the root itself.
fn segments(p: String) -> List[String]! = {
  guard not string.starts_with(p, "/") else err("absolute path not allowed: ${p}")
  if p == "" or p == "." then ok([])
  else {
    let parts = string.split(p, "/")
    guard not list.contains(parts, "") else err("empty segment in ${p}")
    ok(parts)
  }
}

fn walk(stack: List[String], parts: List[String]) -> List[String] =
  parts |> list.fold(stack, (st, s) =>
    match s {
      "." => st,
      ".." => list.drop_end(st, 1),
      _ => st + [s],
    })

fn show(stack: List[String]) -> String = if list.is_empty(stack) then "." else list.join(stack, "/")

fn resolve(base: String, rel: String) -> String! = {
  let b = segments(base)!
  let r = segments(rel)!
  show(walk([], b + r))
}

fn resolve_all(base: String, rels: List[String]) -> List[String]! =
  rels |> list.map((r) => resolve(base, r)!)!
