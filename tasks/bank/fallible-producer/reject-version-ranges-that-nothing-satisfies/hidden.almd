test "hidden: a single version is a valid range, but not with an open end" {
  assert_eq(describe(">=1.4.1 <=1.4.1"), ok("[1.4.1, 1.4.1]"))
  assert_eq(describe(">=1.4.1 <1.4.1"), err("no version satisfies >=1.4.1 <1.4.1"))
  assert_eq(describe(">1.4.1 <=1.4.1"), err("no version satisfies >1.4.1 <=1.4.1"))
}
test "hidden: bounds compare numerically" {
  assert_eq(describe(">=1.10.0 <1.9.0"), err("no version satisfies >=1.10.0 <1.9.0"))
  assert_eq(describe(">=1.9.0 <1.10.0"), ok("[1.9.0, 1.10.0)"))
}
test "hidden: the tightest bounds decide, one-sided ranges are fine" {
  assert_eq(describe(">=1.0.0 <3.0.0 >2.5.0 <=2.5.0"), err("no version satisfies >=1.0.0 <3.0.0 >2.5.0 <=2.5.0"))
  assert_eq(describe("<2.0.0"), ok("(*, 2.0.0)"))
  assert_eq(describe(""), ok("(*, *)"))
}
test "hidden: constraint errors come first" {
  assert_eq(describe(">=2.0.0 <1.0.0 ~1.0.0"), err("bad constraint ~1.0.0"))
  assert_eq(describe(">=2.0.0 <1.0"), err("bad version 1.0"))
}
