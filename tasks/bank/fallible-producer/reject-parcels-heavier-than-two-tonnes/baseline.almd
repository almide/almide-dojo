// Shipping manifest. Each line is "<parcel> <amount><unit>" with unit mg, g,
// kg or t; weights are kept in milligrams.
type Parcel: Eq, Repr = { name: String, mg: Int }

let LIMIT_MG = 2000000000

fn unit_mg(u: String) -> Int? =
  match u {
    "mg" => some(1),
    "g" => some(1000),
    "kg" => some(1000000),
    "t" => some(1000000000),
    _ => none,
  }

fn split_amount(s: String) -> (Int, Int) = {
  let digits = string.chars(s) |> list.take_while((c) => string.is_digit(c)) |> list.len
  (digits, string.len(s))
}

fn parse_parcel(line: String) -> Parcel! = {
  let w = string.split(line, " ") |> list.filter((x) => x != "")
  guard list.len(w) == 2 else err("bad line: ${line}")
  let name = list.get(w, 0) ?? ""
  let q = list.get(w, 1) ?? ""
  let (k, n) = split_amount(q)
  guard k > 0 else err("missing amount for ${name}")
  let amount = int.parse(string.slice(q, 0, k)) |> result.map_err((_) => "bad amount for ${name}")!
  let unit = string.slice(q, k, n)
  let factor = match unit_mg(unit) {
    some(f) => ok(f),
    none => err("unknown unit ${unit} for ${name}"),
  }!
  guard amount > 0 else err("empty parcel ${name}")
  Parcel { name: name, mg: amount * factor }
}

fn fmt_kg(mg: Int) -> String = {
  let g = mg / 1000
  "${int.to_string(g / 1000)}.${string.pad_start(int.to_string(g % 1000), 3, "0")} kg"
}

fn manifest(lines: List[String]) -> String! = {
  let ps = lines |> list.map((l) => parse_parcel(l)!)!
  let total = ps |> list.fold(0, (a, p) => a + p.mg)
  "${int.to_string(list.len(ps))} parcels, ${fmt_kg(total)}"
}
