test "hidden: cells in the middle of a move count" {
  assert_eq(walk("F2 R F1 R F1 R F2"), err("path crosses itself at (0,1) on command 6"))
  assert_eq(summary("R F3 L F1 L F1 L F2"), err("path crosses itself at (2,0) on command 7"))
}
test "hidden: the start cell counts, and so does going straight back" {
  assert_eq(summary("F1 R F1 R F1 R F1"), err("path crosses itself at (0,0) on command 6"))
  assert_eq(walk("F3 R R F1"), err("path crosses itself at (0,2) on command 3"))
}
test "hidden: turning on the spot is fine and bad commands come first" {
  assert_eq(summary("R R R R F2 L L L F1"), ok("at (1,2) facing E, box (0,0)-(1,2)"))
  assert_eq(walk("F1 R R F1 X"), err("bad command X at 4"))
  assert_eq(walk("F1 R R F1 F0"), err("empty move at 4"))
}
