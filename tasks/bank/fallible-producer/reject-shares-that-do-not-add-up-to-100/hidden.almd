test "hidden: one-decimal shares that add up exactly are accepted" {
  assert_eq(allocate(100000, ["a 33.4", "b 33.3", "c 33.3"]), ok(["a: 33400", "b: 33299", "c: 33299"]))
  assert_eq(allocate(1000, ["x 0.1", "y 0.2", "z 99.7"]), ok(["x: 1", "y: 2", "z: 997"]))
}
test "hidden: the message shows the sum with one decimal" {
  assert_eq(allocate(1000, ["a 33.3", "b 33.3", "c 33.3"]), err("shares add up to 99.9%, not 100%"))
  assert_eq(allocate(1000, ["a 60.5", "b 40"]), err("shares add up to 100.5%, not 100%"))
}
test "hidden: line errors come first" {
  assert_eq(allocate(1000, ["a 10", "b 10.25"]), err("bad percent 10.25 for b"))
  assert_eq(allocate(1000, ["a 10", "a 90"]), err("duplicate team a"))
  assert_eq(allocate(1000, ["a 10", "b 0"]), err("bad percent 0 for b"))
}
test "hidden: a single team with everything" {
  assert_eq(allocate(999, ["all 100"]), ok(["all: 999"]))
}
