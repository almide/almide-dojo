test "hidden: exact position, also after a minus sign" {
  assert_eq(numbers("[1, 02]"), err("leading zero at 4"))
  assert_eq(numbers("[-007]"), err("leading zero at 2"))
}
test "hidden: a lone zero, fractions and exponents are fine" {
  assert_eq(numbers("[0, 0.5, -0, 0e3, -0.0, 1.05, 2e007, 100]"), ok(["0", "0.5", "-0", "0e3", "-0.0", "1.05", "2e007", "100"]))
}
test "hidden: reading order decides which problem wins" {
  assert_eq(numbers("[01., 2]"), err("leading zero at 1"))
  assert_eq(numbers("[1., 01]"), err("bad number at 1"))
  assert_eq(numbers("[5, 00 7]"), err("leading zero at 4"))
  assert_eq(numbers("[5 00]"), err("expected , or ] at 2"))
}
