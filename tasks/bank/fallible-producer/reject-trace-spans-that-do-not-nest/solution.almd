// Profiler trace. Each line is "<ms> begin <span>" or "<ms> end <span>";
// times never decrease. Every span that begins must end; the report gives each
// span's total time, spans in order of first begin.
type Open = { name: String, at: Int }
type Trace: Eq, Repr = { totals: List[String] }

fn step(open: List[Open], totals: Map[String, Int], order: List[String], line: String) -> (List[Open], Map[String, Int], List[String])! = {
  let w = string.split(line, " ") |> list.filter((x) => x != "")
  guard list.len(w) == 3 else err("bad line: ${line}")
  let t = int.parse(list.get(w, 0) ?? "") |> result.map_err((_) => "bad time in: ${line}")!
  let name = list.get(w, 2) ?? ""
  match list.get(w, 1) ?? "" {
    "begin" => {
      guard not list.any(open, (o) => o.name == name) else err("span ${name} already open")
      let ord = if list.contains(order, name) then order else order + [name]
      ok((open + [Open { name: name, at: t }], totals, ord))
    },
    "end" => {
      let o = match list.find(open, (o) => o.name == name) {
        some(o) => ok(o),
        none => err("end without begin: ${name}"),
      }!
      match list.last(open) {
        some(top) if top.name != name => err("end ${name} while ${top.name} is open inside it"),
        _ => ok(()),
      }!
      let rest = open |> list.filter((x) => x.name != name)
      ok((rest, map.set(totals, name, (map.get(totals, name) ?? 0) + t - o.at), order))
    },
    other => err("bad event ${other}"),
  }
}

fn profile(lines: List[String]) -> Trace! = {
  var open: List[Open] = []
  var totals: Map[String, Int] = [:]
  var order: List[String] = []
  for line in lines {
    let s = step(open, totals, order, line)!
    open = s.0
    totals = s.1
    order = s.2
  }
  guard list.is_empty(open) else err("unterminated span ${(list.first(open) ?? Open { name: "", at: 0 }).name}")
  Trace { totals: order |> list.map((n) => "${n}=${int.to_string(map.get(totals, n) ?? 0)}ms") }
}
