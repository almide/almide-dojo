// Plausible wrong patch: the helper strips the "%" with strip_suffix, whose
// `none` for a value without a sign makes "15" invalid.
fn pct(typed: String) -> Int? = {
  let digits = string.strip_suffix(string.trim(typed), "%")!
  let p = int.parse(string.trim(digits))?!
  guard p >= 0 and p <= 100 else none
  some(p)
}

fn apply_discount(cents: Int, typed: String) -> Int? = {
  let p = pct(typed)!
  some(cents - cents * p / 100)
}

fn valid_pct(typed: String) -> Bool = option.is_some(pct(typed))
