// Plausible wrong patch: the helper peels bits off the TOP of the mask, so
// the names come out highest bit first.
let NAMES = ["read", "write", "exec", "admin"]

fn names(mask: Int) -> List[String] =
  [3, 2, 1, 0] |> list.filter((b) => int.band(int.bshr(mask, b), 1) == 1) |> list.map((b) => list.get(NAMES, b) ?? "?")

fn describe(mask: Int) -> String = names(mask) |> list.join("+")

fn can(mask: Int, name: String) -> Bool = names(mask) |> list.contains(name)
