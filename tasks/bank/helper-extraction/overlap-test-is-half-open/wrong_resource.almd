// Plausible wrong patch: the helper sorts the two ranges before comparing.
// Same answers — but a two-element list is sorted on every call.
fn overlap(s1: Int, e1: Int, s2: Int, e2: Int) -> Bool = {
  let ordered = list.sort_by([(s1, e1), (s2, e2)], ((s, _)) => s)
  match ordered {
    [(_, ea), (sb, _)] => sb < ea and s1 < e1 and s2 < e2,
    _ => false,
  }
}

fn conflicts(a: (Int, Int), b: (Int, Int)) -> Bool = {
  let (s1, e1) = a
  let (s2, e2) = b
  overlap(s1, e1, s2, e2)
}

fn clashes_with(bookings: List[(Int, Int)], new_b: (Int, Int)) -> Int = {
  let (s2, e2) = new_b
  bookings |> list.count(((s1, e1)) => overlap(s1, e1, s2, e2))
}
