// Plausible wrong patch: the helper is written from the brackets' upper ages
// ("up to 13", "up to 18", "up to 65"), so every boundary age lands one
// bracket too low.
fn bracket(age: Int) -> Int = if age <= 13 then 0 else if age <= 18 then 1 else if age <= 65 then 2 else 3

fn price(age: Int) -> Int = match bracket(age) {
  0 => 500,
  1 => 800,
  2 => 1200,
  _ => 700,
}

fn label(age: Int) -> String = match bracket(age) {
  0 => "child",
  1 => "teen",
  2 => "adult",
  _ => "senior",
}
