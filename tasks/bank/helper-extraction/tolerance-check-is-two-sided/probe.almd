// Resource probe: the same 1,000 parts checked __K__ times. The inline test
// allocated nothing per part, so the count must not grow.
effect fn main() -> Unit = {
  let ms = list.range(0, 1000) |> list.map((i) => 95 + i % 11)
  let t = list.range(0, __K__) |> list.fold(0, (acc, _) => acc + batch_passes(ms, 100, 3))
  println(int.to_string(t))
}
