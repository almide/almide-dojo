// Plausible wrong patch: `within` becomes spread(xs) <= tolerance, and the
// helper's 0 for no readings makes an empty gauge "within tolerance".
fn spread(xs: List[Int]) -> Int =
  match list.min(xs) {
    some(lo) => (list.max(xs) ?? lo) - lo,
    none => 0,
  }

fn within(xs: List[Int], tolerance: Int) -> Bool = spread(xs) <= tolerance

fn summary(xs: List[Int]) -> String =
  match list.min(xs) {
    some(lo) => "min=" + int.to_string(lo) + ",max=" + int.to_string(list.max(xs) ?? lo) + ",spread=" + int.to_string(spread(xs)),
    none => "no data",
  }
