// Required-field lists written "a, b, c". An empty or all-space list names NO
// fields (not one empty field).
fn fields(spec: String) -> List[String] =
  if string.trim(spec) == "" then [] else string.split(spec, ",") |> list.map((k) => string.trim(k))

fn require(spec: String, field: String) -> Bool = list.contains(fields(spec), field)

fn count_required(spec: String) -> Int = list.len(fields(spec))
