// Plausible wrong patch: a `field` helper splits on ":" and reads one part.
// Same answers — but the time is split again for every part it reads.
fn field(t: String, k: Int) -> String = list.get(string.split(t, ":"), k) ?? ""

fn clock(t: String) -> Int? = {
  guard list.len(string.split(t, ":")) == 2 else none
  let h = int.parse(field(t, 0))?!
  let m_text = field(t, 1)
  guard string.len(m_text) == 2 else none
  let m = int.parse(m_text)?!
  guard h >= 0 and h < 24 and m >= 0 and m < 60 else none
  some(h * 60 + m)
}

fn duration(a: String, b: String) -> Int? = {
  let ma = clock(a)!
  let mb = clock(b)!
  some(mb - ma)
}

fn total(spans: List[(String, String)]) -> Int = spans |> list.fold(0, (acc, s) => {
  let (a, b) = s
  acc + (duration(a, b) ?? 0)
})
