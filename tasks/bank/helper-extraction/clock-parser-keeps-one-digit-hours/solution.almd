// Clock times "H:MM" or "HH:MM" (hours 0-23, minutes exactly two digits).
fn clock(t: String) -> Int? = {
  let i = string.index_of(t, ":")!
  let h = int.parse(string.slice(t, 0, i))?!
  let m_text = string.drop(t, i + 1)
  guard string.len(m_text) == 2 else none
  let m = int.parse(m_text)?!
  guard h >= 0 and h < 24 and m >= 0 and m < 60 else none
  some(h * 60 + m)
}

fn duration(a: String, b: String) -> Int? = {
  let ma = clock(a)!
  let mb = clock(b)!
  some(mb - ma)
}

fn total(spans: List[(String, String)]) -> Int = spans |> list.fold(0, (acc, s) => {
  let (a, b) = s
  acc + (duration(a, b) ?? 0)
})
