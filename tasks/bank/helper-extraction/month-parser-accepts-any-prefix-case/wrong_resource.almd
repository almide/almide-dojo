// Plausible wrong patch: the helper compares character lists ("the first n
// characters of the name"). Same answers — but every candidate month is
// split into characters on every call.
let MONTHS = ["january", "february", "march", "april", "may", "june", "july", "august", "september", "october", "november", "december"]

fn month_index(s: String) -> Int? = {
  let cs = string.chars(string.to_lower(s))
  guard list.len(cs) >= 3 else none
  MONTHS |> list.find_index((m) => list.take(string.chars(m), list.len(cs)) == cs)
}

fn month_number(s: String) -> Int? = month_index(s) |> option.map((i) => i + 1)

fn quarter(s: String) -> Int? = month_index(s) |> option.map((i) => i / 3 + 1)
