// Resource probe: the same 300 typed months looked up __K__ times. The helper
// must allocate no more per lookup than the inline code did.
effect fn main() -> Unit = {
  let typed = list.range(0, 300) |> list.map((i) => list.get(["Jan", "feb", "MAR", "april", "Dec"], i % 5) ?? "jan")
  let t = list.range(0, __K__) |> list.fold(0, (acc, _) => acc + (typed |> list.fold(0, (a, s) => a + (quarter(s) ?? 0))))
  println(int.to_string(t))
}
