// Plausible wrong patch: the extracted helper simplifies the rule to "has an
// @", which newly accepts "a@b@c", "@b" and "a@".
type User = { name: String, email: String, age: Int }

fn check_email(email: String) -> Result[String, String] =
  if string.contains(email, "@") then ok(email) else err("bad email: " + email)

fn validate(u: User) -> Result[User, String] = {
  guard u.name != "" else err("name is empty")
  check_email(u.email)!
  guard u.age >= 0 and u.age <= 150 else err("bad age: " + int.to_string(u.age))
  ok(u)
}

fn count_valid(users: List[User]) -> Int = users |> list.count((u) => result.is_ok(validate(u)))

fn first_problem(users: List[User]) -> String =
  users |> list.filter_map((u) => result.to_err_option(validate(u))) |> list.first ?? "all valid"
