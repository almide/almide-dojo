// Plausible wrong patch: the helper handles the long form only, so "#f80" is
// no longer a colour.
fn channel(hex: String) -> Int? = int.from_hex(hex)?

fn expand(c: String) -> String? =
  if string.len(c) == 7 and string.starts_with(c, "#") then some(string.drop(c, 1)) else none

fn red(c: String) -> Int? = expand(c) |> option.flat_map((h) => channel(string.slice(h, 0, 2)))

fn is_colour(c: String) -> Bool = expand(c) |> option.flat_map((h) => channel(h)) |> option.is_some
