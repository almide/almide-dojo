// Colours "#rrggbb" or the shorthand "#rgb" (each digit doubled: "#f80" is
// "#ff8800"), hex digits in any case.
fn channel(hex: String) -> Int? = int.from_hex(hex)?

fn red(c: String) -> Int? =
  if string.len(c) == 4 and string.starts_with(c, "#") then channel(string.repeat(string.slice(c, 1, 2), 2))
  else if string.len(c) == 7 and string.starts_with(c, "#") then channel(string.slice(c, 1, 3))
  else none

fn is_colour(c: String) -> Bool =
  if string.len(c) == 4 and string.starts_with(c, "#") then option.is_some(channel(string.drop(c, 1)))
  else if string.len(c) == 7 and string.starts_with(c, "#") then option.is_some(channel(string.drop(c, 1)))
  else false
