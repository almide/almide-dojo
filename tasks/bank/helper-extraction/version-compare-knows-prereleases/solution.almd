// Versions "MAJOR.MINOR.PATCH" with an optional pre-release "-tag"
// ("1.0.0-rc1"). A pre-release comes BEFORE the release with the same
// numbers; two pre-releases of the same numbers compare by tag text.
fn compare(a: String, b: String) -> Int = {
  let pa = string.split(a, "-")
  let pb = string.split(b, "-")
  let na = string.split(list.first(pa) ?? "", ".") |> list.map((x) => int.parse(x) ?? 0)
  let nb = string.split(list.first(pb) ?? "", ".") |> list.map((x) => int.parse(x) ?? 0)
  let ta = list.get(pa, 1) ?? ""
  let tb = list.get(pb, 1) ?? ""
  let first_diff = list.zip(na, nb) |> list.find(((x, y)) => x != y)
  match first_diff {
    some((x, y)) => if x > y then 1 else -1,
    none =>
      if list.len(na) != list.len(nb) then (if list.len(na) > list.len(nb) then 1 else -1)
      else if ta == tb then 0
      else if ta == "" then 1
      else if tb == "" then -1
      else if ta > tb then 1 else -1,
  }
}

fn newer(a: String, b: String) -> Bool = compare(a, b) == 1

fn latest(vs: List[String]) -> String = vs |> list.fold("", (best, v) => if best == "" or newer(v, best) then v else best)
