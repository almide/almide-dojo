test "hidden: pre-releases come first" {
  assert_eq(compare("1.0.0-rc1", "1.0.0"), -1)
  assert_eq(compare("1.0.0", "1.0.0-rc1"), 1)
  assert_eq(compare("1.0.0-rc2", "1.0.0-rc1"), 1)
  assert_eq(latest(["1.0.0-rc1", "1.0.0", "1.0.0-rc9"]), "1.0.0")
  assert_eq(newer("0.9.9", "1.0.0-alpha"), false)
}
