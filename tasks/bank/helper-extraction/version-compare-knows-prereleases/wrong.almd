// Plausible wrong patch: the helper compares the numbers only and ignores the
// "-tag", so a pre-release equals its release.
fn compare(a: String, b: String) -> Int = {
  let na = string.split(string.split(a, "-") |> list.first ?? "", ".") |> list.map((x) => int.parse(x) ?? 0)
  let nb = string.split(string.split(b, "-") |> list.first ?? "", ".") |> list.map((x) => int.parse(x) ?? 0)
  match list.zip(na, nb) |> list.find(((x, y)) => x != y) {
    some((x, y)) => if x > y then 1 else -1,
    none => if list.len(na) > list.len(nb) then 1 else if list.len(na) < list.len(nb) then -1 else 0,
  }
}

fn newer(a: String, b: String) -> Bool = compare(a, b) == 1

fn latest(vs: List[String]) -> String = vs |> list.fold("", (best, v) => if best == "" or newer(v, best) then v else best)
