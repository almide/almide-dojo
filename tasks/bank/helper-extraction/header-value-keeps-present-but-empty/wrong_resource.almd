// Plausible wrong patch: the helper indexes the headers into a map of
// lowercased names on every call (keeping the first of each name). Same
// answers — but a lookup now lowercases and stores EVERY header, where the
// inline search stopped at the first match.
fn same_name(a: String, b: String) -> Bool = string.to_lower(a) == string.to_lower(b)

fn header_value(hs: List[(String, String)], name: String) -> String = {
  let index = hs |> list.fold(map.new(), (m, h) => {
    let (n, v) = h
    let k = string.to_lower(n)
    if map.contains(m, k) then m else map.set(m, k, v)
  })
  map.get(index, string.to_lower(name)) ?? ""
}

fn get_header(hs: List[(String, String)], name: String) -> String? =
  hs |> list.find(((n, _)) => same_name(n, name)) |> option.map(((_, v)) => v)

fn has_header(hs: List[(String, String)], name: String) -> Bool =
  option.is_some(hs |> list.find(((n, _)) => same_name(n, name)))

fn content_length(hs: List[(String, String)]) -> Int = int.parse(header_value(hs, "content-length")) ?? 0
