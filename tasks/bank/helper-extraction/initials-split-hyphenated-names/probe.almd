// Resource probe: the same 300 names turned into avatars __K__ times. The
// helper must allocate no more per name than the inline code did.
effect fn main() -> Unit = {
  let names = list.range(0, 300) |> list.map((i) => "jean-luc picard the " + int.to_string(i))
  let t = list.range(0, __K__) |> list.fold(0, (acc, _) => acc + (names |> list.fold(0, (a, n) => a + string.len(avatar(n)))))
  println(int.to_string(t))
}
