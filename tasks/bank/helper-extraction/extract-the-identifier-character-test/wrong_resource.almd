// Plausible wrong patch: the helper checks membership in an alphabet list.
// Exactly the same characters pass — but the alphabet is split into a fresh
// list on every call, where the inline comparisons allocated nothing.
fn lower_or_underscore(c: String) -> Bool = c == "_" or (c >= "a" and c <= "z")

fn ident_continue(c: String) -> Bool =
  list.contains(string.chars("abcdefghijklmnopqrstuvwxyz0123456789_"), c)

fn lex(chars: List[String], i: Int, acc: List[String]) -> List[String] =
  match list.get(chars, i) {
    none => acc,
    some(c) =>
      if c == " " then lex(chars, i + 1, acc)
      else if lower_or_underscore(c) then {
        let run = list.drop(chars, i + 1) |> list.take_while((d) => ident_continue(d))
        lex(chars, i + 1 + list.len(run), acc + [c + list.join(run, "")])
      }
      else if c >= "0" and c <= "9" then {
        let run = list.drop(chars, i) |> list.take_while((d) => d >= "0" and d <= "9")
        lex(chars, i + list.len(run), acc + [list.join(run, "")])
      }
      else lex(chars, i + 1, acc + [c]),
  }

fn tokens(src: String) -> List[String] = lex(string.chars(src), 0, [])
