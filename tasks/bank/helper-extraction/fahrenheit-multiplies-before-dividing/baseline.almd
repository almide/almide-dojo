// Temperatures reported as "<n>C" or "<n>F". Fahrenheit is converted to whole
// Celsius as (F - 32) * 5 / 9 with integer division (toward zero) done LAST.
fn celsius_of(r: String) -> Int? =
  if string.ends_with(r, "C") then int.parse(string.drop_end(r, 1))?
  else if string.ends_with(r, "F") then int.parse(string.drop_end(r, 1))? |> option.map((f) => (f - 32) * 5 / 9)
  else none

fn freezing(r: String) -> Bool = (celsius_of(r) ?? 1) <= 0
