// Plausible wrong patch: the helper looks the conversion up through the text
// of the reading it rebuilds. Same numbers — but it formats and re-parses
// every value.
fn f_to_c(f: Int) -> Int = int.parse(int.to_string((f - 32) * 5 / 9)) ?? 0

fn celsius_of(r: String) -> Int? =
  if string.ends_with(r, "C") then int.parse(string.drop_end(r, 1))?
  else if string.ends_with(r, "F") then int.parse(string.drop_end(r, 1))? |> option.map((f) => f_to_c(f))
  else none

fn freezing(r: String) -> Bool = (celsius_of(r) ?? 1) <= 0
