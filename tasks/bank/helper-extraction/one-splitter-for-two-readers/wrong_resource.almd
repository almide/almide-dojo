// Plausible wrong patch: the helper splits the line on every "=" and joins the
// tail back. The same key and value — but it builds a list of parts and a
// re-joined value for every line, where the inline code sliced once.
fn split_kv(line: String) -> (String, String)? = {
  let parts = string.split(line, "=")
  match list.first(parts) {
    some(k) => if list.len(parts) < 2 then none else some((string.trim(k), list.join(list.drop(parts, 1), "="))),
    none => none,
  }
}

fn load_settings(lines: List[String]) -> Map[String, String] =
  lines |> list.fold(map.new(), (m, line) =>
    match split_kv(line) {
      some((k, v)) => map.set(m, string.to_lower(k), v),
      none => m,
    })

fn load_env(lines: List[String]) -> Map[String, String] =
  lines |> list.fold(map.new(), (m, line) =>
    match split_kv(line) {
      some((k, v)) => map.set(m, k, v),
      none => m,
    })
