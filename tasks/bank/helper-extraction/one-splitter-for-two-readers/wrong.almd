// Plausible wrong patch: the shared helper lowercases the key (as the
// settings reader did), so environment keys lose their case too.
fn split_kv(line: String) -> (String, String)? =
  match string.index_of(line, "=") {
    some(i) => some((string.to_lower(string.trim(string.slice(line, 0, i))), string.drop(line, i + 1))),
    none => none,
  }

fn load_settings(lines: List[String]) -> Map[String, String] =
  lines |> list.fold(map.new(), (m, line) =>
    match split_kv(line) {
      some((k, v)) => map.set(m, k, v),
      none => m,
    })

fn load_env(lines: List[String]) -> Map[String, String] =
  lines |> list.fold(map.new(), (m, line) =>
    match split_kv(line) {
      some((k, v)) => map.set(m, k, v),
      none => m,
    })
