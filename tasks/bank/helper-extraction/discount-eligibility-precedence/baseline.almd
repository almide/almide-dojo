// Checkout discounts. A customer gets the discount when they are an adult
// member — OR when they bring a coupon, whatever their age or membership.
type Customer = { age: Int, member: Bool, coupon: Bool }

fn price(c: Customer, cents: Int) -> Int =
  if c.age >= 18 and c.member or c.coupon then cents * 90 / 100 else cents

fn basket_total(c: Customer, items: List[Int]) -> Int = items |> list.fold(0, (a, x) => a + price(c, x))
