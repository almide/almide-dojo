// Plausible wrong patch: the helper lowercases character by character. Same
// answers — but it allocates a character list and a string per character.
fn lower(s: String) -> String = string.chars(s) |> list.map((c) => string.to_lower(c)) |> list.join("")

fn contains_ci(hay: String, needle: String) -> Bool = string.contains(lower(hay), lower(needle))

fn search(titles: List[String], query: String) -> List[String] = titles |> list.filter((t) => contains_ci(t, query))

fn count_matches(titles: List[String], query: String) -> Int = titles |> list.count((t) => contains_ci(t, query))
