// A title search that ignores case on BOTH sides: the query "RUST" finds
// "Learning rust".
fn contains_ci(hay: String, needle: String) -> Bool = string.contains(string.to_lower(hay), string.to_lower(needle))

fn search(titles: List[String], query: String) -> List[String] = titles |> list.filter((t) => contains_ci(t, query))

fn count_matches(titles: List[String], query: String) -> Int = titles |> list.count((t) => contains_ci(t, query))
