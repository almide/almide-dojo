// A title search that ignores case on BOTH sides: the query "RUST" finds
// "Learning rust".
fn search(titles: List[String], query: String) -> List[String] =
  titles |> list.filter((t) => string.contains(string.to_lower(t), string.to_lower(query)))

fn count_matches(titles: List[String], query: String) -> Int =
  titles |> list.count((t) => string.contains(string.to_lower(t), string.to_lower(query)))
