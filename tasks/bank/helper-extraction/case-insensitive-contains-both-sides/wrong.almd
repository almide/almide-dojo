// Plausible wrong patch: the helper lowercases the title but not the query,
// so an uppercase query never matches.
fn contains_ci(hay: String, needle: String) -> Bool = string.contains(string.to_lower(hay), needle)

fn search(titles: List[String], query: String) -> List[String] = titles |> list.filter((t) => contains_ci(t, query))

fn count_matches(titles: List[String], query: String) -> Int = titles |> list.count((t) => contains_ci(t, query))
