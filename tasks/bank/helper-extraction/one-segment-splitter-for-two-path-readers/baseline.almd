// Slash-separated paths. Empty segments ("a//b", a leading or trailing "/")
// never count. `depth` also ignores "." segments; `basename` does NOT: the
// basename of "a/." is ".".
fn depth(p: String) -> Int =
  string.split(p, "/") |> list.filter((s) => s != "" and s != ".") |> list.len

fn basename(p: String) -> String =
  string.split(p, "/") |> list.filter((s) => s != "") |> list.last ?? ""
