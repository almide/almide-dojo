// Plausible wrong patch: the helper was written from the start branch and
// keeps its message, so a bad END is reported as "bad start".
fn parse_bound(text: String, which: String) -> Result[Int, String] =
  int.parse(text) |> result.map_err((_) => "bad start: " + text)

fn parse_range(s: String) -> Result[(Int, Int), String] =
  match string.index_of(s, "..") {
    none => err("missing '..' in " + s),
    some(i) => {
      let lo = parse_bound(string.slice(s, 0, i), "start")!
      let hi = parse_bound(string.drop(s, i + 2), "end")!
      if lo <= hi then ok((lo, hi)) else err("empty range: " + s)
    },
  }

fn range_len(s: String) -> Result[Int, String] = {
  let (lo, hi) = parse_range(s)!
  ok(hi - lo + 1)
}
