// Luhn check digits. Counting from the RIGHTMOST digit (position 1), every
// digit in an even position is doubled (minus 9 when above 9); the number is
// valid when the sum is a multiple of 10. Spaces are ignored.
fn digits(s: String) -> List[Int] = string.chars(s) |> list.filter((c) => c != " ") |> list.map((c) => int.parse(c) ?? 0)

fn luhn_sum(s: String) -> Int =
  list.reverse(digits(s)) |> list.enumerate |> list.fold(0, (a, p) => {
    let (i, d) = p
    if i % 2 == 1 then a + (if d * 2 > 9 then d * 2 - 9 else d * 2) else a + d
  })

fn valid(s: String) -> Bool = luhn_sum(s) % 10 == 0

fn check_digit(partial: String) -> Int = (10 - luhn_sum(partial + "0") % 10) % 10
