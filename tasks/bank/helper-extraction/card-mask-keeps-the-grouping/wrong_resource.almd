// Plausible wrong patch: the helper asks, for each character, how many digits
// come after it by slicing every later character out of the card. Same text —
// but a fresh one-character string per (character, later character) pair.
fn mask(card: String) -> String = {
  let n = string.len(card)
  string.to_list(card) |> list.enumerate |> list.map(((i, c)) => {
    let after = list.range(i + 1, n) |> list.count((j) => string.slice(card, j, j + 1) != " ")
    if c == " " or after < 4 then c else "*"
  }) |> list.join("")
}

fn receipt_line(card: String) -> String = "card " + mask(card)

fn last4(card: String) -> String = string.to_list(card) |> list.filter((c) => c != " ") |> list.take_end(4) |> list.join("")
