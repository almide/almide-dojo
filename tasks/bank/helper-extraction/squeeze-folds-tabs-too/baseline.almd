// Cleaning user text: every run of spaces AND tabs becomes one space, and
// the ends are trimmed.
fn clean_title(s: String) -> String =
  string.split(string.replace(s, "\t", " "), " ") |> list.filter((w) => w != "") |> list.join(" ")

fn clean_tag(s: String) -> String =
  string.to_lower(string.split(string.replace(s, "\t", " "), " ") |> list.filter((w) => w != "") |> list.join("-"))
