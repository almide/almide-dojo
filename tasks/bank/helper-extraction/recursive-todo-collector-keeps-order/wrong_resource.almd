// Plausible wrong patch: walks the lines by head/tail pattern and ignores the
// index after the first call. Same TODOs in the same order — but binding the
// tail copies the remaining lines on every step.
fn todo_text(line: String) -> String? =
  string.index_of(line, "TODO:") |> option.map((i) => string.trim(string.drop(line, i + 5)))

fn walk(lines: List[String], acc: List[String]) -> List[String] =
  match lines {
    [] => acc,
    [l, ..rest] => match todo_text(l) {
      some(t) => walk(rest, acc + [t]),
      none => walk(rest, acc),
    },
  }

fn collect(lines: List[String], i: Int, acc: List[String]) -> List[String] = walk(list.drop(lines, i), acc)

fn todos(lines: List[String]) -> List[String] = collect(lines, 0, [])

fn todo_report(lines: List[String]) -> String = {
  let ts = todos(lines)
  int.to_string(list.len(ts)) + " todo(s)" + (if list.is_empty(ts) then "" else ": " + list.join(ts, "; "))
}
