// Fixed-width inventory records: columns 0-3 code, 4-7 quantity, 8-19 name.
// Every field is trimmed; a quantity that does not parse counts as 0. Short
// lines simply have empty trailing fields.
type Record = { code: String, qty: Int, name: String }

fn parse_record(line: String) -> Record =
  Record {
    code: string.trim(string.slice(line, 0, 4)),
    qty: int.parse(string.trim(string.slice(line, 4, 8))) ?? 0,
    name: string.trim(string.slice(line, 8, 20)),
  }

fn total_qty(lines: List[String]) -> Int = lines |> list.fold(0, (a, l) => a + parse_record(l).qty)
