test "hidden: century leap rule" {
  assert_eq(days_between("1900-02-28", "1900-03-01"), some(1))
  assert_eq(days_between("2000-02-28", "2000-03-01"), some(2))
  assert_eq(days_between("2100-01-01", "2100-12-31"), some(364))
}
test "hidden: helper agrees with days_between" {
  let a = day_number("1999-12-31") ?? 0
  let b = day_number("2000-01-01") ?? 0
  assert_eq(b - a, 1)
  assert_eq(days_between("2024-03-01", "2024-01-01"), some(-60))
  assert_eq(days_between("2024-03-01", "bad"), none)
}
