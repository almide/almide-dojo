// Plausible wrong patch: the helper only checks for the separator, so fields
// with quotes or newlines are written raw and break the file.
fn escape(field: String) -> String =
  if string.contains(field, ",") then "\"" + string.replace(field, "\"", "\"\"") + "\"" else field

fn to_line(fields: List[String]) -> String = fields |> list.map((f) => escape(f)) |> list.join(",")

fn to_csv(rows: List[List[String]]) -> String = rows |> list.map((r) => to_line(r)) |> list.join("\n")
