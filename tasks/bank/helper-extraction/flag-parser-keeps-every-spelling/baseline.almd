// Boolean settings as typed: "true", "yes", "on", "1" mean true and "false",
// "no", "off", "0" mean false, in any case. Anything else is not a boolean.
fn enabled(value: String, default: Bool) -> Bool =
  match string.to_lower(value) {
    "true" | "yes" | "on" | "1" => true,
    "false" | "no" | "off" | "0" => false,
    _ => default,
  }

fn is_bool(value: String) -> Bool =
  match string.to_lower(value) {
    "true" | "yes" | "on" | "1" | "false" | "no" | "off" | "0" => true,
    _ => false,
  }
