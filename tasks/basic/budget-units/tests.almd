test "budget admits small work" {
  let r = run_with_budget(50, 0, 100)
  assert_eq(r, ok(4950))
}
test "microseconds alone admit tiny work" {
  let r = run_with_budget(0, 500, 10)
  assert_eq(r, ok(45))
}
test "zero budget still admits constant work" {
  let r = run_with_budget(0, 1, 0)
  assert_eq(r, ok(0))
}
