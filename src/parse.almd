// Parsers for per-task markdown reports written by render_report.
// Used by the backfill subcommand to reconstruct RunResults from the
// historical run files on disk.

import self.types.{RunResult, Attempt}
import self.cellstate

fn parse_field_from_lines(lines: List[String], prefix: String) -> String =
  lines
    |> list.find((line) => string.contains(line, prefix))
    |> option.map((line) => {
      let after = string.drop(line, string.index_of(line, prefix) |> option.unwrap_or(0) + string.len(prefix))
      string.trim(after) |> string.replace("`", "")
    })
    |> option.unwrap_or("")

fn parse_int_from_lines(lines: List[String], prefix: String) -> Int = {
  let raw = parse_field_from_lines(lines, prefix)
  let num = if string.contains(raw, "/") then
    string.trim(string.take(raw, string.index_of(raw, "/") |> option.unwrap_or(0)))
  else if string.contains(raw, " ") then
    string.trim(string.take(raw, string.index_of(raw, " ") |> option.unwrap_or(0)))
  else raw
  match int.parse(num) { ok(n) => n, err(_) => 0 }
}

fn first_fenced_block(s: String) -> String =
  match string.index_of(s, "```") {
    none => ""
    some(i) => {
      let after_open = string.drop(s, i + 3)
      let body_start = match string.index_of(after_open, "\n") {
        some(j) => string.drop(after_open, j + 1)
        none => after_open
      }
      match string.index_of(body_start, "```") {
        none => string.trim(body_start)
        some(k) => string.trim(string.take(body_start, k))
      }
    }
  }

// Pull every per-attempt diagnostic from the report, in order.
// Each "**Diagnostic:**" marker is followed by a fenced block with the
// compiler/runtime output for that attempt.
fn extract_all_diagnostics(content: String) -> List[String] = {
  let parts = string.split(content, "**Diagnostic:**")
  if list.len(parts) <= 1 then []
  else
    list.drop(parts, 1)
      |> list.map(first_fenced_block)
      |> list.filter((s) => s != "")
}

fn extract_final_diagnostic(content: String) -> String = {
  let diags = extract_all_diagnostics(content)
  if not list.is_empty(diags) then
    list.get(diags, list.len(diags) - 1) |> option.unwrap_or("")
  else
    // Legacy format: single "## Final diagnostic" section.
    match string.index_of(content, "## Final diagnostic") {
      none => ""
      some(i) => first_fenced_block(string.drop(content, i))
    }
}

fn task_name_from_filename(filename: String) -> String =
  if string.ends_with(filename, ".md") then
    string.take(filename, string.len(filename) - 3)
  else filename

fn parse_task_md(filename: String, content: String) -> RunResult = {
  let lines = string.split(content, "\n")
  let success_str = parse_field_from_lines(lines, "**success**: ")
  let retries = parse_int_from_lines(lines, "**retries**: ")
  let model = parse_field_from_lines(lines, "**model**: ")
  let success = success_str == "yes"
  let all_diags = extract_all_diagnostics(content)
  let final_diag = if success then "" else extract_final_diagnostic(content)
  // The cell state the report stamped. A report written before the states
  // existed has no line, and it exists BECAUSE the model answered — the old
  // harness wrote no per-task report at all for a cell it never reached — so
  // the absence of the field reads as `measured`, which is what it was.
  let state = parse_field_from_lines(lines, "**state**: ")
  let reached = state != cellstate.ST_NOT_RUN and state != cellstate.ST_HARNESS
  // Reconstruct Attempt list: one Attempt per diagnostic block (passed=false,
  // since passing attempts don't emit a diagnostic). Code is empty in
  // backfill — we only kept diagnostics for the recoverable/unrecoverable
  // analysis.
  let attempts = all_diags
    |> list.map((d) => Attempt { code: "", diagnostic: d, passed: false })
  RunResult {
    task: task_name_from_filename(filename),
    model: model,
    success: success and reached,
    retries: retries,
    final_diagnostic: final_diag,
    final_code: "",
    attempts: attempts,
    reached: reached,
    measurable: state != cellstate.ST_HARNESS,
    reason: parse_field_from_lines(lines, "**reason**: "),
  }
}

test "a backfilled report keeps a never-asked task typed, and a legacy report measured" {
  // A report the new harness writes for a cell the model never answered.
  let absent = parse_task_md("matrix-ops.md",
    "# matrix-ops\n\n- **model**: `cf:m`\n- **state**: `not-run`\n" +
    "- **reason**: call_model: cloudflare: http: read timed out waiting for the server\n" +
    "- **category**: not-run\n")
  assert(not absent.reached)
  assert(not absent.success)
  assert(string.contains(absent.reason, "read timed out"))
  // A report from before the states existed: it exists because the model
  // answered, and a 1-shot pass has no diagnostic block at all — deriving
  // "never asked" from an empty attempt list would retype every one of them.
  let legacy = parse_task_md("fizzbuzz.md",
    "# fizzbuzz\n\n- **model**: `cf:m`\n- **success**: yes\n- **retries**: 0\n- **category**: pass-1shot\n")
  assert(legacy.reached)
  assert(legacy.success)
  assert(list.is_empty(legacy.attempts))
}
