// l1_loop — the edit-locality Stage 4 prediction join (dogfood: Almide).
//
// Reads the L1 verdict ledger from almide/almide (proofs/l1-verdicts.toml,
// flat TOML) and this repo's daily runs (runs/<date>/summary.md headline
// numbers), joins them by landing date, and reports each prediction's
// standing: the mean MSR-with-retry before vs after the landing, the
// measured direction, and whether it confirms or refutes the theory's
// committed prediction. Insufficient post-landing data reports as
// "awaiting" — never silently as confirmation.
//
// Usage: almide run src/l1_loop.almd -- [ledger-path] [runs-dir]
//        (defaults: ../almide/proofs/l1-verdicts.toml, runs)
// Writes dashboards/l1-loop.md and prints the same report.
import fs
import args
import regex

type Verdict = { id: String, change: String, landed: String, prediction: String, measured: String }

/// One scored run. `model` and `total` are carried because a verdict may
/// only be scored against runs of the SAME model on the SAME task bank —
/// see `comparable_rows`. Averaging across models makes a model upgrade
/// read as a compiler win, which is the one answer this loop must never
/// produce.
type RunPoint = { date: String, model: String, total: Int, with_retry: Int }

// `regex.captures` returns [whole match, group 1, ...] — group N is at index
// N. This tool was first written against almide#1432, when the runtime
// returned groups only, and read group 1 from index 0; the upstream fix
// silently turned every capture here into the un-stripped whole match, which
// is why the ledger's dates arrived quote-wrapped and no run ever sorted
// before a landing date.
fn quoted(line: String) -> String =
  match regex.captures("\"([^\"]*)\"", line) {
    some(gs) => list.get(gs, 1) ?? "",
    none => "",
  }

effect fn parse_ledger(path: String) -> List[Verdict] = {
  let text = fs.read_text(path)!
  var cur_id = ""
  var cur_change = ""
  var cur_landed = ""
  var cur_pred = ""
  var out: List[Verdict] = []
  for line in string.split(text, "\n") {
    let t = string.trim(line)
    if string.starts_with(t, "id ") then { cur_id = quoted(t) } else {}
    if string.starts_with(t, "change ") then { cur_change = quoted(t) } else {}
    if string.starts_with(t, "landed ") then { cur_landed = quoted(t) } else {}
    if string.starts_with(t, "msr_prediction ") then { cur_pred = quoted(t) } else {}
    if string.starts_with(t, "msr_measured ") then {
      out = out + [Verdict {
        id: cur_id,
        change: cur_change,
        landed: cur_landed,
        prediction: cur_pred,
        measured: quoted(t),
      }]
    } else {}
  }
  out
}

fn field(pattern: String, text: String) -> Option[String] =
  match regex.captures(pattern, text) {
    some(gs) => list.get(gs, 1),
    none => none,
  }

/// One machine-generated summary as a scorable point.
///
/// ONLY the harness-emitted shape is accepted (`- **model**:` /
/// `- **tasks**:` / `- **passed**: N / M`). The hand-written round-up
/// summaries carry a prose `MSR-with-retry N%` headline but name no model
/// and no bank size, so they are not comparable to anything and are
/// deliberately skipped rather than averaged in.
fn summary_point(date: String, text: String) -> Option[RunPoint] = {
  let model = field("model\\*\\*: `([^`]+)`", text) ?? ""
  let total = int.parse(field("tasks\\*\\*: ([0-9]+)", text) ?? "") ?? 0
  let passed = int.parse(field("passed\\*\\*: ([0-9]+) /", text) ?? "") ?? -1
  if model == "" or total <= 0 or passed < 0 then none
  else
    some(RunPoint {
      date: date,
      model: model,
      total: total,
      with_retry: (passed * 100) / total,
    })
}

/// Every summary under one date: the flat `runs/<date>/summary.md` of the
/// hand-written rounds, plus `runs/<date>/<model>/summary.md` for every
/// model the harness ran that day.
effect fn date_summaries(dir: String, d: String) -> List[String] = {
  let flat = match fs.read_text("${dir}/${d}/summary.md") {
    ok(t) => [t],
    err(_e) => [],
  }
  let nested = match fs.list_dir("${dir}/${d}") {
    ok(entries) =>
      entries
        |> list.filter_map((m) => fs.read_text("${dir}/${d}/${m}/summary.md")?),
    err(_e) => [],
  }
  flat + nested
}

effect fn scan_runs(dir: String) -> List[RunPoint] = {
  let dates = fs.list_dir(dir)!
  var out: List[RunPoint] = []
  for d in dates {
    let texts = date_summaries(dir, d)!
    // One point PER MODEL, never averaged across them.
    let pts = texts |> list.filter_map((t) => summary_point(d, t))
    match list.len(pts) {
      0 => println("l1-loop: ${d}: no scorable summary — skipped"),
      _ => { out = out + pts },
    }
  }
  out
}

fn mean_pct(points: List[RunPoint]) -> Int =
  match list.len(points) {
    0 => -1,
    n => (points |> list.map((p) => p.with_retry) |> list.sum) / n,
  }

fn direction(before: Int, after: Int) -> String =
  if after > before + 2 then "up"
  else if before > after + 2 then "down"
  else "flat"

fn standing(v: Verdict, before: Int, after: Int) -> String = {
  let dir = direction(before, after)
  match dir == v.prediction {
    true => "CONFIRMED (${dir})",
    false => match dir {
      "flat" => "inconclusive (flat)",
      _ => "REFUTED (predicted ${v.prediction}, measured ${dir})",
    },
  }
}

/// The strata that can actually score a landing: one (model, bank size)
/// pair that has at least one run on each side of the landing date. A
/// pair present on only one side proves nothing — the difference would be
/// the model or the bank, not the compiler.
fn comparable_strata(v: Verdict, points: List[RunPoint]) -> List[(String, Int, Int)] = {
  let keys =
    points
      |> list.map((p) => "${p.model}@${p.total}")
      |> list.unique
  keys |> list.filter_map((k) => {
    let same = points |> list.filter((p) => "${p.model}@${p.total}" == k)
    let b = same |> list.filter((p) => p.date < v.landed) |> mean_pct
    let a = same |> list.filter((p) => p.date >= v.landed) |> mean_pct
    if b < 0 or a < 0 then none else some((k, b, a))
  })
}

fn row(v: Verdict, points: List[RunPoint]) -> String = {
  let strata = comparable_strata(v, points)
  match strata {
    [] =>
      "| ${v.id} | ${v.change} | ${v.landed} | ${v.prediction} | — | — | awaiting comparable runs (same model + same task bank on both sides) |",
    _ => {
      let cells =
        strata
          |> list.map(((k, b, a)) => "${k}: ${b}%→${a}% ${standing(v, b, a)}")
          |> list.join("; ")
      "| ${v.id} | ${v.change} | ${v.landed} | ${v.prediction} | ${cells} |"
    },
  }
}

effect fn main() -> Unit = {
  let ledger = args.positional_at(0) ?? "../almide/proofs/l1-verdicts.toml"
  let runs_dir = args.positional_at(1) ?? "runs"
  let verdicts = parse_ledger(ledger)!
  let points = scan_runs(runs_dir)!
  let header = [
    "# L1 prediction loop — verdicts vs measured MSR",
    "",
    "${list.len(verdicts)} verdict(s), ${list.len(points)} scored run(s).",
    "Mean MSR-with-retry across runs before/after each landing date;",
    "a prediction only counts as confirmed/refuted once post-landing runs exist.",
    "",
    "| id | change | landed | predicted | before | after | standing |",
    "|---|---|---|---|---|---|---|",
  ]
  let rows = verdicts |> list.map((v) => row(v, points))
  let report = (header + rows) |> list.join("\n")
  println(report)
  fs.write("dashboards/l1-loop.md", report + "\n")!
}
