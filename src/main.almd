// dojo — Almide Dojo harness
//
// Multi-provider LLM harness for MSR measurement.
// Supports Cloudflare Workers AI, Anthropic, OpenRouter, OpenAI, and the
// Claude Code CLI (all through almai; see src/llm.almd).
//
// Usage:
//   almide run src/main.almd -- <task-name> [provider:model]
//   almide run src/main.almd -- all [provider:model]
//
// Model formats:
//   cf:@cf/meta/llama-3.3-70b-instruct-fp8-fast    Cloudflare Workers AI
//   anthropic:claude-sonnet-5                        Anthropic Messages API
//   claude-sonnet-5                                  Anthropic Messages API (an unprefixed claude-* is the API, not the CLI)
//   openrouter:meta-llama/llama-3.3-70b-instruct    OpenRouter (100+ models)
//   openai:<model>                                  OpenAI API
//   cli:claude                                      Claude Code CLI (`claude -p`; no API key, the CLI's own model and sampling)
//
// Environment variables (per provider):
//   CF_ACCOUNT_ID, CLOUDFLARE_API_KEY, CLOUDFLARE_EMAIL   Cloudflare Workers AI (Global API Key auth)
//   ANTHROPIC_API_KEY                                     Anthropic Messages API
//   OPENROUTER_API_KEY                                    OpenRouter
//   OPENAI_API_KEY                                        OpenAI
//   (none)                                                cli:claude — needs a logged-in `claude` on PATH

import env
import fs
import json
import process
import datetime
import self.types.{Task, Attempt, RunResult, AttemptResult}
import self.cellstate
import self.classifier
import self.hints
import self.render
import self.backfill
import self.llm
import self.prompts
import self.survive_ab

// ── Constants ──

let DEFAULT_MODEL = "claude-sonnet-4-6"
let DEFAULT_MAX_RETRIES = 3

// ── Types ──

// ── Task loading ──

let DIFFICULTIES = ["basic", "intermediate", "advanced"]

effect fn load_task(name: String) -> Result[Task, String] =
  match load_task_search(name, DIFFICULTIES) {
    ok(t) => ok(t)
    err(_) => load_bank_task(name)
  }

// ── The contract-preserving bank (tasks/bank/<family>/<name>/) ──
//
// A bank task is a MODIFICATION of an already-correct program: the model gets
// prompt.md (the requested edit + the Preserve contract) and baseline.almd,
// and is scored against tests.almd (visible) AND hidden.almd (never shown),
// on both targets. scripts/check-bank.sh keeps every task discriminating.

let BANK_DIR = "tasks/bank"

effect fn bank_families() -> List[String] =
  match fs.list_dir(BANK_DIR) {
    err(_) => []
    ok(entries) => filter_dotfiles(entries) |> list.sort
  }

effect fn load_bank_task(name: String) -> Result[Task, String] =
  load_bank_task_search(name, bank_families()!)

effect fn load_bank_task_search(name: String, families: List[String]) -> Result[Task, String] =
  if list.is_empty(families) then
    err("task not found: " + name)
  else {
    let family = list.get(families, 0) |> option.unwrap_or("")
    let dir = BANK_DIR + "/" + family + "/" + name
    match fs.read_text(dir + "/prompt.md") {
      err(_) => load_bank_task_search(name, list.drop(families, 1))
      ok(prompt) => {
        let baseline = fs.read_text(dir + "/baseline.almd")!
        let tests = fs.read_text(dir + "/tests.almd")!
        let hidden = fs.read_text(dir + "/hidden.almd")!
        ok(Task {
          name: name,
          prompt: prompt + "\n\n## Current program\n\n" + baseline,
          tests: tests, dir: dir,
          kind: "modify", baseline: baseline, hidden: hidden,
        })
      }
    }
  }

// Every bank task name, across families (names are unique bank-wide).
effect fn list_bank_tasks() -> Result[List[String], String] = {
  let names = bank_families()!
    |> list.flat_map((family) => match fs.list_dir(BANK_DIR + "/" + family) {
      err(_) => [],
      ok(entries) => filter_dotfiles(entries),
    })
    |> list.sort
  if list.is_empty(names) then err("no bank tasks found under " + BANK_DIR)
  else ok(names)
}

// The two bank verdicts that are NOT compile/test failures. They are marker
// lines in the diagnostic so the classifier and the summary can count them
// without a new record field; the hidden oracle's detail is never leaked.
let SILENT_VIOLATION = "[bank] silent-violation: the visible tests pass but the hidden oracle rejected the change — an untouched behaviour listed under Preserve changed. No further detail is given; re-read the Preserve section."
let RESOURCE_VIOLATION = "[bank] resource-violation: behaviour is unchanged but the program keeps or allocates more than the requested edit needs — a resource listed under Preserve changed. No further detail is given; re-read the Preserve section."
let TARGET_DIVERGENCE = "[bank] target-divergence: native and --target wasm disagree on this program. A compiler finding, not a repair target: the attempt is scored as failed and not retried."

effect fn load_task_search(name: String, levels: List[String]) -> Result[Task, String] =
  if list.is_empty(levels) then
    err("task not found: " + name)
  else {
    let level = list.get(levels, 0) |> option.unwrap_or("")
    let dir = "tasks/" + level + "/" + name
    match fs.read_text(dir + "/prompt.md") {
      err(_) => load_task_search(name, list.drop(levels, 1))
      ok(prompt) => match fs.read_text(dir + "/tests.almd") {
        err(_) => load_task_search(name, list.drop(levels, 1))
        ok(tests) => ok(Task { name: name, prompt: prompt, tests: tests, dir: dir, kind: "write", baseline: "", hidden: "" })
      }
    }
  }

// ── Model call (via llm module) ──
//
// One attempt per call (no transport retry) and almai's default temperature
// 0.0: the daily lane's call exactly as it was before the shared module.

effect fn call_model(model: String, user_prompt: String) -> Result[String, String] =
  llm.call(model, prompts.SYSTEM_PROMPT, user_prompt, 0.0, 1)

// ── Compile + test ──
//
// `process.exec` returns Err on non-zero exit (stderr is the error string).
// So a non-zero `almide test` run shows up as an Err with the diagnostic,
// which we translate into a successful `AttemptResult { success: false }`.

effect fn compile_and_test(task: Task, solution: String, attempt: Int) -> Result[AttemptResult, String] = {
  let tmp = env.temp_dir() + "/dojo-" + task.name + "-" + int.to_string(attempt) + ".almd"
  let combined = solution + "\n\n" + task.tests
  match fs.write(tmp, combined) {
    err(_) => err("failed to write temp file: " + tmp)
    ok(_) => {
      // Best-effort auto-fix before test: adds missing imports, rewrites let-in,
      // maps int.gt → a > b etc. `solution` kept as the original LLM text for
      // the per-task report.
      match process.exec("almide", ["fix", tmp]) {
        ok(_) => {}
        err(_) => {}
      }
      match process.exec("almide", ["test", tmp]) {
        ok(_) => if task.kind == "modify" then bank_oracles(task, tmp, solution)
          else ok(AttemptResult { success: true, code: solution, diagnostic: "" })
        err(diag) => ok(AttemptResult { success: false, code: solution, diagnostic: diag })
      }
    }
  }
}

// The bank's two extra legs, run only once the visible suite is green:
//   hidden oracle (native)  → fail = silent violation (marker, no detail)
//   the same file on wasm   → fail = target divergence (marker, not retried)
// `tmp` already holds the `almide fix`-ed program + visible tests, so the
// hidden suite is appended to THAT text — the model's program is judged as fixed.
effect fn bank_oracles(task: Task, tmp: String, solution: String) -> Result[AttemptResult, String] = {
  let all = tmp + ".all.almd"
  let fixed = fs.read_text(tmp)!
  match fs.write(all, fixed + "\n\n" + task.hidden) {
    err(_) => err("failed to write temp file: " + all)
    ok(_) => match process.exec("almide", ["test", all]) {
      err(_) => ok(AttemptResult { success: false, code: solution, diagnostic: SILENT_VIOLATION })
      ok(_) => match process.exec("almide", ["test", all, "--target", "wasm"]) {
        err(_) => ok(AttemptResult { success: false, code: solution, diagnostic: TARGET_DIVERGENCE })
        ok(_) => if bank_task_needs_resource(task.dir)! then resource_oracle(task, all, solution)
          else ok(AttemptResult { success: true, code: solution, diagnostic: "" })
      }
    }
  }
}

// The third oracle (almide-dojo#5): for a task whose meta says
// `resource_oracle = "active"`, scripts/resource-oracle.sh runs the task's
// probe over the model's program and over the reference solution at two
// scales on both targets, and bounds the program's growth by the reference's.
// A violation is a model outcome (marker, retried like a silent violation). A
// probe that cannot run on the REFERENCE, or a compiler without the counters,
// is the harness's problem and never a score: it surfaces as an error, which
// the cell records as `not-run` with the script's words.
effect fn bank_task_needs_resource(dir: String) -> Bool =
  match fs.read_text(dir + "/meta.toml") {
    err(_) => false
    ok(m) => string.contains(m, "resource_oracle = \"active\"")
  }

effect fn resource_oracle(task: Task, program: String, solution: String) -> Result[AttemptResult, String] =
  match process.exec("bash", ["scripts/resource-oracle.sh", task.dir, program]) {
    ok(_) => ok(AttemptResult { success: true, code: solution, diagnostic: "" })
    err(e) =>
      if string.contains(e, "__RESOURCE_VERDICT violation") or string.contains(e, "__RESOURCE_FAILED_ON candidate") then
        ok(AttemptResult { success: false, code: solution, diagnostic: RESOURCE_VIOLATION })
      else err("resource oracle could not judge " + task.name + ": " + string.trim(e))
  }

// ── The survive arm (almide/almide#2147, src/survive_ab.almd) ──
//
// `almide survive` judges the proposed edit against the baseline BEFORE it is
// applied. Both sides carry the visible suite (never the hidden oracle), in a
// directory of their own so the reach set is exactly that one file. The edit
// gets the same `almide fix` the control arm applies before its test.
//   exit 0 survives   → the control oracle judges it, unchanged
//   exit 1 refused    → a failed attempt whose feedback is the survival delta
//   anything else     → the harness could not judge: an error, so the cell is
//                       `not-run` and the A/B refuses to pair it
let SURVIVE_TIMEOUT_SECS = "300"

effect fn in_dir(dir: String, cmd: String, args: List[String]) -> Result[process.ProcessStatus, String] =
  process.exec_status("sh", ["-c", "cd \"$0\" && exec \"$@\"", dir, cmd] + args)

effect fn survive_gate(task: Task, solution: String, attempt: Int) -> Result[AttemptResult, String] = {
  let dir = env.temp_dir() + "/dojo-survive-" + task.name + "-" + int.to_string(attempt)
  let edit = dir + ".edit.almd"
  fs.mkdir_p(dir)!
  fs.write(dir + "/prog.almd", task.baseline + "\n\n" + task.tests)!
  fs.write(edit, solution + "\n\n" + task.tests)!
  match process.exec("almide", ["fix", edit]) {
    ok(_) => {}
    err(_) => {}
  }
  match in_dir(dir, "almide", ["survive", "prog.almd", "--with", edit, "--as", "text", "--json", "--timeout", SURVIVE_TIMEOUT_SECS]) {
    err(e) => err("almide survive could not start: " + e)
    ok(st) =>
      if st.code == 0 then compile_and_test(task, solution, attempt)
      else if st.code == 1 then ok(AttemptResult { success: false, code: solution, diagnostic: survive_ab.refused_diagnostic(st.stdout) })
      else err("almide survive could not judge the edit (exit " + int.to_string(st.code) + "): " + string.trim(st.stdout + st.stderr))
  }
}

effect fn judge_attempt(cond: String, task: Task, solution: String, attempt: Int) -> Result[AttemptResult, String] =
  if cond == survive_ab.COND_SURVIVE then survive_gate(task, solution, attempt)
  else compile_and_test(task, solution, attempt)

// Does the compiler on PATH have `almide survive`? Asked of a two-line edit in
// a scratch directory, and answered only by a real schema_version-1 verdict:
// a compiler that does not know the subcommand, or answers something else, is
// refused by name.
effect fn survive_probe() -> Result[String, String] = survive_probe_with("almide")

effect fn survive_probe_with(almide: String) -> Result[String, String] = {
  let dir = env.temp_dir() + "/dojo-survive-probe"
  fs.mkdir_p(dir)!
  fs.write(dir + "/a.almd", "fn f() -> Int = 1\n")!
  fs.write(dir + "/b.txt", "fn f() -> Int = 2\n")!
  match in_dir(dir, almide, ["survive", "a.almd", "--with", "b.txt", "--as", "text", "--json"]) {
    err(e) => err(e)
    ok(st) =>
      if st.code == 0 and string.contains(st.stdout, "\"schema_version\":1") then ok("`almide survive` answered a schema_version 1 verdict")
      else err("`almide survive` exited " + int.to_string(st.code) + ": " + string.trim(list.get(string.split(string.trim(st.stderr + st.stdout), "\n"), 0) ?? ""))
  }
}

// ── Fix loop ──
//
// fix_loop_step distinguishes:
//   - err(_)  — genuine harness failure (claude CLI missing, fs broken). Abort.
//   - ok(RunResult { success: false, ... }) — model couldn't produce passing
//     code within max_retries. Not an error; gets recorded and we move on.

fn build_retry_prompt(original: String, prev_code: String, diag: String) -> String =
  "Original task:\n\n" + original + "\n\n" +
  "You previously wrote this code:\n\n" + prev_code + "\n\n" +
  "It failed to compile or test. Diagnostic output:\n\n" + diag +
  hints.hints_block(diag) + "\n\n" +
  "Fix the code and return ONLY the corrected Almide source. No markdown fences, no explanation."

effect fn attempt_once(
  cond: String,
  task: Task,
  model: String,
  user_prompt: String,
  attempt: Int,
) -> Result[AttemptResult, String] = {
  match call_model(model, user_prompt) {
    err(e) => err("call_model: " + e)
    ok(code) => judge_attempt(cond, task, code, attempt)
  }
}

effect fn fix_loop_step(
  cond: String,
  task: Task,
  model: String,
  max_retries: Int,
  attempt: Int,
  last_code: String,
  last_diag: String,
  acc: List[Attempt],
) -> Result[RunResult, String] = {
  if attempt > max_retries then
    ok(RunResult {
      task: task.name, model: model, success: false,
      retries: max_retries, final_diagnostic: last_diag, final_code: last_code,
      attempts: acc,
      reached: true, measurable: true, reason: "",
    })
  else {
    let user_prompt =
      if attempt == 0 then task.prompt
      else build_retry_prompt(task.prompt, last_code, last_diag)
    match attempt_once(cond, task, model, user_prompt, attempt) {
      err(e) => err("attempt " + int.to_string(attempt) + ": " + e)
      ok(result) => {
        let this_attempt = Attempt { code: result.code, diagnostic: result.diagnostic, passed: result.success }
        let new_acc = acc + [this_attempt]
        if result.success then
          ok(RunResult {
            task: task.name, model: model, success: true,
            retries: attempt, final_diagnostic: "", final_code: result.code,
            attempts: new_acc,
            reached: true, measurable: true, reason: "",
          })
        else if result.diagnostic == TARGET_DIVERGENCE then
          // A compiler finding: retrying the model cannot fix it, and a "repair"
          // that happens to dodge it would score a compiler bug as writability.
          ok(RunResult {
            task: task.name, model: model, success: false,
            retries: attempt, final_diagnostic: result.diagnostic, final_code: result.code,
            attempts: new_acc,
            reached: true, measurable: true, reason: "",
          })
        else
          fix_loop_step(cond, task, model, max_retries, attempt + 1, result.code, result.diagnostic, new_acc)
      }
    }
  }
}

// `cond` is the survive A/B arm (src/survive_ab.almd); every lane but the
// A/B's survive arm runs `control`, which is the loop as it always was.
effect fn fix_loop(cond: String, task: Task, model: String, max_retries: Int) -> Result[RunResult, String] =
  fix_loop_step(cond, task, model, max_retries, 0, "", "", [])

// ── Metrics recording ──
//
// Per-task markdown report at runs/YYYY-MM-DD/<task>.md.
// Summaries only — raw model outputs are not committed by convention.
// Rendering moved to self.render; this file only writes the files.

fn model_slug(model: String) -> String =
  model
    |> string.replace("/", "_")
    |> string.replace(":", "_")
    |> string.replace("@", "")
    |> string.replace(".", "-")

// `sub` keeps an A/B arm's per-task reports apart from the control arm's:
// "" for the lane itself, the arm name otherwise.
effect fn write_metrics(result: RunResult, sub: String) -> Result[String, String] = {
  let date = datetime.format(env.unix_timestamp(), "%Y-%m-%d")
  let slug = model_slug(result.model)
  let dir = "runs/" + date + "/" + slug + (if sub == "" then "" else "/" + sub)
  match fs.mkdir_p(dir) {
    err(_) => err("failed to create " + dir)
    ok(_) => {
      let path = dir + "/" + result.task + ".md"
      match fs.write(path, render.render_report(result)) {
        err(_) => err("failed to write " + path)
        ok(_) => ok(path)
      }
    }
  }
}

// ── CLI ──

fn bool_str(b: Bool) -> String =
  if b then "yes" else "no"

effect fn print_usage() -> Unit = {
  println("Almide Dojo harness")
  println("")
  println("Usage:")
  println("  almide run src/main.almd -- <task-name> [provider:model]")
  println("  almide run src/main.almd -- all [provider:model]")
  println("  almide run src/main.almd -- bank [provider:model]   # the contract-preserving bank (tasks/bank/)")
  println("  almide run src/main.almd -- bank <provider:model> --conditions control,survive   # + the almide survive A/B (almide/almide#2147)")
  println("  almide run src/main.almd -- survive-ab <runs-dir>    # merge the survive A/B's shards (no model call)")
  println("")
  println("Providers:")
  println("  cf:@cf/meta/llama-3.3-70b-instruct-fp8-fast")
  println("  anthropic:claude-sonnet-5   (an unprefixed claude-* is also the Anthropic API)")
  println("  openrouter:meta-llama/llama-3.3-70b-instruct")
  println("  openai:<model>")
  println("  cli:claude                  (Claude Code CLI, no API key)")
}

effect fn print_result(result: RunResult) -> Unit = {
  println("")
  println("── Result ──")
  println("  task:    " + result.task)
  println("  model:   " + result.model)
  println("  state:   " + cellstate.state_of(result.measurable, result.reached, false))
  if not result.reached then {
    println("  reason:  " + result.reason)
    println("")
    println("The model was never answered for this task: it is not a failure and not a zero.")
  } else {
    println("  success: " + bool_str(result.success))
    println("  retries: " + int.to_string(result.retries))
    if result.success then {
      println("")
      println("Task passed.")
    } else {
      println("")
      println("Final diagnostic:")
      println(result.final_diagnostic)
    }
  }
}

// A planned cell the model was never answered for. `measurable` is false only
// when the task's own files are not on this machine.
//
// This — not `RunResult { success: false }` — is what a harness error becomes
// (almide-dojo#17). The old code turned every `err` from the run into a
// scored zero, so a read timeout and an empty completion were published in
// `summary.md`'s `passed/total` line as if the model had answered wrongly.
fn absent_cell(task_name: String, model: String, measurable: Bool, reason: String) -> RunResult =
  RunResult {
    task: task_name, model: model, success: false, retries: 0,
    final_diagnostic: "", final_code: "", attempts: [],
    reached: false, measurable: measurable, reason: reason,
  }

// One planned cell of the `tasks x one model` grid. It always yields a cell:
// there is no outcome this lane can meet that is not one of the four states.
effect fn run_cell(task_name: String, model: String, cond: String) -> RunResult = {
  println("Loading task: " + task_name)
  match load_task(task_name) {
    // Not measurable in this configuration at all: `harness-limitation`.
    err(e) => {
      println("  harness limitation: load task: " + e)
      absent_cell(task_name, model, false, "load task: " + e)
    }
    ok(task) => {
      println("Model:    " + model + (if cond == survive_ab.COND_CONTROL then "" else " [" + cond + "]"))
      println("Retries:  " + int.to_string(DEFAULT_MAX_RETRIES))
      println("")
      match fix_loop(cond, task, model, DEFAULT_MAX_RETRIES) {
        // The model was never answered — an HTTP read timeout, the empty
        // completion `src/llm.almd` refuses, a missing credential. The fix
        // loop discards the attempts it did get, so a run that answered twice
        // and then timed out is `not-run` too: a truncated retry budget is
        // not a measured outcome, and the verbatim reason names the attempt.
        err(e) => {
          println("  not run: " + e)
          absent_cell(task_name, model, true, "fix_loop: " + e)
        }
        ok(result) => result
      }
    }
  }
}

// Write the per-task report for any cell, absent or measured, and print it.
// An absent cell gets a report too, so the run directory holds every planned
// task and `backfill` can see the absences it used to have no file for.
effect fn record_cell(result: RunResult) -> Unit = record_cell_in(result, "")!

effect fn record_cell_in(result: RunResult, sub: String) -> Unit = {
  print_result(result)!
  match write_metrics(result, sub) {
    ok(path) => println("\nReport: " + path)
    err(e) => println("\nWarning: failed to write report: " + e)
  }
}

effect fn run_task(task_name: String, model: String) -> RunResult = {
  let result = run_cell(task_name, model, survive_ab.COND_CONTROL)!
  record_cell(result)!
  result
}

// ── Run all tasks ──

fn filter_dotfiles(entries: List[String]) -> List[String] =
  list.filter(entries, (e) => not string.starts_with(e, "."))

effect fn list_all_tasks() -> Result[List[String], String] = {
  let basic = match fs.list_dir("tasks/basic") {
    err(_) => []
    ok(entries) => filter_dotfiles(entries)
  }
  let intermediate = match fs.list_dir("tasks/intermediate") {
    err(_) => []
    ok(entries) => filter_dotfiles(entries)
  }
  let advanced = match fs.list_dir("tasks/advanced") {
    err(_) => []
    ok(entries) => filter_dotfiles(entries)
  }
  let all = (basic + intermediate + advanced) |> list.sort
  if list.is_empty(all) then err("no tasks found")
  else ok(all)
}

// The compiler that judged this run, as `almide --version` prints it.
// Recorded in summary.md so a scorecard row can cite the exact version.
effect fn compiler_version() -> String =
  match process.exec("almide", ["--version"]) {
    // From 0.63.0 a second line names the verifier; the identity is the first.
    ok(v) => string.trim(list.get(string.split(string.trim(v), "\n"), 0) ?? "")
    err(_) => ""
  }

// The HTTP read timeout this process ran under, as summary.md must state it:
// a task is `not-run` BECAUSE some deadline expired, so the deadline is part
// of the run's identity. "" = the compiler's own 30 s default, which — the
// transport being non-streaming — is a deadline on the WHOLE completion.
// The cross-language lane records the same number in its manifest
// (almide-dojo#19); this lane has only summary.md to record it in.
effect fn http_timeout_secs() -> String = env.get("ALMIDE_HTTP_TIMEOUT_SECS") ?? ""

effect fn write_summary(date: String, model: String, results: List[RunResult]) -> Result[String, String] = {
  let slug = model_slug(model)
  let dir = "runs/" + date + "/" + slug
  match fs.mkdir_p(dir) {
    err(_) => err("failed to create " + dir)
    ok(_) => {
      let path = dir + "/summary.md"
      let compiler = compiler_version() ?? ""
      let timeout = http_timeout_secs() ?? ""
      match fs.write(path, render.render_summary(date, model, compiler, timeout, results)) {
        err(_) => err("failed to write " + path)
        ok(_) => ok(path)
      }
    }
  }
}

effect fn run_all(model: String) -> Unit = {
  match list_all_tasks() {
    err(e) => {
      println("Failed to list tasks: " + e)
      process.exit(1)
    }
    ok(tasks) => {
      let sorted = list.sort(tasks)
      println("Running " + int.to_string(list.len(sorted)) + " tasks against " + model)
      println("")
      match run_all_loop(sorted, model, []) {
        err(e) => {
          println("Harness error: " + e)
          process.exit(1)
        }
        ok(results) => {
          // A cell the model never answered is `not-run`, so one flaky task
          // cannot abort a run — but when NO task reached the model, nothing
          // was measured: no summary (a 0/N row with zero model calls would
          // poison the trend line) and exit 2 so a CI job goes red. This is
          // the lane's one refusal to publish at all, and it is kept.
          if list.all(results, (r) => not r.reached) then {
            println("Harness error: no task reached the model (" + int.to_string(list.len(results)) + " tasks, 0 answered); no summary written")
            process.exit(2)
          } else {
            let date = datetime.format(env.unix_timestamp(), "%Y-%m-%d")
            run_all_finish(date, model, results)!
          }
        }
      }
    }
  }
}

// Exit codes of `all`, in the order they are decided:
//
//   2  no task reached the model — nothing written (above).
//   3  the run is `not-comparable`: some planned task was never answered, so
//      the published rate is an INTERVAL and must not be quoted as a point.
//      The summary IS written and committed, carrying its own refusal: a
//      refused run is evidence, it is just not a scorecard number.
//   1  some measured task failed. That is the measurement.
//   0  every planned task reached the model and passed.
//
// 3 outranks 1 because a run that is missing tasks cannot be read as "N of M
// failed" at all, whatever its measured cells did.

// The bank lane. Same fix loop and the same typed cells as `all` (a task the
// model never answered is `not-run`, never a zero), its own summary file, and
// the extra counts the bank's scoring needs on top of pass/fail: silent
// violations (compiled, visible-green, hidden-red) and target divergences
// (compiler findings). Exit codes are `all`'s.
fn bank_counts(date: String, results: List[RunResult]) -> String = {
  let measured = results |> list.filter((r) => r.reached)
  let silent = list.count(measured, (r) => r.final_diagnostic == SILENT_VIOLATION)
  let diverged = list.count(measured, (r) => r.final_diagnostic == TARGET_DIVERGENCE)
  let silent_any = list.count(measured, (r) => list.any(r.attempts, (a) => a.diagnostic == SILENT_VIOLATION))
  let resource = list.count(measured, (r) => r.final_diagnostic == RESOURCE_VIOLATION)
  let resource_any = list.count(measured, (r) => list.any(r.attempts, (a) => a.diagnostic == RESOURCE_VIOLATION))
  "# Bank run " + date + "\n\n" +
    "- **survived**: " + int.to_string(list.count(measured, (r) => r.success)) + "/" + int.to_string(list.len(results)) + " planned (" + int.to_string(list.len(measured)) + " reached the model)\n" +
    "- **silent violations (final)**: " + int.to_string(silent) + "\n" +
    "- **silent violations (any attempt)**: " + int.to_string(silent_any) + "\n" +
    "- **resource violations (final)**: " + int.to_string(resource) + "\n" +
    "- **resource violations (any attempt)**: " + int.to_string(resource_any) + "\n" +
    "- **target divergences**: " + int.to_string(diverged) + "\n\n" +
    "Score = compile ∧ visible ∧ hidden ∧ cross-target ∧ resource (where the task declares it), no partial credit; a refusal counts only if the repair survives within the retry budget.\n\n"
}

fn bank_shard(tasks: List[String], spec: String) -> List[String] = {
  let parts = string.split(spec, "/")
  let i = int.parse(list.get(parts, 0) ?? "") ?? -1
  let n = int.parse(list.get(parts, 1) ?? "") ?? 0
  if n <= 0 or i < 0 or i >= n then tasks
  else tasks |> list.enumerate |> list.filter(((idx, _)) => idx % n == i) |> list.map(((_, t)) => t)
}

effect fn resource_tasks(tasks: List[String], acc: List[String]) -> List[String] =
  match list.first(tasks) {
    none => acc,
    some(t) => {
      let needs = match load_bank_task(t) {
        ok(task) => bank_task_needs_resource(task.dir)!
        err(_) => false
      }
      resource_tasks(list.drop(tasks, 1), if needs then acc + [t] else acc)!
    },
  }

// `conditions` is the survive A/B's arm list (src/survive_ab.almd). The
// default is `control` alone: the lane exactly as it ran before the A/B.
// With `survive` it re-asks every task under the survive arm right after the
// control cell for the same task, so provider drift over a long run lands on
// both arms alike; the survive arm never enters bank-summary.md, the verdict
// or the exit code.
effect fn run_bank(model: String, conditions: List[String]) -> Unit = {
  let with_survive = survive_ab.plans_survive(conditions)
  // The survive arm needs the compiler to have `almide survive`. A compiler
  // without it is refused before any model call: running the arm anyway would
  // publish the control arm measured twice as an A/B.
  let probe = if not with_survive then "" else match survive_probe() {
    ok(p) => p,
    err(e) => {
      println(survive_ab.unavailable_reason(compiler_version() ?? "", e))
      process.exit(2)
      ""
    },
  }
  if with_survive then println("survive A/B: conditions " + string.join(conditions, ",") + " — " + probe) else {}
  match list_bank_tasks() {
    err(e) => {
      println("Failed to list bank tasks: " + e)
      process.exit(1)
    }
    ok(all_tasks) => {
      // BANK_LIMIT=N runs the first N tasks in bank order — the pilot lane's
      // smoke size. The summary names the limit, so a smoke is never read as
      // the bank.
      let limit = int.parse(env.get("BANK_LIMIT") ?? "") ?? 0
      let limited = if limit > 0 then list.take(all_tasks, limit) else all_tasks
      // BANK_SHARD=i/n keeps the tasks whose bank index is i mod n, so a
      // 400-cluster bank fits the pilot lane's per-job time limit.
      let shard = env.get("BANK_SHARD") ?? ""
      let tasks = bank_shard(limited, shard)
      println("Running " + int.to_string(list.len(tasks)) + " of " + int.to_string(list.len(all_tasks)) + " bank tasks against " + model)
      // A compiler without the allocation counters cannot judge a resource
      // task. Those cells are `harness-limitation` — not asked, not scored —
      // and the run is then `not-comparable` by the shared decision table.
      let armed = match process.exec("bash", ["scripts/resource-oracle.sh", "--armed"]) {
        ok(_) => true
        err(_) => false
      }
      let blocked = if armed then [] else resource_tasks(tasks, [])!
      let unarmed_reason = "resource oracle unarmed: " + (compiler_version() ?? "") + " prints no allocation-counter line (ALMIDE_ALLOC_COUNT / ALMIDE_WASM_ALLOC_COUNT); advance almide-pin.toml to a release that carries both"
      let absent = blocked |> list.map((t) => absent_cell(t, model, false, unarmed_reason))
      absent |> list.map((r) => record_cell(r)!)!
      let absent_s = if with_survive then absent else []
      absent_s |> list.map((r) => record_cell_in(r, survive_ab.COND_SURVIVE)!)!
      if not list.is_empty(blocked) then println(unarmed_reason + " — " + int.to_string(list.len(blocked)) + " task(s) not run") else {}
      println("")
      match run_bank_loop(tasks |> list.filter((t) => not list.contains(blocked, t)), model, with_survive, absent, absent_s) {
        err(e) => {
          println("Harness error: " + e)
          process.exit(1)
        }
        ok((results, survive_results)) => {
          if list.all(results, (r) => not r.reached) then {
            println("Harness error: no bank task reached the model (" + int.to_string(list.len(results)) + " tasks, 0 answered); no summary written")
            process.exit(2)
          } else {
            let date = datetime.format(env.unix_timestamp(), "%Y-%m-%d")
            let dir = "runs/" + date + "/" + model_slug(model)
            fs.mkdir_p(dir)!
            // BANK_RUN_LABEL keeps repetitions and smokes apart in one run
            // directory (the pilot lane sets it per matrix cell).
            let label = env.get("BANK_RUN_LABEL") ?? ""
            let path = dir + "/bank-summary" + (if label == "" then "" else "-" + label) + ".md"
            let shard_note = if shard == "" then "" else "- **shard**: `" + shard + "` (" + int.to_string(list.len(tasks)) + " tasks of this run)\n"
            let scope = shard_note + if limit > 0 then "- **scope**: first " + int.to_string(list.len(tasks)) + " of " + int.to_string(list.len(all_tasks)) + " bank tasks (BANK_LIMIT) — a smoke, not the bank\n" else "- **scope**: all " + int.to_string(list.len(all_tasks)) + " bank tasks\n"
            let compiler = compiler_version() ?? ""
            let timeout = http_timeout_secs() ?? ""
            fs.write(path, bank_counts(date, results) + scope + "\n" + render.render_summary(date, model, compiler, timeout, results))!
            println("Bank summary: " + path)
            if with_survive then {
              let planned = tasks
              let notes = (if shard == "" then [] else ["**shard**: `" + shard + "` (" + int.to_string(list.len(tasks)) + " tasks of this run; merge the shards with `almide run src/main.almd -- survive-ab <runs-dir>`)"]) +
                (if limit > 0 then ["**scope**: first " + int.to_string(list.len(tasks)) + " of " + int.to_string(list.len(all_tasks)) + " bank tasks (BANK_LIMIT) — a smoke, not the bank"] else [])
              match write_survive_ab(date, model, label, limit, shard, planned, results, survive_results, probe, notes) {
                ok(abdir) => println("Survive A/B: " + abdir + "/{manifest.json, table.md}")
                err(e) => println("Warning: failed to write the survive A/B: " + e)
              }
            } else {}
            let v = render.daily_verdict(results)
            println("verdict: " + v.id)
            let passed = list.count(results, (r) => r.reached and r.success)
            if not v.comparable then process.exit(3)
            else if passed < list.len(results) then process.exit(1)
            else {}
          }
        }
      }
    }
  }
}

// Task-major: each task's control cell, then (when planned) its survive cell.
effect fn run_bank_loop(tasks: List[String], model: String, with_survive: Bool, ctl: List[RunResult], srv: List[RunResult]) -> Result[(List[RunResult], List[RunResult]), String] =
  match list.first(tasks) {
    none => ok((ctl, srv)),
    some(t) => {
      println("=== " + t + " ===")
      let r = run_task(t, model)!
      let s = if with_survive then {
        println("=== " + t + " [" + survive_ab.COND_SURVIVE + "] ===")
        let x = run_cell(t, model, survive_ab.COND_SURVIVE)!
        record_cell_in(x, survive_ab.COND_SURVIVE)!
        [x]
      } else []
      println("")
      run_bank_loop(list.drop(tasks, 1), model, with_survive, ctl + [r], srv + s)
    },
  }

// ── The survive A/B's own artifacts ──

effect fn git_line(args: List[String]) -> String =
  match process.exec("git", args) {
    ok(s) => string.trim(s)
    err(_) => ""
  }

effect fn compiler_pin() -> String =
  match fs.read_text("almide-pin.toml") {
    err(_) => ""
    ok(raw) => string.split(raw, "\n")
      |> list.map(string.trim)
      |> list.filter((l) => string.starts_with(l, "ref"))
      |> list.filter_map((l) => list.get(string.split(l, "\""), 1))
      |> list.first
      |> option.unwrap_or("")
  }

fn ab_title(date: String, label: String) -> String =
  "Survive A/B (bank, almide/almide#2147) " + date + (if label == "" then "" else " [" + label + "]")

fn ab_facts(model: String, compiler: String, pin: String, probe: String, notes: List[String]) -> List[String] =
  ["**model**: `" + model + "` (both arms; temperature 0.0, one transport attempt per call)",
   "**compiler**: `" + compiler + "` (pin `" + pin + "`) — " + probe] + notes

effect fn write_survive_ab(date: String, model: String, label: String, limit: Int, shard: String, planned: List[String], ctl: List[RunResult], srv: List[RunResult], probe: String, notes: List[String]) -> Result[String, String] = {
  let dir = "runs/" + date + "/" + model_slug(model) + "/survive-ab" + (if label == "" then "" else "-" + label)
  fs.mkdir_p(dir)!
  let cells = (ctl |> list.map((r) => survive_ab.cell_of(survive_ab.COND_CONTROL, r))) +
    (srv |> list.map((r) => survive_ab.cell_of(survive_ab.COND_SURVIVE, r)))
  let compiler = compiler_version()!
  let pin = compiler_pin()!
  let run = [
    ("date", value.str(date)),
    ("label", value.str(label)),
    ("model", value.object([
      ("spec", value.str(model)),
      ("provider", value.str(llm.provider_of(model))),
      ("temperature_requested", value.float(0.0)),
      ("transport_attempts", value.int(1)),
      ("http_timeout_secs", value.str(http_timeout_secs()!)),
    ])),
    ("compiler", value.object([
      ("pin", value.str(pin)),
      ("version", value.str(compiler)),
      ("survive", value.str(probe)),
    ])),
    ("harness", value.object([
      ("repo", value.str("almide/almide-dojo")),
      ("commit", value.str(git_line(["rev-parse", "HEAD"])!)),
      ("dirty", value.bool(git_line(["status", "--porcelain", "--", "src", "tasks"])! != "")),
    ])),
    ("selection", value.object([
      ("limit", value.int(limit)),
      ("shard", value.str(shard)),
    ])),
  ]
  fs.write(dir + "/manifest.json", json.stringify_pretty(survive_ab.manifest(run, DEFAULT_MAX_RETRIES, planned, cells)) + "\n")!
  fs.write(dir + "/table.md", survive_ab.render_table(ab_title(date, label), ab_facts(model, compiler, pin, probe, notes), DEFAULT_MAX_RETRIES, planned, cells))!
  ok(dir)
}

// `survive-ab <root>`: merge every survive-ab manifest under <root> (the
// pilot lane writes one per shard) into <root>/survive-ab/{manifest.json,
// table.md}, re-deciding the verdict and the criterion over the union. It
// refuses shards that measured different models or compilers: that union is
// not one A/B. No model call.
fn jfield(v: Value, key: String) -> Value = json.get_path(v, json.field(json.root(), key)) ?? value.null()

effect fn merge_survive_ab(root: String) -> Unit = {
  let out = root + "/survive-ab"
  let found = match process.exec("find", [root, "-path", "*survive-ab*/manifest.json"]) {
    ok(s) => s
    err(_) => ""
  }
  let paths = string.split(found, "\n") |> list.map(string.trim)
    |> list.filter((p) => p != "" and p != out + "/manifest.json") |> list.sort
  if list.is_empty(paths) then {
    println("no survive-ab/manifest.json under " + root + ": nothing to merge")
    process.exit(2)
  } else {}
  let ms = (paths |> list.map((p) => json.parse(fs.read_text(p)!)!))!
  let models = ms |> list.map((m) => json.get_string(jfield(m, "model"), "spec") ?? "") |> list.unique
  let compilers = ms |> list.map((m) => json.get_string(jfield(m, "compiler"), "version") ?? "") |> list.unique
  if list.len(models) != 1 or list.len(compilers) != 1 then {
    println("refused: the manifests under " + root + " measured " + string.join(models, ", ") + " with " + string.join(compilers, ", ") + " — one A/B is one model and one compiler")
    process.exit(2)
  } else {}
  let first = list.first(ms) ?? value.null()
  let tasks = ms |> list.flat_map((m) => (json.get_array(jfield(m, "task_set"), "tasks") ?? []) |> list.filter_map((t) => value.as_string(t) |> result.to_option))
  let cells = ms |> list.flat_map(survive_ab.cells_from_manifest)
  let retries = json.get_int(jfield(first, "budget"), "retries") ?? DEFAULT_MAX_RETRIES
  let model = list.first(models) ?? ""
  let compiler = list.first(compilers) ?? ""
  let comp = jfield(first, "compiler")
  let run = [
    ("date", value.str(json.get_string(first, "date") ?? "")),
    ("label", value.str("merged")),
    ("merged_from", value.array(paths |> list.map(value.str))),
    ("model", jfield(first, "model")),
    ("compiler", comp),
  ]
  fs.mkdir_p(out)!
  fs.write(out + "/manifest.json", json.stringify_pretty(survive_ab.manifest(run, retries, tasks, cells)) + "\n")!
  let facts = ab_facts(model, compiler, json.get_string(comp, "pin") ?? "", json.get_string(comp, "survive") ?? "",
    ["**merged**: " + int.to_string(list.len(paths)) + " manifest(s) under `" + root + "`"])
  let table = survive_ab.render_table(ab_title(json.get_string(first, "date") ?? "", "merged"), facts, retries, tasks, cells)
  fs.write(out + "/table.md", table)!
  println(table)
  println("Written: " + out + "/{manifest.json, table.md}")
}

// `bank <model> [--conditions a,b]`, else BANK_CONDITIONS, else control alone.
fn bank_condition_spec(rest: List[String], env_spec: String) -> Result[String, String] =
  match rest {
    [] => ok(env_spec),
    ["--conditions", v] => ok(v),
    _ => err("usage: bank <provider:model> [--conditions control[,survive]] (got " + string.join(rest, " ") + ")"),
  }

fn bank_conditions(rest: List[String], env_spec: String) -> Result[List[String], String] =
  match bank_condition_spec(rest, env_spec) {
    err(e) => err(e),
    ok(spec) => if string.trim(spec) == "" then ok(survive_ab.DEFAULT_CONDITIONS)
      else survive_ab.parse_conditions(survive_ab.split_list(spec)),
  }

effect fn run_all_finish(date: String, model: String, results: List[RunResult]) -> Unit = {
  match write_summary(date, model, results) {
    ok(path) => {
      println("")
      println("Summary: " + path)
      let v = render.daily_verdict(results)
      let total = list.len(results)
      let reached = list.count(results, (r) => r.reached)
      let passed = list.count(results, (r) => r.reached and r.success)
      println("verdict: " + v.id)
      v.reasons |> list.map((r) => println("  - " + r))
      println(cellstate.rate(passed, total - reached, total) + " of the planned tasks passed" +
        (if reached == total then "" else " (" + int.to_string(total - reached) + " never asked, so this is an interval)"))
      if not v.comparable then process.exit(3)
      else if passed < total then process.exit(1)
      else {}
    }
    err(e) => {
      println("Warning: failed to write summary: " + e)
      process.exit(1)
    }
  }
}

effect fn run_all_loop(tasks: List[String], model: String, acc: List[RunResult]) -> Result[List[RunResult], String] = {
  if list.is_empty(tasks) then ok(acc)
  else {
    let task_name = list.get(tasks, 0) |> option.unwrap_or("")
    let rest = list.drop(tasks, 1)
    println("=== " + task_name + " ===")
    // Every outcome is already a typed cell: there is no error path left here
    // that could turn a network event into a model result.
    let r = run_task(task_name, model)!
    println("")
    run_all_loop(rest, model, acc + [r])
  }
}

effect fn main() -> Unit = {
  let args = env.args()
  let argc = list.len(args)
  if argc < 1 then
    print_usage()!
  else {
    let first = list.get(args, 0) |> option.unwrap_or("")
    let model = list.get(args, 1) |> option.unwrap_or(DEFAULT_MODEL)
    if first == "all" then
      run_all(model)!
    else if first == "bank" then
      match bank_conditions(list.drop(args, 2), env.get("BANK_CONDITIONS") ?? "") {
        ok(cs) => run_bank(model, cs)!
        err(e) => {
          println(e)
          process.exit(1)
        }
      }
    else if first == "survive-ab" then
      merge_survive_ab(list.get(args, 1) ?? "runs")!
    else if first == "backfill" then
      backfill.backfill_all()!
    else {
      // Single task. A cell the model never answered exits 2, the same code
      // `all` uses for "nothing was measured" — it is not a failing task, and
      // exiting 1 for it is the single-task spelling of the same defect.
      let r = run_task(first, model)!
      if not r.reached then process.exit(2)
      else if not r.success then process.exit(1)
      else {}
    }
  }
}

// ── Tests ──

test "bool_str true is yes" {
  assert_eq(bool_str(true), "yes")
}

test "bool_str false is no" {
  assert_eq(bool_str(false), "no")
}

test "render_report contains task name and model" {
  let r = RunResult {
    task: "fizzbuzz",
    model: "claude-sonnet-4-6",
    success: true,
    retries: 0,
    final_diagnostic: "",
    final_code: "fn fizzbuzz(n: Int) -> String = \"1\"",
    attempts: [Attempt { code: "fn fizzbuzz(n: Int) -> String = \"1\"", diagnostic: "", passed: true }],
    reached: true, measurable: true, reason: "",
  }
  let out = render.render_report(r)
  assert(string.contains(out, "fizzbuzz"))
  assert(string.contains(out, "claude-sonnet-4-6"))
  assert(string.contains(out, "success"))
}

test "model_slug sanitizes provider string" {
  assert_eq(model_slug("cf:@cf/meta/llama-3.3-70b"), "cf_cf_meta_llama-3-3-70b")
  assert_eq(model_slug("claude-sonnet-4-6"), "claude-sonnet-4-6")
  assert_eq(model_slug("anthropic/claude-sonnet-4-6"), "anthropic_claude-sonnet-4-6")
}

// ── almide-dojo#17: a task the model was never asked is never a zero ──

fn t_pass(task: String) -> RunResult = RunResult {
  task: task, model: "cf:m", success: true, retries: 0,
  final_diagnostic: "", final_code: "",
  attempts: [Attempt { code: "fn f() = 1", diagnostic: "", passed: true }],
  reached: true, measurable: true, reason: "",
}

fn t_fail(task: String) -> RunResult = RunResult {
  task: task, model: "cf:m", success: false, retries: 3,
  final_diagnostic: "error[E003]: undefined variable 'x'", final_code: "",
  attempts: [Attempt { code: "fn f() = x", diagnostic: "error[E003]: undefined variable 'x'", passed: false }],
  reached: true, measurable: true, reason: "",
}

// The shape run 35783112036 produced 14 times, and the one main.almd used to
// publish as `success: false`.
let TIMED_OUT_REASON =
  "fix_loop: attempt 0: call_model: cloudflare: http: read timed out waiting for the server (raise ALMIDE_HTTP_TIMEOUT_SECS; 0 = no timeout)"

fn t_timeout(task: String) -> RunResult = absent_cell(task, "cf:m", true, TIMED_OUT_REASON)

test "a timed-out task is not-run in summary.md, with the transport's own words" {
  let out = render.render_summary("2026-09-23", "cf:m", "almide 0.62.0", "140",
    [t_pass("clamp"), t_fail("gcd"), t_timeout("matrix-ops")])
  // The per-task row says `not-run`, not FAIL, and carries no retry count it
  // never had.
  assert(string.contains(out, "| `matrix-ops` | not-run | not-run | `timeout` | — |"))
  assert(not string.contains(out, "| `matrix-ops` | FAIL"))
  // The reason is in summary.md verbatim — requirement 1 of almide-dojo#17 is
  // that it is visible here, not only somewhere a reader would have to open.
  assert(string.contains(out, "## Never asked (the model was never answered)"))
  assert(string.contains(out, "read timed out waiting for the server (raise ALMIDE_HTTP_TIMEOUT_SECS; 0 = no timeout)"))
  // The deadline that produced it is part of the run's identity.
  assert(string.contains(out, "- **http timeout (s)**: `140`\n"))
  // ...and the four states add up to the planned task count.
  assert(string.contains(out, "- **cells**: measured 2, inconclusive-saturated 0, not-run 1, harness-limitation 0\n"))
}

test "the headline rate carries its own incompleteness rather than a point over a subset" {
  let done = [t_pass("a"), t_pass("b"), t_fail("c")]
  let gone = [t_timeout("d")]
  let out = render.render_summary("2026-09-23", "cf:m", "almide 0.62.0", "140", done + gone)
  // 2 of 4 PLANNED tasks passed, and the true rate is somewhere in [50%,75%]
  // because task `d` was never asked. The old renderer printed `2 / 4`, which
  // reads as a point over the whole set, and `- **tasks**: 4` beside it.
  assert(string.contains(out, "- **passed**: 2/4 (50%–75%)\n"))
  assert(string.contains(out, "- **1-shot passes**: 2/4 (50%–75%)\n"))
  assert(string.contains(out, "- **reached**: 3 / 4\n"))
  assert(string.contains(out, "- **not-run**: 1\n"))
  // The denominator is the planned count in every rate: never 3, the subset
  // that answered.
  assert(not string.contains(out, "2/3"))
  assert(not string.contains(out, "2 / 3"))
  // A complete run's interval collapses to the point that IS quotable.
  let whole = render.render_summary("2026-09-23", "cf:m", "almide 0.62.0", "140", done + [t_pass("d")])
  assert(string.contains(whole, "- **passed**: 3/4 (75%)\n"))
  assert(not string.contains(whole, "–"))
}

test "the verdict is above the numbers, and an incomplete run refuses to be quoted" {
  let out = render.render_summary("2026-09-23", "cf:m", "almide 0.62.0", "140",
    [t_pass("a"), t_fail("b"), t_timeout("c")])
  let banner = string.index_of(out, "Verdict: `not-comparable`")
  let first_rate = string.index_of(out, "- **passed**:")
  assert(option.is_some(banner))
  // What a reader carries away is the number, so the refusal must be above it.
  assert((banner ?? 0) < (first_rate ?? 0))
  assert(string.contains(out, "must not be quoted as a point"))
  assert(string.contains(out, "certified as a comparison: **no**"))
  // ...and the run itself refuses: not-comparable is not comparable.
  let v = render.daily_verdict([t_pass("a"), t_fail("b"), t_timeout("c")])
  assert_eq(v.id, "not-comparable")
  assert(not v.comparable)
  // One failing measured cell is enough for the bank to have discriminated.
  assert(v.conclusive)
}

test "a complete run is comparable, and a clean sweep is inconclusive-saturated" {
  let mixed = [t_pass("a"), t_pass("b"), t_fail("c")]
  let v = render.daily_verdict(mixed)
  assert_eq(v.id, "comparable")
  assert(v.comparable)
  assert(v.conclusive)
  assert(list.is_empty(v.reasons))
  // The README scorecard's own shape: 100% over the whole bank. It is a
  // complete run and still not evidence about the model — the bank is at its
  // ceiling (almide-dojo#3 / almide/almide#1963).
  let sweep = ["a", "b", "c"] |> list.map(t_pass)
  let vs = render.daily_verdict(sweep)
  assert_eq(vs.id, cellstate.ST_SATURATED)
  assert(vs.comparable)
  assert(not vs.conclusive)
  let out = render.render_summary("2026-09-23", "cf:m", "almide 0.62.0", "140", sweep)
  assert(string.contains(out, "do not quote this rate as evidence about the model"))
  assert(string.contains(out, "- **cells**: measured 0, inconclusive-saturated 3, not-run 0, harness-limitation 0\n"))
  // Saturation never invents an interval: the run is complete.
  assert(string.contains(out, "- **passed**: 3/3 (100%)\n"))
}

test "a run that reached nothing is refused before a summary can be written" {
  let none_reached = ["a", "b"] |> list.map(t_timeout)
  let v = render.daily_verdict(none_reached)
  assert_eq(v.id, "nothing-measured")
  assert(not v.comparable)
  assert(not v.conclusive)
  // This is the condition run_all refuses to publish under at all: `all`
  // exits 2 and writes no summary, because a 0/N row with zero model calls
  // would poison the trend line.
  assert(list.all(none_reached, (r) => not r.reached))
}

test "an unanswered task is in no failure bucket: not the retry distribution, not the code backlog" {
  let out = render.render_summary("2026-09-23", "cf:m", "almide 0.62.0", "140",
    [t_pass("a"), t_timeout("b")])
  // `fail-0` is where a RunResult { success: false, retries: 0 } used to land,
  // which is exactly what the old harness error became.
  assert(string.contains(out, "- fail-0: 0\n"))
  assert(string.contains(out, "- pass-0: 1\n"))
  // ...and it is not read as a diagnostic the model could not act on.
  assert(not string.contains(out, "Unrecoverable diagnostic codes"))
  // The breakdown counts it as an absence, by name.
  assert(string.contains(out, "- not-run: 1\n"))
}

test "a task whose files are missing is a harness limitation, not a model failure" {
  let ghost = absent_cell("ghost", "cf:m", false, "load task: task not found: ghost")
  let out = render.render_summary("2026-09-23", "cf:m", "almide 0.62.0", "", [t_pass("a"), t_fail("b"), ghost])
  assert(string.contains(out, "| `ghost` | harness-limitation | harness-limitation | `task-files-missing` | — |"))
  assert(string.contains(out, "- **cells**: measured 2, inconclusive-saturated 0, not-run 0, harness-limitation 1\n"))
  // It still shrinks the denominator's certainty: the cell was planned.
  assert(string.contains(out, "- **passed**: 1/3 (33%–66%)\n"))
  // A run with no ALMIDE_HTTP_TIMEOUT_SECS states no line rather than an empty one.
  assert(not string.contains(out, "**http timeout"))
}

test "render_summary stamps the compiler version the run was judged with" {
  let r = t_pass("fizzbuzz")
  let out = render.render_summary("2026-09-22", "anthropic:claude-sonnet-5", "almide 0.62.0", "140", [r])
  assert(string.contains(out, "- **compiler**: `almide 0.62.0`\n"))
  assert(string.contains(out, "- **tasks**: 1\n"))
  // A backfill does not know the compiler: no line rather than an empty one.
  let bare = render.render_summary("2026-09-22", "anthropic:claude-sonnet-5", "", "", [r])
  assert(not string.contains(bare, "**compiler**"))
}

test "the per-task report of an unanswered task carries no success line to be misread" {
  let out = render.render_report(t_timeout("matrix-ops"))
  assert(string.contains(out, "- **state**: `not-run`\n"))
  assert(string.contains(out, "- **reason**: " + TIMED_OUT_REASON + "\n"))
  // The transport class, and never labelled `diagnostic code`: there is no
  // diagnostic, and naming one sends a reader after a compiler bug.
  assert(string.contains(out, "- **class**: `timeout`\n"))
  assert(not string.contains(out, "diagnostic code"))
  // `- **success**: no` is the lie: there was no attempt to succeed at.
  assert(not string.contains(out, "**success**"))
  assert(string.contains(out, "not a failure, and not a zero"))
  // A measured report still says what it always said, and now says which
  // state it is.
  let measured = render.render_report(t_fail("gcd"))
  assert(string.contains(measured, "- **success**: no\n"))
  assert(string.contains(measured, "- **state**: `measured`\n"))
}

test "the three bank markers are three buckets, none of them a compile failure" {
  assert_eq(classifier.classify_failure(SILENT_VIOLATION), ("silent-violation", ""))
  assert_eq(classifier.classify_failure(RESOURCE_VIOLATION), ("resource-violation", ""))
  assert_eq(classifier.classify_failure(TARGET_DIVERGENCE), ("target-divergence", ""))
}

test "a bank shard keeps every i-th task, and a malformed spec keeps them all" {
  let ts = ["a", "b", "c", "d", "e"]
  assert_eq(bank_shard(ts, "0/2"), ["a", "c", "e"])
  assert_eq(bank_shard(ts, "1/2"), ["b", "d"])
  assert_eq(bank_shard(ts, ""), ts)
  assert_eq(bank_shard(ts, "2/2"), ts)
}

test "the survive A/B is planned only when it is asked for, by flag or by BANK_CONDITIONS" {
  assert_eq(bank_conditions([], ""), ok([survive_ab.COND_CONTROL]))
  assert_eq(bank_conditions(["--conditions", "control,survive"], ""), ok([survive_ab.COND_CONTROL, survive_ab.COND_SURVIVE]))
  assert_eq(bank_conditions([], "control,survive"), ok([survive_ab.COND_CONTROL, survive_ab.COND_SURVIVE]))
  // The flag outranks the environment.
  assert_eq(bank_conditions(["--conditions", "control"], "control,survive"), ok([survive_ab.COND_CONTROL]))
  // No control arm, an unknown arm, or a stray argument: refused, never guessed.
  assert(match bank_conditions(["--conditions", "survive"], "") { ok(_) => false, err(_) => true })
  assert(match bank_conditions([], "control,effects") { ok(_) => false, err(_) => true })
  assert(match bank_conditions(["--retries", "2"], "") { ok(_) => false, err(_) => true })
}

test "a compiler that cannot answer almide survive is refused by name, not run" {
  // `false` stands in for a compiler without the subcommand: it exits
  // non-zero and prints no verdict, exactly the shape v0.63.1 answers with.
  let r = survive_probe_with("false")
  assert(match r { ok(_) => false, err(e) => string.contains(e, "exited 1") })
  // `true` exits 0 but prints no schema_version-1 verdict: still refused.
  assert(match survive_probe_with("true") { ok(_) => false, err(_) => true })
}
