// Shared record types for the dojo harness.
// Kept in their own module so classify / parse / render / backfill
// can depend on them without pulling in the runner.

type Task = {
  name: String,
  prompt: String,
  tests: String,
  dir: String,
  // "write" (the classic bank: the model writes a program from prompt.md) or
  // "modify" (the contract-preserving bank, tasks/bank/: the model edits
  // `baseline`, and `hidden` is the oracle it never sees — almide-dojo#3).
  kind: String,
  baseline: String,
  hidden: String,
}

type Attempt = {
  code: String,
  diagnostic: String,
  passed: Bool,
}

type RunResult = {
  task: String,
  model: String,
  success: Bool,
  retries: Int,
  final_diagnostic: String,
  final_code: String,
  attempts: List[Attempt],
}

type AttemptResult = {
  success: Bool,
  code: String,
  diagnostic: String,
}
