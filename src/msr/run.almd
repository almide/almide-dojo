// msr — the cross-language MSR lane (almide/almide#2146).
//
// The same tasks, the same model, the same prompts modulo the language name
// and its syntax notes, the same retry budget, judged by each language's
// own toolchain, under one manifest. Almide first.
//
// Usage:
//   almide run src/msr/run.almd -- run <provider:model> [options]
//   almide run src/msr/run.almd -- verify [options]      reference solutions through every available plugin (no model)
//   almide run src/msr/run.almd -- probe                  which plugins this machine can measure
//   almide run src/msr/run.almd -- prompt <language> <task>
//   almide run src/msr/run.almd -- verdict <run-dir>      re-derive a written run's verdict and refuse a non-comparison
//
// Options:
//   --languages a,b   plugins to run (default: all seven, in table order)
//   --tasks x,y       tasks to run (default: every task in msr/task-set.json)
//   --out DIR         where results go (default: runs/msr)
//   --label TEXT      free-text label. It is stamped into the manifest AND
//                     appended to the run directory, so a labelled run ("smoke")
//                     can never replace the unlabelled measurement for the same
//                     model on the same day.
//   --retries N       fix-loop retries per task (default 3)
//   --conditions a,b  the effect-declaration conditions (almide-dojo#2); default
//                     "shipped,unmentioned". `shipped` is the cross-language grid and
//                     is always run; every other condition re-runs ONLY the Almide leg
//                     (see "The effect-declaration A/B" below). `--condition` is an alias.
//
// Output of `run`: <out>/<date>/<model-slug>[-<label>]/{manifest.json, results.json, table.md}
// plus raw/ (per-attempt sources and logs; gitignored).
// Exit codes: 0 every measured task passed, 1 some failed (the table is
// still written — that is the measurement), 2 nothing was measured.

import env
import fs
import hash
import json
import path
import process
import datetime
import self.llm
import self.prompts
import self.cellstate.{Verdict}
import self.cellstate
import self.msr.spec.{PTask, Case, Val, VInt, VBool, VStr, VList, VCall, Ty, TInt, TBool, TStr, TList, Step}
import self.msr.spec
import self.msr.plugins.{Plugin}
import self.msr.plugins

let TASK_SET = "msr/task-set.json"
let DEFAULT_OUT = "runs/msr"
let DEFAULT_RETRIES = 3
let TEMPERATURE = 0.0
let TRANSPORT_ATTEMPTS = 3
let DIAG_LIMIT = 6000

// The effect-declaration A/B (almide-dojo#2, almide/almide#2146 item 3).
//
//   shipped      A: the Almide notes as every run sends them, which teach the
//                effect discipline (effect fn, the effect-only loop forms).
//   unmentioned  B: the same notes with those sentences removed
//                (prompts.without_effect_notes) — the model is shown no
//                effect declaration at all.
//
// Everything else is held identical: model, sampling (temperature, seed),
// user prompt, retry template and budget, task set, oracle, and the compiler
// that judges (the pinned release still enforces effects in both arms — it
// has no relaxation switch). B re-runs the Almide leg only, task by task
// right after A's cell for the same task, so provider drift over a long run
// lands on both arms alike. The other languages have no effect system to
// remove, so a B column for them would be A measured twice.
let COND_SHIPPED = "shipped"
let COND_UNMENTIONED = "unmentioned"
let CONDITIONS = [COND_SHIPPED, COND_UNMENTIONED]
let DEFAULT_CONDITIONS = CONDITIONS

// ── Options ──

type Opts = {
  command: String,
  model: String,
  languages: List[String],
  tasks: List[String],
  out: String,
  label: String,
  retries: Int,
  conditions: List[String],
  rest: List[String],
}

fn default_opts() -> Opts = Opts {
  command: "", model: "", languages: [], tasks: [], out: DEFAULT_OUT,
  label: "", retries: DEFAULT_RETRIES, conditions: DEFAULT_CONDITIONS, rest: [],
}

fn split_list(s: String) -> List[String] =
  string.split(s, ",") |> list.map(string.trim) |> list.filter((x) => x != "")

fn parse_opts(args: List[String], acc: Opts) -> Opts! = match args {
  [] => ok(acc),
  ["--languages", v, ..rest] => parse_opts(rest, { ...acc, languages: split_list(v) }),
  ["--tasks", v, ..rest] => parse_opts(rest, { ...acc, tasks: split_list(v) }),
  ["--out", v, ..rest] => parse_opts(rest, { ...acc, out: v }),
  ["--label", v, ..rest] => parse_opts(rest, { ...acc, label: v }),
  ["--retries", v, ..rest] => match int.parse(v) {
    ok(n) => parse_opts(rest, { ...acc, retries: n }),
    err(_) => err("--retries needs a number, got `" + v + "`"),
  },
  ["--conditions", v, ..rest] => match parse_conditions(split_list(v)) {
    ok(cs) => parse_opts(rest, { ...acc, conditions: cs }),
    err(e) => err(e),
  },
  ["--condition", v, ..rest] => parse_opts(["--conditions", v] + rest, acc),
  [a, ..rest] =>
    if string.starts_with(a, "--") then err("unknown option " + a)
    else parse_opts(rest, { ...acc, rest: acc.rest + [a] }),
}

// The conditions, in CONDITIONS order and without repeats. `shipped` is the
// cross-language grid every other number is compared against, so a run
// without it has no A arm and no table.
fn parse_conditions(names: List[String]) -> List[String]! = {
  let unknown = names |> list.filter((n) => not list.contains(CONDITIONS, n))
  if not list.is_empty(unknown) then
    err("unknown condition(s) " + string.join(unknown, ", ") + " (known: " + string.join(CONDITIONS, ", ") + ")")
  else if not list.contains(names, COND_SHIPPED) then
    err("--conditions must include `" + COND_SHIPPED + "`: it is the cross-language grid and the A arm of the effect A/B")
  else ok(CONDITIONS |> list.filter((c) => list.contains(names, c)))
}

// The plugin a condition runs: B changes only the Almide notes.
fn plugin_for(p: Plugin, cond: String) -> Plugin =
  if cond == COND_UNMENTIONED and p.name == "almide" then { ...p, notes: prompts.without_effect_notes(p.notes) }
  else p

// The (condition, plugin) legs one language runs, per task, in this order.
fn legs_for(p: Plugin, conditions: List[String]) -> List[(String, Plugin)] =
  if p.name == "almide" then conditions |> list.map((c) => (c, plugin_for(p, c)))
  else [(COND_SHIPPED, p)]

// The extra (non-shipped) conditions this run plans. They are Almide legs, so
// a run whose --languages leaves Almide out plans none of them.
fn extra_conditions(conditions: List[String], probes: List[Probe]) -> List[String] =
  if list.any(probes, (pr) => pr.plugin.name == "almide") then conditions |> list.filter((c) => c != COND_SHIPPED)
  else []

// ── Tasks ──

effect fn find_task_dir(name: String) -> String! = {
  let dirs = ["basic", "intermediate", "advanced"] |> list.map((d) => "tasks/" + d + "/" + name)
  match list.find(dirs, (d) => fs.exists(d + "/prompt.md")) {
    some(d) => ok(d),
    none => err("task not found under tasks/: " + name),
  }
}

effect fn load_task(name: String) -> PTask! = {
  let dir = find_task_dir(name)!
  let prompt = fs.read_text(dir + "/prompt.md")!
  let tests = fs.read_text(dir + "/tests.almd")!
  let spec_path = "msr/specs/" + name + ".md"
  guard fs.exists(spec_path) else err(spec_path + " is missing (the language-neutral behavior text of " + name + ")")
  let behavior = string.trim(fs.read_text(spec_path)!)
  let t = PTask {
    name: name, dir: dir,
    sigs: spec.parse_sigs(prompt)!,
    behavior: behavior,
    cases: spec.parse_cases(tests)!,
  }
  spec.check_task(t)!
  ok(t)
}

effect fn task_set_names() -> List[String]! = {
  let raw = fs.read_text(TASK_SET)!
  let v = json.parse(raw)!
  let items = json.get_array(v, "include") ?? []
  let names = items |> list.filter_map((it) => json.get_string(it, "task"))
  guard not list.is_empty(names) else err(TASK_SET + " has no include list")
  ok(names)
}

effect fn task_set_revision() -> String = {
  let raw = fs.read_text(TASK_SET) ?? ""
  match json.parse(raw) {
    ok(v) => json.get_string(v, "revision") ?? "",
    err(_) => "",
  }
}

effect fn load_tasks(selected: List[String]) -> List[PTask]! = {
  let all = task_set_names()!
  let names = if list.is_empty(selected) then all else selected
  let unknown = names |> list.filter((n) => not list.contains(all, n))
  guard list.is_empty(unknown) else err("not in " + TASK_SET + ": " + string.join(unknown, ", "))
  ok((names |> list.map((n) => load_task(n)!))!)
}

// ── Prompts ──

fn system_prompt(p: Plugin) -> String =
  "You are writing " + p.display + ". Output ONLY source code, no fences or prose.\n\n" + p.notes

fn signatures(p: Plugin, t: PTask) -> String = p.signatures(t)

fn prompt_body(display: String, sigs: String, behavior: String, one: Bool) -> String = {
  let head = if one then "Write a function in " + display + " with this exact signature:"
    else "Write these functions in " + display + " with these exact signatures:"
  head + "\n\n" + sigs + "\n\nBehavior:\n\n" + behavior + "\n\n" +
  "Return ONLY the " + display + " source: no markdown fences, no explanation, no tests, no entry point."
}

fn user_prompt(p: Plugin, t: PTask) -> String =
  prompt_body(p.display, signatures(p, t), t.behavior, list.len(t.sigs) == 1)

// The language-independent half of a prompt: the same template, the same
// behavior text and the neutral signature, with the language name left as a
// placeholder. Hashing it pins what every language's prompt shares — a
// changed behavior text moves this hash, a changed plugin does not.
fn neutral_prompt(t: PTask) -> String =
  prompt_body("<Language>", t.sigs |> list.map((sg) => "    " + spec.sig_neutral(sg)) |> string.join("\n"), t.behavior, list.len(t.sigs) == 1)

fn retry_prompt(display: String, original: String, prev_code: String, diag: String) -> String =
  "Original task:\n\n" + original + "\n\n" +
  "You previously wrote this code:\n\n" + prev_code + "\n\n" +
  "It failed to compile or test. Diagnostic output:\n\n" + diag + "\n\n" +
  "Fix the code and return ONLY the corrected " + display + " source. No markdown fences, no explanation."

fn clip(s: String) -> String =
  if string.len(s) <= DIAG_LIMIT then s
  else string.take(s, DIAG_LIMIT) + "\n... [diagnostic truncated at " + int.to_string(DIAG_LIMIT) + " characters]"

// ── Toolchain probe ──

type Probe = { plugin: Plugin, available: Bool, missing: String, versions: List[(String, String)] }

effect fn probe_one(p: Plugin) -> Probe = {
  let found = p.versions |> list.map(((label, cmd)) => {
    let exe = list.first(cmd) ?? label
    let args = list.drop(cmd, 1)
    match process.exec_status(exe, args) {
      ok(st) => if st.code == 0 then (label, (string.trim(st.stdout + st.stderr) |> string.split("\n") |> list.first) ?? "")
        else (label, ""),
      err(_) => (label, ""),
    }
  })
  match list.find(found, ((_, v)) => v == "") {
    some((label, _)) => Probe { plugin: p, available: false, missing: label, versions: [] },
    none => Probe { plugin: p, available: true, missing: "", versions: found },
  }
}

effect fn probe_all(names: List[String]) -> List[Probe]! = {
  let known = plugins.names()
  let unknown = names |> list.filter((n) => not list.contains(known, n))
  guard list.is_empty(unknown) else err("unknown language(s): " + string.join(unknown, ", ") + " (known: " + string.join(known, ", ") + ")")
  let chosen = plugins.all() |> list.filter((p) => list.is_empty(names) or list.contains(names, p.name))
  ok((chosen |> list.map((p) => probe_one(p)!))!)
}

fn toolchain_line(pr: Probe) -> String =
  if pr.available then pr.versions |> list.map(((_, v)) => v) |> string.join("; ")
  else "not measured: " + pr.missing + " missing"

// ── One attempt: write the files, run the steps ──

type StepOut = { kind: String, code: Int, output: String }

type LAttempt = { code: String, kind: String, diagnostic: String, passed: Bool }

// One cell of the planned (task x language) grid. `attempts` empty means the
// model was never answered for this cell, and `reason` then says why — a
// cell with no attempts is NEVER a zero, it is a typed absence (see the cell
// vocabulary below).
type LResult = { language: String, condition: String, task: String, success: Bool, retries: Int, attempts: List[LAttempt], reason: String }

effect fn write_files(dir: String, files: List[(String, String)]) -> Unit! = {
  let _written = (files |> list.map(((rel, content)) => {
    let full = dir + "/" + rel
    fs.mkdir_p(path.dirname(full))!
    fs.write(full, content)!
  }))!
  ok(())
}

effect fn run_step(dir: String, st: Step) -> StepOut = {
  // `sh -c 'cd "$0" && exec "$@"' <dir> <cmd> <args...>`: the step runs in
  // the attempt's directory; exec_status_timeout has no cwd parameter.
  let args = ["-c", "cd \"$0\" && exec \"$@\"", dir, st.cmd] + st.args
  match process.exec_status_timeout("sh", args, st.timeout_ms) {
    ok(r) => StepOut { kind: st.kind, code: r.code, output: r.stdout + r.stderr },
    err(e) => StepOut { kind: st.kind, code: -1, output: e },
  }
}

effect fn run_steps(dir: String, steps: List[Step]) -> StepOut = match steps {
  [] => StepOut { kind: "", code: 0, output: "" },
  [st, ..rest] => {
    let out = run_step(dir, st)!
    if out.code != 0 then out else if list.is_empty(rest) then out else run_steps(dir, rest)!
  },
}

// The verdict: every step exits 0 AND the driver printed its sentinel.
effect fn judge(p: Plugin, t: PTask, dir: String, code: String) -> LAttempt! = {
  write_files(dir, p.files(t, code))!
  let out = run_steps(dir, p.steps)!
  let n = list.len(t.cases)
  if out.code != 0 then
    ok(LAttempt { code: code, kind: out.kind, diagnostic: out.output, passed: false })
  else if string.contains(out.output, spec.sentinel(n)) then
    ok(LAttempt { code: code, kind: "", diagnostic: "", passed: true })
  else
    ok(LAttempt { code: code, kind: "driver", diagnostic: "the driver exited 0 without reporting its cases:\n" + out.output, passed: false })
}

effect fn write_log(dir: String, a: LAttempt) -> Unit =
  match fs.write(dir + "/attempt.log", (if a.passed then "PASS\n" else "FAIL (" + a.kind + ")\n") + a.diagnostic) {
    ok(_) => (),
    err(_) => (),
  }

// ── Fix loop ──

effect fn fix_loop(p: Plugin, cond: String, t: PTask, model: String, raw_dir: String, retries: Int, attempt: Int, last: LAttempt, acc: List[LAttempt]) -> LResult! = {
  if attempt > retries then
    ok(LResult { language: p.name, condition: cond, task: t.name, success: false, retries: retries, attempts: acc, reason: "" })
  else {
    let original = user_prompt(p, t)
    let prompt = if attempt == 0 then original else retry_prompt(p.display, original, last.code, clip(last.diagnostic))
    let code = llm.call(model, system_prompt(p), prompt, TEMPERATURE, TRANSPORT_ATTEMPTS)!
    let dir = raw_dir + "/" + p.name + "/" + t.name + "/" + int.to_string(attempt)
    fs.mkdir_p(dir)!
    let a = judge(p, t, dir, code)!
    write_log(dir, a)!
    let acc2 = acc + [a]
    println("    " + p.name + (if cond == COND_SHIPPED then "" else " [" + cond + "]") + " / " + t.name + " attempt " + int.to_string(attempt) + ": " + (if a.passed then "pass" else "FAIL (" + a.kind + ")"))
    if a.passed then ok(LResult { language: p.name, condition: cond, task: t.name, success: true, retries: attempt, attempts: acc2, reason: "" })
    else fix_loop(p, cond, t, model, raw_dir, retries, attempt + 1, a, acc2)
  }
}

// Task-major: for Almide, each task's A cell and then its B cell, so the two
// arms of the effect A/B are measured minutes apart rather than hours.
// A non-shipped leg writes its raw attempts under raw/<condition>/.
effect fn run_language(pr: Probe, conditions: List[String], tasks: List[PTask], model: String, raw_dir: String, retries: Int) -> List[LResult] =
  tasks |> list.flat_map((t) => legs_for(pr.plugin, conditions) |> list.map(((cond, p)) => {
    let empty = LAttempt { code: "", kind: "", diagnostic: "", passed: false }
    let dir = if cond == COND_SHIPPED then raw_dir else raw_dir + "/" + cond
    match fix_loop(p, cond, t, model, dir, retries, 0, empty, []) {
      ok(r) => r,
      err(e) => {
        // A harness failure (no key, network) is a result with no attempts:
        // the cell is `not-run`, never a model failure and never a zero. The
        // reason travels with the cell so the grid says WHY it is absent.
        println("    " + pr.plugin.name + " / " + t.name + ": harness error: " + e)
        LResult { language: pr.plugin.name, condition: cond, task: t.name, success: false, retries: 0, attempts: [], reason: e }
      },
    }
  }))

// ── Cell states and the run verdict ──
//
// The planned grid is `tasks x languages`, and EVERY cell of it carries
// exactly one of four states — the vocabulary almide/almide#1963 item 4 asks
// for. The four partition the grid: measured + not-run + harness-limitation
// + inconclusive-saturated = planned cells, always.
//
// The vocabulary itself, the saturation threshold, the interval rate and the
// verdict decision table live in src/cellstate.almd, because the daily lane
// speaks the SAME four states over its own `tasks x one model` grid
// (almide-dojo#17) and two copies of a vocabulary is how two lanes stop
// meaning the same thing by it. What stays here is this lane's own shape —
// an LResult is a (language, task) cell — and this lane's own verdict prose.
let ST_MEASURED = cellstate.ST_MEASURED
let ST_SATURATED = cellstate.ST_SATURATED
let ST_NOT_RUN = cellstate.ST_NOT_RUN
let ST_HARNESS = cellstate.ST_HARNESS
let CELL_STATES = cellstate.CELL_STATES
let SATURATION_PCT = cellstate.SATURATION_PCT

fn reached(results: List[LResult]) -> List[LResult] =
  results |> list.filter((r) => not list.is_empty(r.attempts))

// This lane's stratum for almide-dojo#3's saturation rule is a language: the
// run is at the bank's ceiling when EVERY language is.
fn is_saturated(results: List[LResult]) -> Bool = {
  let got = reached(results)
  let langs = got |> list.map((r) => r.language) |> list.unique
  not list.is_empty(got) and list.all(langs, (l) => {
    let mine = got |> list.filter((r) => r.language == l)
    cellstate.saturated_series(list.count(mine, (r) => r.success), list.len(mine))
  })
}

fn state_of(available: Bool, r: LResult, saturated: Bool) -> String =
  cellstate.state_of(available, not list.is_empty(r.attempts), saturated)

fn count_state(cells: List[LResult], probes: List[Probe], saturated: Bool, want: String) -> Int =
  list.count(cells, (r) => state_of(probe_available(probes, r.language), r, saturated) == want)

fn probe_available(probes: List[Probe], name: String) -> Bool =
  match list.find(probes, (pr) => pr.plugin.name == name) {
    some(pr) => pr.available,
    none => false,
  }

// The complete grid: one LResult per (language, task), synthesising the cells
// the run never produced — a language with no toolchain has no results at
// all, and leaving its row out of results.json is the same silence as
// printing a 0.
fn full_grid(probes: List[Probe], tasks: List[PTask], results: List[LResult]) -> List[LResult] =
  probes |> list.flat_map((pr) => tasks |> list.map((t) =>
    match list.find(results, (r) => r.language == pr.plugin.name and r.condition == COND_SHIPPED and r.task == t.name) {
      some(r) => r,
      none => LResult {
        language: pr.plugin.name, condition: COND_SHIPPED, task: t.name, success: false, retries: 0, attempts: [],
        reason: if pr.available then "the lane recorded no result for this cell"
          else pr.missing + " is not on this machine",
      },
    }))

// ── The effect-declaration A/B: its own grid and its own verdict ──
//
// The A arm is the shipped Almide row of the cross-language grid (the same
// cells, not a second copy); the B arm is one Almide cell per planned task per
// extra condition, synthesised like full_grid when the run never produced it.
fn shipped_cells(cells: List[LResult]) -> List[LResult] =
  cells |> list.filter((r) => r.condition == COND_SHIPPED)

fn condition_grid(probes: List[Probe], tasks: List[PTask], results: List[LResult], cond: String) -> List[LResult] = {
  let alm = list.find(probes, (pr) => pr.plugin.name == "almide")
  tasks |> list.map((t) =>
    match list.find(results, (r) => r.language == "almide" and r.condition == cond and r.task == t.name) {
      some(r) => r,
      none => LResult {
        language: "almide", condition: cond, task: t.name, success: false, retries: 0, attempts: [],
        reason: match alm {
          some(pr) => if pr.available then "the lane recorded no result for this cell" else pr.missing + " is not on this machine",
          none => "almide is not among this run's languages",
        },
      },
    })
}

fn almide_arm(cells: List[LResult], cond: String) -> List[LResult] =
  cells |> list.filter((r) => r.language == "almide" and r.condition == cond)

// The same decision table as the run verdict, over two series (A and B):
// both arms must have reached every planned task, and both arms at the
// bank's ceiling is a comparison that separates nothing.
fn ab_verdict(planned: Int, a: List[LResult], b: List[LResult], b_name: String) -> Verdict = {
  let ra = reached(a)
  let rb = reached(b)
  let any_reached = not list.is_empty(ra) and not list.is_empty(rb)
  let complete = list.len(ra) == planned and list.len(rb) == planned
  let saturated = cellstate.saturated_series(list.count(ra, (r) => r.success), list.len(ra)) and
    cellstate.saturated_series(list.count(rb, (r) => r.success), list.len(rb))
  let reasons =
    if not any_reached then ["an arm reached no task: " + COND_SHIPPED + " " + int.to_string(list.len(ra)) + ", " + b_name + " " + int.to_string(list.len(rb)) + " of " + int.to_string(planned)]
    else if not complete then
      ["the two arms saw different task counts, so their rates share no denominator: " + COND_SHIPPED + " " +
        int.to_string(list.len(ra)) + "/" + int.to_string(planned) + ", " + b_name + " " + int.to_string(list.len(rb)) + "/" + int.to_string(planned)]
    else if saturated then ["both arms are at the bank's ceiling, so no task separates them (almide-dojo#3)"]
    else []
  cellstate.verdict(any_reached, complete, saturated, reasons)
}

fn arm_saturated(a: List[LResult], b: List[LResult]) -> Bool = {
  let ra = reached(a)
  let rb = reached(b)
  cellstate.saturated_series(list.count(ra, (r) => r.success), list.len(ra)) and
    cellstate.saturated_series(list.count(rb, (r) => r.success), list.len(rb))
}

let AB_WHAT = [
  (COND_SHIPPED, "the Almide notes as every run sends them, which teach the effect discipline"),
  (COND_UNMENTIONED, "the same notes with every effect sentence removed (prompts.without_effect_notes); signatures, user prompt, retry prompt, model, sampling and the compiler unchanged"),
]

fn what_of(cond: String) -> String =
  match list.find(AB_WHAT, ((c, _)) => c == cond) {
    some((_, w)) => w,
    none => "",
  }

// The shipped lines this condition removed or cut, verbatim, so a reader of the manifest does not have to
// trust the condition's name.
fn removed_lines(a: String, b: String) -> List[String] = {
  let lb = string.split(b, "\n")
  string.split(a, "\n") |> list.filter((l) => not list.contains(lb, l)) |> list.map(string.trim)
}

fn arm_json(cells: List[LResult], planned: Int) -> Value = {
  let got = reached(cells)
  value.object([
    ("reached", value.int(list.len(got))),
    ("passed", value.int(list.count(got, (r) => r.success))),
    ("one_shot", value.int(list.count(got, (r) => r.success and r.retries == 0))),
    ("retries", value.int(got |> list.map((r) => r.retries) |> list.sum)),
    ("final_pass", value.str(rate(list.count(got, (r) => r.success), planned - list.len(got), planned))),
  ])
}

// Every condition the run PLANNED, with what it changes and on which
// languages, and the prompt hashes of the Almide notes it sent.
fn conditions_json(conditions: List[String], probes: List[Probe], tasks: List[PTask]) -> Value = {
  let extra = extra_conditions(conditions, probes)
  let planned = [COND_SHIPPED] + extra
  let alm = list.find(probes, (pr) => pr.plugin.name == "almide")
  value.array(planned |> list.map((c) => {
    let langs = if c == COND_SHIPPED then probes |> list.map((pr) => pr.plugin.name) else ["almide"]
    let base = [
      ("name", value.str(c)),
      ("issue", value.str("almide-dojo#2")),
      ("languages", value.array(langs |> list.map(value.str))),
      ("almide_notes", value.str(what_of(c))),
      ("effect_enforcement", value.str("unchanged: the pinned compiler judges every arm (it has no switch that relaxes effect errors to warnings)")),
    ]
    let hashes = match alm {
      some(pr) => {
        let p = plugin_for(pr.plugin, c)
        [("almide_prompts", prompt_hashes({ ...pr, plugin: p }, tasks))] +
          (if c == COND_SHIPPED then [] else [("notes_lines_changed", value.array(removed_lines(pr.plugin.notes, p.notes) |> list.map(value.str)))])
      },
      none => [],
    }
    value.object(base + hashes)
  }))
}

// The A/B's own record: null when the run planned no B arm.
fn ab_json(conditions: List[String], probes: List[Probe], tasks: List[PTask], a_cells: List[LResult], b_cells: List[LResult]) -> Value =
  match list.first(extra_conditions(conditions, probes)) {
    none => value.null(),
    some(b) => {
      let planned = list.len(tasks)
      let a = almide_arm(a_cells, COND_SHIPPED)
      let bb = almide_arm(b_cells, b)
      let v = ab_verdict(planned, a, bb, b)
      value.object([
        ("issue", value.str("almide-dojo#2")),
        ("language", value.str("almide")),
        ("a", value.str(COND_SHIPPED)),
        ("b", value.str(b)),
        ("planned_tasks", value.int(planned)),
        ("verdict", value.object([
          ("id", value.str(v.id)),
          ("comparable", value.bool(v.comparable)),
          ("conclusive", value.bool(v.conclusive)),
          ("reasons", value.array(v.reasons |> list.map(value.str))),
        ])),
        (COND_SHIPPED, arm_json(a, planned)),
        (b, arm_json(bb, planned)),
      ])
    },
  }

fn ab_cell(r: LResult) -> String =
  if list.is_empty(r.attempts) then ST_NOT_RUN
  else if r.success then (if r.retries == 0 then "pass" else "pass@" + int.to_string(r.retries))
  else "FAIL"

fn ab_row(cond: String, cells: List[LResult], planned: Int) -> String = {
  let got = reached(cells)
  let absent = planned - list.len(got)
  "| Almide · `" + cond + "` | " + what_of(cond) + " | " + int.to_string(list.len(got)) + "/" + int.to_string(planned) + " | " +
    rate(list.count(got, (r) => r.success), absent, planned) + " | " +
    rate(list.count(got, (r) => r.success and r.retries == 0), absent, planned) + " | " +
    int.to_string(got |> list.map((r) => r.retries) |> list.sum) + " |"
}

// The A/B section of table.md: its own verdict first, then the two arms side
// by side, then per task. "" when the run planned no B arm.
fn render_ab(conditions: List[String], probes: List[Probe], tasks: List[PTask], a_cells: List[LResult], b_cells: List[LResult]) -> String =
  match list.first(extra_conditions(conditions, probes)) {
    none => "",
    some(b) => {
      let planned = list.len(tasks)
      let a = almide_arm(a_cells, COND_SHIPPED)
      let bb = almide_arm(b_cells, b)
      let v = ab_verdict(planned, a, bb, b)
      let find_in = (xs: List[LResult], t: String) => match list.find(xs, (r) => r.task == t) {
        some(r) => ab_cell(r),
        none => ST_NOT_RUN,
      }
      "\n## Effect-declaration A/B (almide-dojo#2) — Almide only\n\n" +
        "> **A/B verdict: `" + v.id + "`** — certified as a comparison: **" + (if v.comparable then "yes" else "no") +
        "**; the bank discriminated: **" + (if v.conclusive then "yes" else "no") + "**\n" +
        (v.reasons |> list.map((r) => "> - " + r + "\n") |> string.join("")) + "\n" +
        "Arm A is the Almide row above (the same cells). Arm B re-asks the same " + int.to_string(planned) +
        " tasks with the only change being the Almide notes; the pinned compiler still enforces effects in both arms, and the other languages have no effect system to remove.\n\n" +
        "| arm | what the model is told | reached | final pass (of " + int.to_string(planned) + ") | 1-shot (of " + int.to_string(planned) + ") | retries |\n|---|---|---|---|---|---|\n" +
        ab_row(COND_SHIPPED, a, planned) + "\n" + ab_row(b, bb, planned) + "\n\n" +
        "| task | `" + COND_SHIPPED + "` | `" + b + "` |\n|---|---|---|\n" +
        (tasks |> list.map((t) => "| `" + t.name + "` | " + find_in(a, t.name) + " | " + find_in(bb, t.name) + " |") |> string.join("\n")) + "\n"
    },
  }

fn reached_by(name: String, results: List[LResult]) -> Int =
  list.count(results, (r) => r.language == name and not list.is_empty(r.attempts))

let SATURATED_REASON =
  "every language reached " + int.to_string(SATURATION_PCT) + "% or better of the cells it measured, so no cell " +
  "separates one language from another and the table is not evidence of anything about the languages " +
  "(INCONCLUSIVE_BANK_SATURATED, almide-dojo#3 / almide/almide#1963 — the bank is at its ceiling; " +
  "rebuilding it is that issue's work, saying so is this one's)"

// `attempted` is (name, display) for the languages whose toolchain was on the
// machine — the only rows that are part of the comparison at all.
fn verdict_core(attempted: List[(String, String)], planned: Int, results: List[LResult]) -> Verdict = {
  let saturated = is_saturated(results)
  let short = attempted |> list.filter_map(((name, display)) => {
    let n = reached_by(name, results)
    if n == planned then none
    else some(display + " " + int.to_string(n) + "/" + int.to_string(planned))
  })
  let sat = if saturated then [SATURATED_REASON] else []
  let any_reached = not list.is_empty(reached(results))
  let complete = list.is_empty(short)
  // The decision table is shared with the daily lane; the reasons are this
  // lane's own words, because "the languages saw different task counts" and
  // "three planned tasks were never asked" are different sentences.
  let reasons =
    if not any_reached then ["no cell reached the model: nothing was measured"]
    else if not complete then
      ["the languages saw different task counts, so their rates share no denominator and this run is not a comparison: " +
        string.join(short, ", ") + " of " + int.to_string(planned) + " planned"] + sat
    else sat
  cellstate.verdict(any_reached, complete, saturated, reasons)
}

fn verdict_of(probes: List[Probe], tasks: List[PTask], results: List[LResult]) -> Verdict =
  verdict_core(
    probes |> list.filter((pr) => pr.available) |> list.map((pr) => (pr.plugin.name, pr.plugin.display)),
    list.len(tasks), results)

fn verdict_headline(v: Verdict) -> String = match v.id {
  "comparable" => "every language saw the same complete task set, and the bank discriminated",
  "inconclusive-saturated" => "a valid comparison that separates nothing: do not quote this table as evidence",
  "not-comparable" => "this run is not a comparison and must not be quoted as one",
  _ => "no cell reached the model",
}

fn verdict_block(v: Verdict) -> String = cellstate.verdict_block(v, verdict_headline(v))

fn verdict_json(v: Verdict, planned: Int, cells: List[LResult], probes: List[Probe]) -> Value = {
  let saturated = is_saturated(cells)
  value.object([
    ("id", value.str(v.id)),
    ("comparable", value.bool(v.comparable)),
    ("conclusive", value.bool(v.conclusive)),
    ("planned_tasks", value.int(planned)),
    ("planned_cells", value.int(list.len(cells))),
    // The four states partition the planned cells; a reader can add them up.
    ("cells", value.object(CELL_STATES |> list.map((s) => (s, value.int(count_state(cells, probes, saturated, s)))))),
    ("reasons", value.array(v.reasons |> list.map(value.str))),
  ])
}

// ── Manifest ──

effect fn git_head() -> String =
  match process.exec("git", ["rev-parse", "HEAD"]) {
    ok(s) => string.trim(s),
    err(_) => "",
  }

effect fn git_dirty() -> Bool =
  match process.exec("git", ["status", "--porcelain", "--", "src", "msr", "tasks"]) {
    ok(s) => string.trim(s) != "",
    err(_) => false,
  }

effect fn compiler_pin() -> String = {
  let raw = fs.read_text("almide-pin.toml") ?? ""
  string.split(raw, "\n")
    |> list.filter_map((l) => {
      let t = string.trim(l)
      if string.starts_with(t, "ref") then
        match string.index_of(t, "\"") {
          some(i) => {
            let after = string.drop(t, i + 1)
            match string.index_of(after, "\"") {
              some(j) => some(string.take(after, j)),
              none => none,
            }
          },
          none => none,
        }
      else none
    })
    |> list.first
    |> option.unwrap_or_else(() => "")
}

fn prompt_hashes(pr: Probe, tasks: List[PTask]) -> Value = {
  let sys = system_prompt(pr.plugin)
  let all = tasks |> list.map((t) => user_prompt(pr.plugin, t)) |> string.join("\n--\n")
  value.object([
    ("system_sha256", value.str(hash.sha256_hex(sys))),
    ("prompts_sha256", value.str(hash.sha256_hex(sys + "\n--\n" + all))),
    ("notes_bytes", value.int(string.len(pr.plugin.notes))),
  ])
}

fn language_entry(pr: Probe, tasks: List[PTask]) -> Value = {
  let base = [("name", value.str(pr.plugin.name)), ("measured", value.bool(pr.available))]
  if pr.available then
    value.object(base + [
      ("toolchain", value.object(pr.versions |> list.map(((k, v)) => (k, value.str(v))))),
      ("prompts", prompt_hashes(pr, tasks)),
      ("steps", value.array(pr.plugin.steps |> list.map((s) => value.str(s.cmd + " " + string.join(s.args, " "))))),
    ])
  else value.object(base + [("reason", value.str(pr.missing + " missing"))])
}

// The HTTP read timeout this process ran under, as the manifest must state
// it: a cell is `not-run` BECAUSE some deadline expired, so the deadline is
// part of the run's identity. "" = the compiler's own default.
effect fn http_timeout_secs() -> String = env.get("ALMIDE_HTTP_TIMEOUT_SECS") ?? ""

effect fn manifest(o: Opts, date: String, probes: List[Probe], tasks: List[PTask], task_set_sha: String, v: Verdict, cells: List[LResult], ab_cells: List[LResult], sampling: List[(String, Value)]) -> Value = {
  let provider = llm.provider_of(o.model)
  value.object([
    ("verdict", verdict_json(v, list.len(tasks), cells, probes)),
    ("lane", value.str("cross-language")),
    ("label", value.str(o.label)),
    ("date", value.str(date)),
    ("harness", value.object([
      ("repo", value.str("almide/almide-dojo")),
      ("commit", value.str(git_head()!)),
      ("dirty", value.bool(git_dirty()!)),
    ])),
    ("compiler", value.object([
      ("pin", value.str(compiler_pin()!)),
      ("version", value.str(match process.exec("almide", ["--version"]) { ok(v) => string.trim(list.get(string.split(string.trim(v), "\n"), 0) ?? ""), err(_) => "" })),
    ])),
    // What was ASKED FOR, then what the provider actually wrote into the
    // request body. The second half is `sampling`, measured by a preflight
    // call with these same options — not this harness's opinion of what the
    // provider does. The two can disagree (a provider that ignores the
    // temperature leaves `temperature_sent: false` next to the request
    // below), and a reader deciding whether the run is reproducible needs
    // the wire half, not the asked half.
    ("model", value.object([
      ("spec", value.str(o.model)),
      ("provider", value.str(provider)),
      ("temperature_requested", value.float(TEMPERATURE)),
      ("seed_requested", value.int(llm.SEED)),
      ("transport_attempts", value.int(TRANSPORT_ATTEMPTS)),
      ("http_timeout_secs", value.str(http_timeout_secs()!)),
    ] + sampling)),
    ("retries", value.int(o.retries)),
    // The cross-language grid's condition, then every condition the run
    // planned (almide-dojo#2) and the A/B's own verdict and arms.
    ("condition", value.object([("effects", value.str(COND_SHIPPED))])),
    ("conditions", conditions_json(o.conditions, probes, tasks)),
    ("effect_ab", ab_json(o.conditions, probes, tasks, cells, ab_cells)),
    ("task_set", value.object([
      ("path", value.str(TASK_SET)),
      ("revision", value.str(task_set_revision()!)),
      ("sha256", value.str(task_set_sha)),
      ("tasks", value.array(tasks |> list.map((t) => value.str(t.name)))),
      ("neutral_prompts_sha256", value.str(hash.sha256_hex(tasks |> list.map(neutral_prompt) |> string.join("\n--\n")))),
    ])),
    ("retry_template_sha256", value.str(hash.sha256_hex(retry_prompt("<Language>", "", "", "")))),
    ("languages", value.array(probes |> list.map((pr) => language_entry(pr, tasks)))),
  ])
}

// ── Results and table ──

fn result_json(r: LResult, state: String) -> Value =
  value.object([
    ("language", value.str(r.language)),
    ("condition", value.str(r.condition)),
    ("task", value.str(r.task)),
    ("state", value.str(state)),
    ("success", value.bool(r.success)),
    ("retries", value.int(r.retries)),
    ("reason", value.str(r.reason)),
    ("attempts", value.array(r.attempts |> list.map((a) => value.object([
      ("passed", value.bool(a.passed)),
      ("kind", value.str(a.kind)),
      ("diagnostic_head", value.str(string.take(a.diagnostic, 200))),
    ])))),
  ])

// The rate a row publishes, and its denominator, are the shared ones: the
// planned task count always, and an interval whenever a cell is absent.
fn rate(passed: Int, absent: Int, planned: Int) -> String =
  cellstate.rate(passed, absent, planned)

fn language_row(pr: Probe, tasks: List[PTask], results: List[LResult]) -> String = {
  let planned = list.len(tasks)
  let mine = results |> list.filter((r) => r.language == pr.plugin.name and r.condition == COND_SHIPPED)
  let dash = int.to_string(planned)
  if not pr.available then
    "| " + pr.plugin.display + " | — | 0/" + dash + " | " + dash + " harness-limitation | " +
      "not measured: " + pr.missing + " missing | — | — |"
  else {
    let got = mine |> list.filter((r) => not list.is_empty(r.attempts))
    let total = list.len(got)
    let absent = planned - total
    let passed = list.count(got, (r) => r.success)
    let one_shot = list.count(got, (r) => r.success and r.retries == 0)
    let retries = got |> list.map((r) => r.retries) |> list.sum
    "| " + pr.plugin.display + " | " + toolchain_line(pr) + " | " +
      int.to_string(total) + "/" + dash + " | " +
      (if absent == 0 then "0" else int.to_string(absent) + " not-run") + " | " +
      rate(passed, absent, planned) + " | " +
      rate(one_shot, absent, planned) + " | " + int.to_string(retries) + " |"
  }
}

fn task_row(t: PTask, probes: List[Probe], results: List[LResult], saturated: Bool) -> String = {
  let cells = probes |> list.map((pr) =>
    match list.find(results, (r) => r.language == pr.plugin.name and r.condition == COND_SHIPPED and r.task == t.name) {
      none => ST_NOT_RUN,
      some(r) => match state_of(pr.available, r, saturated) {
        "harness-limitation" => "n/t",
        "not-run" => ST_NOT_RUN,
        _ => if r.success then (if r.retries == 0 then "pass" else "pass@" + int.to_string(r.retries)) else "FAIL",
      },
    })
  "| `" + t.name + "` | " + string.join(cells, " | ") + " |"
}

fn render_table(o: Opts, date: String, revision: String, probes: List[Probe], tasks: List[PTask], results: List[LResult], ab_cells: List[LResult], v: Verdict) -> String = {
  let label = if o.label == "" then "" else " [" + o.label + "]"
  let planned = int.to_string(list.len(tasks))
  let saturated = is_saturated(results)
  // The verdict comes FIRST, above the numbers: what a reader carries away
  // from a table is the number, so a caveat below it does not travel.
  let head = "# MSR cross-language run " + date + label + "\n\n" +
    verdict_block(v) +
    "- **model**: `" + o.model + "`\n" +
    "- **planned tasks**: " + planned + " (msr/task-set.json rev " + revision + ") — every rate below has this as its denominator\n" +
    "- **retries**: " + int.to_string(o.retries) + "\n" +
    "- **conditions**: `" + COND_SHIPPED + "` (every language)" +
      (extra_conditions(o.conditions, probes) |> list.map((c) => ", `" + c + "` (Almide only — the effect-declaration A/B below)") |> string.join("")) + "\n" +
    "- **manifest**: manifest.json next to this file (`verdict`, and the per-cell states in results.json)\n\n"
  let summary = "| language | toolchain | reached | absent | final pass (of " + planned + ") | 1-shot (of " + planned + ") | retries |\n|---|---|---|---|---|---|---|\n" +
    (probes |> list.map((pr) => language_row(pr, tasks, results)) |> string.join("\n")) + "\n"
  let per_task = "\n## Per task\n\n| task | " + (probes |> list.map((pr) => pr.plugin.display) |> string.join(" | ")) + " |\n" +
    "|---|" + (probes |> list.map((_) => "---|") |> string.join("")) + "\n" +
    (tasks |> list.map((t) => task_row(t, probes, results, saturated)) |> string.join("\n")) + "\n\n" +
    "Cell states (almide/almide#1963): `pass` / `pass@N` / `FAIL` = `" +
    (if saturated then ST_SATURATED + "` (every measured cell in this run passed, so no cell discriminates)" else ST_MEASURED + "`") +
    "; `not-run` = planned, but the model was never answered (see `reason` in results.json); " +
    "`n/t` = `harness-limitation`, the toolchain is not on this machine. " +
    "A rate printed as `a–b%` has `not-run` cells: the true rate is somewhere in that interval, and the row is not comparable with a complete one.\n"
  head + summary + per_task + render_ab(o.conditions, probes, tasks, results, ab_cells)
}

// ── Commands ──

effect fn cmd_probe(o: Opts) -> Unit! = {
  let probes = probe_all(o.languages)!
  println("| language | toolchain |\n|---|---|")
  probes |> list.map((pr) => println("| " + pr.plugin.display + " | " + toolchain_line(pr) + " |"))
  ok(())
}

effect fn cmd_prompt(o: Opts) -> Unit! = {
  let lang = list.get(o.rest, 1) ?? ""
  let task = list.get(o.rest, 2) ?? ""
  let cond = list.get(o.rest, 3) ?? COND_SHIPPED
  guard list.contains(CONDITIONS, cond) else err("unknown condition `" + cond + "` (known: " + string.join(CONDITIONS, ", ") + ")")
  match plugins.find(lang) {
    none => {
      println("unknown language: " + lang)
      process.exit(1)
    },
    some(p0) => {
      let p = plugin_for(p0, cond)
      let t = load_task(task)!
      println("=== system ===\n" + system_prompt(p) + "\n\n=== user ===\n" + user_prompt(p, t))
      ok(())
    },
  }
}

effect fn cmd_run(o: Opts) -> Unit! = {
  guard o.model != "" else {
    println("usage: almide run src/msr/run.almd -- run <provider:model> [options]")
    process.exit(2)
  }
  let tasks = load_tasks(o.tasks)!
  let probes = probe_all(o.languages)!
  let available = probes |> list.filter((pr) => pr.available)
  probes |> list.map((pr) => println((if pr.available then "measuring " else "skipping  ") + pr.plugin.display + ": " + toolchain_line(pr)))
  guard not list.is_empty(available) else {
    println("no plugin has its toolchain: nothing to measure")
    process.exit(2)
  }
  // Preflight: ask the provider, with this run's own options, what it put on
  // the wire. The answer goes into the manifest, so the table reports its own
  // reproducibility instead of this harness guessing on the provider's
  // behalf. A dead key or an unknown model name also fails HERE, before a
  // single task has been scored 0 against an empty completion.
  let sampling = llm.probe_sampling(o.model, TEMPERATURE)!
  let date = datetime.format(env.unix_timestamp(), "%Y-%m-%d")
  let dir = run_dir(o.out, date, o.model, o.label)
  let raw_dir = dir + "/raw"
  fs.mkdir_p(raw_dir)!
  println("")
  println("Running " + int.to_string(list.len(tasks)) + " task(s) x " + int.to_string(list.len(available)) + " language(s) against " + o.model)
  let results = (available |> list.flat_map((pr) => {
    println("== " + pr.plugin.display + " ==")
    run_language(pr, o.conditions, tasks, o.model, raw_dir, o.retries)!
  }))!
  let measured = results |> list.filter((r) => not list.is_empty(r.attempts))
  guard not list.is_empty(measured) else {
    println("Harness error: no task reached the model; nothing written")
    process.exit(2)
  }
  let task_set_sha = hash.sha256_hex(fs.read_text(TASK_SET) ?? "")
  // The full planned grid, not just the cells the run produced: a language
  // with no toolchain has no results at all, and omitting its row is the same
  // silence as printing a 0.
  let cells = full_grid(probes, tasks, results)
  let saturated = is_saturated(cells)
  let v = verdict_of(probes, tasks, cells)
  // The effect A/B's B arm(s): Almide cells under every extra condition. They
  // never enter `cells`, so the cross-language verdict is the same with or
  // without the A/B.
  let ab_cells = extra_conditions(o.conditions, probes) |> list.flat_map((c) => condition_grid(probes, tasks, results, c))
  let ab_sat = arm_saturated(almide_arm(cells, COND_SHIPPED), ab_cells)
  let m = manifest(o, date, probes, tasks, task_set_sha, v, cells, ab_cells, sampling)!
  fs.write(dir + "/manifest.json", json.stringify_pretty(m) + "\n")!
  fs.write(dir + "/results.json", json.stringify_pretty(value.object([
    ("results", value.array(
      (cells |> list.map((r) => result_json(r, state_of(probe_available(probes, r.language), r, saturated)))) +
      (ab_cells |> list.map((r) => result_json(r, state_of(probe_available(probes, r.language), r, ab_sat)))))),
  ])) + "\n")!
  let table = render_table(o, date, task_set_revision()!, probes, tasks, cells, ab_cells, v)
  fs.write(dir + "/table.md", table)!
  println("")
  println(table)
  println("Written: " + dir + "/{manifest.json, results.json, table.md}")
  let failed = list.count(measured, (r) => not r.success)
  if failed > 0 then process.exit(1) else ok(())
}

// ── verdict: re-derive a written run's verdict from its own artifacts ──
//
// The lane stamps the verdict when it writes the run; this re-derives it from
// manifest.json + results.json and refuses a run that is not a comparison.
// Keeping it a separate command means the refusal can be re-run over any
// committed run, forever, without a model call — and that a run written
// before the verdict existed can still be judged.
//
// Exit: 0 comparable (certified), 1 not comparable, 2 unreadable or a stamped
// verdict that disagrees with the re-derived one.
// Only a cell's EMPTINESS and its outcome decide a verdict, so a re-read
// keeps one stub per non-empty attempt list rather than re-materialising the
// sources — results.json never carried them.
fn attempt_stub() -> LAttempt = LAttempt { code: "", kind: "", diagnostic: "", passed: false }

effect fn read_cells(dir: String) -> List[LResult]! = {
  let v = json.parse(fs.read_text(dir + "/results.json")!)!
  let items = json.get_array(v, "results") ?? []
  ok(items |> list.map((it) => LResult {
    language: json.get_string(it, "language") ?? "",
    // A run written before the A/B existed has no field: its cells are all shipped.
    condition: json.get_string(it, "condition") ?? COND_SHIPPED,
    task: json.get_string(it, "task") ?? "",
    success: json.get_bool(it, "success") ?? false,
    retries: json.get_int(it, "retries") ?? 0,
    attempts: if list.is_empty(json.get_array(it, "attempts") ?? []) then [] else [attempt_stub()],
    reason: json.get_string(it, "reason") ?? "",
  }))
}

effect fn cmd_verdict(o: Opts) -> Unit! = {
  let dir = list.get(o.rest, 1) ?? ""
  guard dir != "" else err("usage: almide run src/msr/run.almd -- verdict <run-dir>")
  let m = json.parse(fs.read_text(dir + "/manifest.json")!)!
  let attempted = (json.get_array(m, "languages") ?? [])
    |> list.filter((l) => json.get_bool(l, "measured") ?? false)
    |> list.map((l) => {
      let n = json.get_string(l, "name") ?? ""
      (n, match plugins.find(n) { some(p) => p.display, none => n })
    })
  let planned = match json.get_path(m, json.field(json.root(), "task_set")) {
    some(ts) => list.len(json.get_array(ts, "tasks") ?? []),
    none => 0,
  }
  let stamped = match json.get_path(m, json.field(json.root(), "verdict")) {
    some(vd) => json.get_string(vd, "id") ?? "",
    none => "",
  }
  // The cross-language verdict is over the shipped grid only: the A/B's B arm
  // is Almide cells under another condition and is judged on its own below.
  let all_cells = read_cells(dir)!
  let cells = shipped_cells(all_cells)
  let v = verdict_core(attempted, planned, cells)
  println("## " + dir)
  println("")
  println(verdict_block(v))
  // A stamped verdict that its own results contradict is worse than no
  // verdict: the artifact would be certifying itself.
  guard stamped == "" or stamped == v.id else {
    println("the manifest is stamped `" + stamped + "` but its own results re-derive `" + v.id + "`")
    process.exit(2)
  }
  if stamped == "" then
    println("(no stamped verdict: this run predates the field, and the id above is re-derived from its results)")
  else ()
  // The A/B is reported, not certified here: it is a second question on the
  // same run, and its own verdict does not decide whether the table stands.
  let b_arms = all_cells |> list.filter((r) => r.condition != COND_SHIPPED) |> list.map((r) => r.condition) |> list.unique
  b_arms |> list.map((b) => {
    let abv = ab_verdict(planned, almide_arm(cells, COND_SHIPPED), almide_arm(all_cells, b), b)
    println("effect A/B (almide-dojo#2) " + COND_SHIPPED + " vs " + b + ": `" + abv.id + "`" +
      (if list.is_empty(abv.reasons) then "" else " — " + string.join(abv.reasons, "; ")))
  })
  if v.comparable then ok(()) else process.exit(1)
}

fn model_slug(model: String) -> String =
  model
    |> string.replace("/", "_")
    |> string.replace(":", "_")
    |> string.replace("@", "")
    |> string.replace(".", "-")

// A LABELLED RUN NEVER SITS WHERE THE MEASUREMENT GOES.
//
// The run directory used to be `<out>/<date>/<model-slug>` and nothing else,
// so two runs of the same model on the same day wrote to the same path and
// the second silently replaced the first. On 2026-09-22 a one-task smoke,
// dispatched to prove the sampling preflight worked, replaced that day's
// 21-task cross-language run — the very table the lane exists to produce.
//
// `--label` already MEANT this: the workflow's own input describes "smoke"
// as marking a run "a pipeline proof, not a number". It was a word in a
// description, enforced by nothing. Putting it in the path is what makes it
// true: an unlabelled run — the measurement — keeps the canonical directory,
// and everything else is beside it, not on top of it.
fn label_slug(label: String) -> String =
  label
    |> string.to_lower
    |> string.replace(" ", "-")
    |> string.replace(",", "")
    |> string.replace("/", "-")
    |> string.replace(":", "-")

fn run_dir(out: String, date: String, model: String, label: String) -> String =
  out + "/" + date + "/" + model_slug(model) +
  (if string.trim(label) == "" then "" else "-" + label_slug(string.trim(label)))

// ── verify: the references through every available plugin, no model ──
//
// Every task must have a reference solution in every language, the
// reference must pass, and the driver must catch a wrong answer (the first
// case's expectation is perturbed and the same reference must then FAIL at
// the run step). This is the offline gate on the task set and the plugins.

fn zero_of(ty: Ty) -> Val = match ty {
  TInt => spec.vint(0),
  TBool => spec.vbool(false),
  TStr => spec.vstr(""),
  TList(_) => spec.vlist([]),
}

// A well-typed value of type `ty` that differs from `v`: a list gains an
// element when empty and has its first element perturbed otherwise.
fn perturb(v: Val, ty: Ty) -> Val = match v {
  VInt(n) => spec.vint(n + 1),
  VBool(b) => spec.vbool(not b),
  VStr(s) => spec.vstr(s + "x"),
  // (spec.perturb_head does the walk: almide 0.62.0 cannot hand a variant's
  // list payload to an owning stdlib call from another module)
  VList(_) => spec.vlist(spec.list_of(v, zero_of(spec.elem(ty)), (x) => perturb(x, spec.elem(ty)))),
  VCall(_, _) => v,
}

fn with_perturbed_first_case(t: PTask) -> PTask = match t.cases {
  [c, ..rest] => { ...t, cases: [{ ...c, expected: perturb(c.expected, spec.case_ty(t.sigs, c)) }] + rest },
  [] => t,
}

effect fn verify_one(pr: Probe, t: PTask, raw_dir: String) -> List[String] = {
  let p = pr.plugin
  let ref_path = "msr/reference/" + p.name + "/" + t.name + "." + p.ext
  match fs.read_text(ref_path) {
    err(_) => [p.name + "/" + t.name + ": no reference at " + ref_path],
    ok(code) => {
      let dir = raw_dir + "/" + p.name + "/" + t.name
      let pos = match (fs.mkdir_p(dir + "/pass"), judge(p, t, dir + "/pass", code)) {
        (ok(_), ok(a)) => if a.passed then [] else [p.name + "/" + t.name + ": reference FAILED (" + a.kind + "):\n" + clip(a.diagnostic)],
        (_, err(e)) => [p.name + "/" + t.name + ": harness error: " + e],
        (err(e), _) => [p.name + "/" + t.name + ": harness error: " + e],
      }
      let neg = match (fs.mkdir_p(dir + "/neg"), judge(p, with_perturbed_first_case(t), dir + "/neg", code)) {
        (ok(_), ok(a)) =>
          if a.passed then [p.name + "/" + t.name + ": the driver did not catch a wrong expectation"]
          else if a.kind != "run" then [p.name + "/" + t.name + ": the perturbed oracle failed at `" + a.kind + "`, not at the run step:\n" + clip(a.diagnostic)]
          else [],
        (_, err(e)) => [p.name + "/" + t.name + ": harness error: " + e],
        (err(e), _) => [p.name + "/" + t.name + ": harness error: " + e],
      }
      let problems = pos + neg
      println("  " + p.name + " / " + t.name + ": " + (if list.is_empty(problems) then "ok" else "PROBLEM"))
      problems
    },
  }
}

effect fn cmd_verify(o: Opts) -> Unit! = {
  let tasks = load_tasks(o.tasks)!
  let probes = probe_all(o.languages)!
  probes |> list.map((pr) => println((if pr.available then "verifying " else "skipping  ") + pr.plugin.display + ": " + toolchain_line(pr)))
  let available = probes |> list.filter((pr) => pr.available)
  // A language NAMED on the command line and then not measured is a
  // failure, not a skip: `make msr-verify LANGUAGES=zig` going green
  // because the Zig install step broke is exactly the silence to avoid.
  // Without --languages, a missing toolchain is a skip.
  let demanded = if list.is_empty(o.languages) then []
    else probes |> list.filter((pr) => not pr.available)
      |> list.map((pr) => pr.plugin.name + ": asked for by --languages but " + pr.missing + " is missing")
  let raw_dir = o.out + "/verify/raw"
  fs.mkdir_p(raw_dir)!
  let problems = demanded + (available |> list.flat_map((pr) => (tasks |> list.flat_map((t) => verify_one(pr, t, raw_dir)!))!))!
  println("")
  if list.is_empty(problems) then {
    println("verify: " + int.to_string(list.len(tasks)) + " task(s) x " + int.to_string(list.len(available)) + " language(s) ok" +
      (if list.len(available) < list.len(probes) then " (" + int.to_string(list.len(probes) - list.len(available)) + " language(s) skipped: toolchain missing)" else ""))
    ok(())
  } else {
    problems |> list.map((p) => println("PROBLEM " + p))
    println("verify: " + int.to_string(list.len(problems)) + " problem(s)")
    process.exit(1)
  }
}

effect fn dispatch(o: Opts) -> Unit! = match o.command {
  "run" => ok(cmd_run(o)!),
  "verify" => ok(cmd_verify(o)!),
  "probe" => ok(cmd_probe(o)!),
  "prompt" => ok(cmd_prompt(o)!),
  "verdict" => ok(cmd_verdict(o)!),
  _ => err("usage: almide run src/msr/run.almd -- run <provider:model> | verify | probe | prompt <language> <task> | verdict <run-dir>"),
}

effect fn main() -> Unit = {
  let args = env.args()
  match parse_opts(args, default_opts()) {
    err(e) => {
      println("error: " + e)
      process.exit(2)
    },
    ok(o0) => {
      let command = list.get(o0.rest, 0) ?? ""
      let o = { ...o0, command: command, model: if command == "run" then list.get(o0.rest, 1) ?? "" else "" }
      match dispatch(o) {
        ok(_) => (),
        err(e) => {
          println("Harness error: " + e)
          process.exit(2)
        },
      }
    },
  }
}

// ── Tests ──

// The incident this encodes: on 2026-09-22 a one-task smoke run and that
// day's 21-task cross-language run resolved to the SAME directory, and the
// smoke won because it ran second. Both were real runs of the same model on
// the same day; only one of them was a measurement.
test "a labelled run cannot occupy the measurement's directory" {
  let measured = run_dir("runs/msr", "2026-09-22", "cf:@cf/meta/llama-3.3-70b", "")
  let smoke = run_dir("runs/msr", "2026-09-22", "cf:@cf/meta/llama-3.3-70b", "smoke")
  assert(measured != smoke, "a labelled run must not share the unlabelled run's path")
  assert(measured == "runs/msr/2026-09-22/cf_cf_meta_llama-3-3-70b", "the measurement keeps the canonical path")
  assert(smoke == "runs/msr/2026-09-22/cf_cf_meta_llama-3-3-70b-smoke", "a label lands beside it, not on top of it")
}

// Two DIFFERENT labels must also not collide, or the second experiment eats
// the first for the same reason one directory down.
test "two labels are two directories, and a label is path-safe" {
  let a = run_dir("runs/msr", "2026-09-22", "cf:m", "pinned sampling, certified")
  let b = run_dir("runs/msr", "2026-09-22", "cf:m", "smoke")
  assert(a != b, "distinct labels must not collide")
  assert(not string.contains(a, " "), "a label with spaces must not reach the path")
  assert(not string.contains(a, ","), "a label with punctuation must not reach the path")
  assert(a == "runs/msr/2026-09-22/cf_m-pinned-sampling-certified", "expected the slugged label")
}

// Whitespace is not a label. `--label " "` must leave the measurement path
// alone rather than create a directory ending in a dash.
test "a blank label is no label" {
  assert(run_dir("o", "d", "cf:m", "   ") == run_dir("o", "d", "cf:m", ""), "a blank label is no label")
}

test "parse_opts reads every option and keeps positionals in order" {
  let o = parse_opts(["run", "cf:x", "--languages", "almide, rust", "--tasks", "gcd", "--retries", "2", "--label", "smoke"], default_opts())
  assert_eq(o |> result.map((o) => o.rest), ok(["run", "cf:x"]))
  assert_eq(o |> result.map((o) => o.languages), ok(["almide", "rust"]))
  assert_eq(o |> result.map((o) => o.retries), ok(2))
  assert_eq(o |> result.map((o) => o.label), ok("smoke"))
  assert(result.is_err(parse_opts(["--condition", "relaxed"], default_opts())))
  assert_eq(o |> result.map((o) => o.conditions), ok(["shipped", "unmentioned"]))
  assert(result.is_err(parse_opts(["--bogus"], default_opts())))
}

test "perturb changes every literal kind and stays well-typed" {
  assert_eq(perturb(spec.vint(1), TInt), spec.vint(2))
  assert_eq(perturb(spec.vbool(true), TBool), spec.vbool(false))
  assert_eq(perturb(spec.vstr("a"), TStr), spec.vstr("ax"))
  assert_eq(perturb(spec.vlist([]), spec.tlist(TInt)), spec.vlist([spec.vint(0)]))
  assert_eq(perturb(spec.vlist([spec.vint(4), spec.vint(5)]), spec.tlist(TInt)), spec.vlist([spec.vint(5), spec.vint(5)]))
  assert_eq(perturb(spec.vlist([]), spec.tlist(spec.tlist(TInt))), spec.vlist([spec.vlist([])]))
  assert_eq(perturb(spec.vlist([spec.vlist([spec.vint(1)])]), spec.tlist(spec.tlist(TInt))), spec.vlist([spec.vlist([spec.vint(2)])]))
}

test "the user prompt names the language and carries every signature" {
  let t = PTask {
    name: "gcd", dir: "tasks/basic/gcd",
    sigs: [spec.parse_sig("fn gcd(a: Int, b: Int) -> Int")!],
    behavior: "- Return the greatest common divisor",
    cases: [],
  }
  let rust = plugins.find("rust")!
  let up = user_prompt(rust, t)
  assert(string.contains(up, "in Rust with this exact signature"))
  assert(string.contains(up, "fn gcd(a: i64, b: i64) -> i64"))
  assert(string.contains(up, "Return the greatest common divisor"))
  assert(string.starts_with(system_prompt(rust), "You are writing Rust."))
  let alm = plugins.find("almide")!
  assert(string.contains(user_prompt(alm, t), "fn gcd(a: Int, b: Int) -> Int"))
  // Every language's prompt is the neutral one with the language name and
  // the rendered signature substituted, and nothing else.
  let np = neutral_prompt(t)
  assert_eq(np |> string.replace("<Language>", "Rust") |> string.replace("fn gcd(a: Int, b: Int) -> Int", "fn gcd(a: i64, b: i64) -> i64"), up)
  assert_eq(np |> string.replace("<Language>", "Almide"), user_prompt(alm, t))
  assert(string.starts_with(system_prompt(alm), "You are writing Almide. Output ONLY source code, no fences or prose.\n\n## Prefer stdlib helpers"))
}

// ── The cell vocabulary and the verdict ──

fn t_task(name: String) -> PTask =
  PTask { name: name, dir: "", sigs: [], behavior: "", cases: [] }

fn t_cell(lang: String, task: String, ok_: Bool, reached_: Bool) -> LResult = LResult {
  language: lang, condition: COND_SHIPPED, task: task, success: ok_, retries: 0,
  attempts: if reached_ then [LAttempt { code: "", kind: "", diagnostic: "", passed: ok_ }] else [],
  reason: if reached_ then "" else "read timed out waiting for the server",
}

test "an unavailable language renders as harness-limitation, never as a failure" {
  let zig = plugins.find("zig")!
  let pr = Probe { plugin: zig, available: false, missing: "zig", versions: [] }
  let row = language_row(pr, [t_task("gcd")], [t_cell("zig", "gcd", false, false)])
  assert(string.contains(row, "not measured: zig missing"))
  assert(string.contains(row, "harness-limitation"))
  // Never a rate: a language with no toolchain has no pass rate at all.
  assert(not string.contains(row, "%"))
}

test "every rate's denominator is the planned task count, and an incomplete row says so in the number" {
  let alm = plugins.find("almide")!
  let pr = Probe { plugin: alm, available: true, missing: "", versions: [("almide", "almide 0.62.0")] }
  let tasks = ["a", "b", "c", "d"] |> list.map(t_task)
  // Three of four reached, all three passed: the old renderer printed
  // "3/3 (100%)" beside another language's "4/4 (100%)".
  let cells = [t_cell("almide", "a", true, true), t_cell("almide", "b", true, true),
               t_cell("almide", "c", true, true), t_cell("almide", "d", false, false)]
  let row = language_row(pr, tasks, cells)
  assert(not string.contains(row, "3/3"))
  assert(string.contains(row, "3/4 (75%–100%)"))
  assert(string.contains(row, "1 not-run"))
  // A complete row's interval collapses to the point that IS comparable.
  let whole = [t_cell("almide", "a", true, true), t_cell("almide", "b", true, true),
               t_cell("almide", "c", true, true), t_cell("almide", "d", true, true)]
  assert(string.contains(language_row(pr, tasks, whole), "4/4 (100%)"))
  assert(not string.contains(language_row(pr, tasks, whole), "–"))
}

test "the four cell states partition the planned grid" {
  assert_eq(list.len(CELL_STATES), 4)
  let reachedc = t_cell("almide", "a", true, true)
  let absent = t_cell("almide", "b", false, false)
  assert_eq(state_of(true, reachedc, false), ST_MEASURED)
  assert_eq(state_of(true, reachedc, true), ST_SATURATED)
  assert_eq(state_of(true, absent, false), ST_NOT_RUN)
  // No toolchain outranks everything else: the cell was never measurable.
  assert_eq(state_of(false, reachedc, false), ST_HARNESS)
  assert_eq(state_of(false, absent, true), ST_HARNESS)
}

test "a run whose languages saw different task counts is refused as a comparison" {
  let tasks4 = 4
  let langs = [("almide", "Almide"), ("rust", "Rust")]
  // Today's shape: Almide reached 3 of 4, Rust reached 4 of 4, everything passed.
  let uneven = [t_cell("almide", "a", true, true), t_cell("almide", "b", true, true),
                t_cell("almide", "c", true, true), t_cell("almide", "d", false, false),
                t_cell("rust", "a", true, true), t_cell("rust", "b", true, true),
                t_cell("rust", "c", true, true), t_cell("rust", "d", true, true)]
  let v = verdict_core(langs, tasks4, uneven)
  assert_eq(v.id, "not-comparable")
  assert(not v.comparable)
  assert(string.contains(string.join(v.reasons, " "), "Almide 3/4"))
  // A language with no toolchain is NOT part of the comparison, so it cannot
  // make a run non-comparable by being absent.
  let complete = [t_cell("almide", "a", true, true), t_cell("almide", "b", true, true),
                  t_cell("almide", "c", true, true), t_cell("almide", "d", true, true),
                  t_cell("rust", "a", true, true), t_cell("rust", "b", true, true),
                  t_cell("rust", "c", true, true), t_cell("rust", "d", true, true),
                  t_cell("zig", "a", false, false), t_cell("zig", "b", false, false),
                  t_cell("zig", "c", false, false), t_cell("zig", "d", false, false)]
  assert(verdict_core(langs, tasks4, complete).comparable)
}

test "the saturation threshold is a rate, not a zero-failure count" {
  // almide-dojo#3: >= 98% of the cells a language measured. At 21 tasks that
  // is 21/21; at 100 it is 98/100, and the rule must catch the second too.
  let mk = (lang: String, pass: Int, fail: Int) =>
    (list.range(0, pass) |> list.map((i) => t_cell(lang, "p" + int.to_string(i), true, true))) +
    (list.range(0, fail) |> list.map((i) => t_cell(lang, "f" + int.to_string(i), false, true)))
  assert(is_saturated(mk("almide", 98, 2) + mk("rust", 100, 0)))
  assert(not is_saturated(mk("almide", 97, 3) + mk("rust", 100, 0)))
  // One language below the threshold is enough: the bank discriminated there.
  assert(not is_saturated(mk("almide", 100, 0) + mk("rust", 90, 10)))
  // 20/21 is 95.2%, so the 21-task bank saturates only at a clean sweep.
  assert(not is_saturated(mk("almide", 20, 1)))
  assert(is_saturated(mk("almide", 21, 0)))
}

test "a run in which every measured cell passes is inconclusive-saturated, and one failure is enough to clear it" {
  let langs = [("almide", "Almide"), ("rust", "Rust")]
  let all_pass = [t_cell("almide", "a", true, true), t_cell("almide", "b", true, true),
                  t_cell("rust", "a", true, true), t_cell("rust", "b", true, true)]
  let v = verdict_core(langs, 2, all_pass)
  assert_eq(v.id, ST_SATURATED)
  // Saturated is still a valid comparison — it is just not evidence.
  assert(v.comparable)
  assert(not v.conclusive)
  // The negative control: a gate that fires on every run is the same as one
  // that never fires, so ONE failing cell must clear the verdict.
  let one_fail = [t_cell("almide", "a", true, true), t_cell("almide", "b", true, true),
                  t_cell("rust", "a", true, true), t_cell("rust", "b", false, true)]
  let v2 = verdict_core(langs, 2, one_fail)
  assert_eq(v2.id, "comparable")
  assert(v2.comparable)
  assert(v2.conclusive)
  assert(list.is_empty(v2.reasons))
  // ...and the per-cell state follows the run, not the cell's own outcome.
  assert_eq(state_of(true, t_cell("almide", "a", true, true), is_saturated(all_pass)), ST_SATURATED)
  assert_eq(state_of(true, t_cell("almide", "a", true, true), is_saturated(one_fail)), ST_MEASURED)
}

test "a run that reached nothing is refused, and the verdict travels into the table" {
  let langs = [("almide", "Almide")]
  let none_reached = [t_cell("almide", "a", false, false), t_cell("almide", "b", false, false)]
  let v = verdict_core(langs, 2, none_reached)
  assert_eq(v.id, "nothing-measured")
  assert(not v.comparable)
  // The table carries the verdict above the numbers, not under them.
  let block = verdict_block(verdict_core(langs, 2, [t_cell("almide", "a", true, true), t_cell("almide", "b", true, true)]))
  assert(string.contains(block, "inconclusive-saturated"))
  assert(string.contains(block, "certified as a comparison: **yes**"))
  assert(string.contains(block, "the bank discriminated: **no**"))
}

test "the rendered table states the verdict above the numbers, not under them" {
  let alm = plugins.find("almide")!
  let rust = plugins.find("rust")!
  let probes = [
    Probe { plugin: alm, available: true, missing: "", versions: [("almide", "almide 0.62.0")] },
    Probe { plugin: rust, available: true, missing: "", versions: [("rustc", "rustc 1.98.1")] },
  ]
  let tasks = ["a", "b"] |> list.map(t_task)
  // The 2026-09-22 GLM shape in miniature: Almide reached one of two tasks,
  // Rust reached both, and everything that ran passed.
  let cells = [t_cell("almide", "a", true, true), t_cell("almide", "b", false, false),
               t_cell("rust", "a", true, true), t_cell("rust", "b", true, true)]
  let v = verdict_of(probes, tasks, cells)
  let o = { ...default_opts(), model: "cf:m", label: "" }
  let tbl = render_table(o, "2026-09-22", "rev", probes, tasks, cells, [], v)
  let banner = string.index_of(tbl, "Verdict: `not-comparable`")
  let header = string.index_of(tbl, "| language | toolchain |")
  assert(option.is_some(banner))
  assert((banner ?? 0) < (header ?? 0))
  // The two rows can no longer be read as equal: one is an interval.
  assert(string.contains(tbl, "1/2 (50%–100%)"))
  assert(string.contains(tbl, "2/2 (100%)"))
  // ...and the absent cell is named, not blank and not a zero.
  assert(string.contains(tbl, "| `b` | not-run | pass |"))
}

test "the full grid names every planned cell, including a language with no toolchain" {
  let alm = plugins.find("almide")!
  let zig = plugins.find("zig")!
  let probes = [
    Probe { plugin: alm, available: true, missing: "", versions: [("almide", "almide 0.62.0")] },
    Probe { plugin: zig, available: false, missing: "zig", versions: [] },
  ]
  let tasks = ["a", "b"] |> list.map(t_task)
  let grid = full_grid(probes, tasks, [t_cell("almide", "a", true, true)])
  assert_eq(list.len(grid), 4)
  assert(list.any(grid, (r) => r.language == "zig" and r.task == "b"))
  let sat = is_saturated(grid)
  assert_eq(count_state(grid, probes, sat, ST_HARNESS), 2)
  assert_eq(count_state(grid, probes, sat, ST_NOT_RUN), 1)
  assert_eq(count_state(grid, probes, sat, ST_SATURATED), 1)
  assert_eq(count_state(grid, probes, sat, ST_MEASURED), 0)
  // The four states partition the grid exactly.
  assert_eq(CELL_STATES |> list.map((s) => count_state(grid, probes, sat, s)) |> list.sum, list.len(grid))
}

// ── The effect-declaration A/B (almide-dojo#2) ──

fn t_bcell(task: String, ok_: Bool, reached_: Bool) -> LResult =
  { ...t_cell("almide", task, ok_, reached_), condition: COND_UNMENTIONED }

fn t_probe(p: Plugin) -> Probe = Probe { plugin: p, available: true, missing: "", versions: [(p.name, p.name + " 1.0")] }

test "the A/B is planned by default, on the Almide leg only, and --conditions shipped leaves it out" {
  let d = default_opts()
  assert_eq(d.conditions, ["shipped", "unmentioned"])
  let alm = plugins.find("almide")!
  let rs = plugins.find("rust")!
  // Almide runs both arms, task by task; every other language runs A only —
  // the A/B adds exactly one Almide pass over the task set and nothing else.
  assert_eq(legs_for(alm, d.conditions) |> list.map(((c, _)) => c), ["shipped", "unmentioned"])
  assert_eq(legs_for(rs, d.conditions) |> list.map(((c, _)) => c), ["shipped"])
  // B changes the Almide notes and nothing else about the plugin.
  let b = plugin_for(alm, COND_UNMENTIONED)
  assert(b.notes != alm.notes)
  assert_eq(b.notes, prompts.without_effect_notes(alm.notes))
  assert_eq(plugin_for(rs, COND_UNMENTIONED).notes, rs.notes)
  let t = PTask { name: "gcd", dir: "", sigs: [spec.parse_sig("fn gcd(a: Int, b: Int) -> Int")!], behavior: "- gcd", cases: [] }
  assert_eq(user_prompt(b, t), user_prompt(alm, t))
  assert(not string.contains(string.to_lower(system_prompt(b)), "effect"))
  assert(string.contains(system_prompt(alm), "effect fn"))
  // Selection.
  assert_eq(parse_opts(["--conditions", "shipped"], d) |> result.map((o) => o.conditions), ok(["shipped"]))
  assert_eq(parse_opts(["--conditions", "unmentioned,shipped"], d) |> result.map((o) => o.conditions), ok(["shipped", "unmentioned"]))
  assert_eq(parse_opts(["--condition", "shipped"], d) |> result.map((o) => o.conditions), ok(["shipped"]))
  assert(result.is_err(parse_opts(["--conditions", "unmentioned"], d)), "a run without the A arm has no table")
  assert(result.is_err(parse_opts(["--conditions", "shipped,relaxed"], d)))
  // A run whose languages leave Almide out plans no B arm.
  let rust_only = [Probe { plugin: rs, available: true, missing: "", versions: [] }]
  assert_eq(extra_conditions(d.conditions, rust_only), [])
  assert_eq(extra_conditions(d.conditions, [t_probe(alm), t_probe(rs)]), ["unmentioned"])
  assert_eq(extra_conditions(["shipped"], [t_probe(alm), t_probe(rs)]), [])
}

test "the manifest records every planned condition and the A/B's own verdict and arms" {
  let probes = [t_probe(plugins.find("almide")!), t_probe(plugins.find("rust")!)]
  let tasks = ["a", "b"] |> list.map(t_task)
  let a = [t_cell("almide", "a", true, true), t_cell("almide", "b", false, true),
           t_cell("rust", "a", true, true), t_cell("rust", "b", true, true)]
  let b = [t_bcell("a", true, true), t_bcell("b", true, true)]
  let cs = conditions_json(default_opts().conditions, probes, tasks)
  let names = json.stringify(cs)
  assert(string.contains(names, "\"name\":\"shipped\""))
  assert(string.contains(names, "\"name\":\"unmentioned\""))
  assert(string.contains(names, "\"languages\":[\"almide\",\"rust\"]"), "shipped runs every language")
  assert(string.contains(names, "\"languages\":[\"almide\"]"), "unmentioned runs Almide only")
  assert(string.contains(names, "notes_lines_changed"), "B names the lines it removed or cut")
  assert(string.contains(names, "Calling an `effect fn`"), "the removed rule is quoted verbatim")
  let ab = json.stringify(ab_json(default_opts().conditions, probes, tasks, a, b))
  assert(string.contains(ab, "\"b\":\"unmentioned\""))
  assert(string.contains(ab, "\"id\":\"comparable\""))
  assert(string.contains(ab, "\"final_pass\":\"1/2 (50%)\""), "arm A is the shipped Almide row")
  assert(string.contains(ab, "\"final_pass\":\"2/2 (100%)\""), "arm B is its own cells")
  // No B arm planned: the record says so with null, not with an empty arm.
  assert_eq(ab_json(["shipped"], probes, tasks, a, []), value.null())
}

test "the A/B is refused as a comparison when its arms saw different task counts, and saturation is named" {
  let a = [t_cell("almide", "a", true, true), t_cell("almide", "b", false, true)]
  let v = ab_verdict(2, a, [t_bcell("a", true, true), t_bcell("b", false, false)], COND_UNMENTIONED)
  assert_eq(v.id, "not-comparable")
  assert(string.contains(string.join(v.reasons, " "), "unmentioned 1/2"))
  let sat = ab_verdict(2, [t_cell("almide", "a", true, true), t_cell("almide", "b", true, true)],
                       [t_bcell("a", true, true), t_bcell("b", true, true)], COND_UNMENTIONED)
  assert_eq(sat.id, ST_SATURATED)
  assert_eq(ab_verdict(2, a, [], COND_UNMENTIONED).id, "nothing-measured")
}

test "the table renders the two arms side by side, and the B arm never enters the cross-language verdict" {
  let probes = [t_probe(plugins.find("almide")!), t_probe(plugins.find("rust")!)]
  let tasks = ["a", "b"] |> list.map(t_task)
  let cells = [t_cell("almide", "a", true, true), t_cell("almide", "b", false, true),
               t_cell("rust", "a", true, true), t_cell("rust", "b", true, true)]
  let b = [t_bcell("a", true, true), { ...t_bcell("b", true, true), retries: 1 }]
  let v = verdict_of(probes, tasks, cells)
  let o = { ...default_opts(), model: "cf:m" }
  let tbl = render_table(o, "2026-09-25", "rev", probes, tasks, cells, b, v)
  assert(string.contains(tbl, "`unmentioned` (Almide only"))
  assert(string.contains(tbl, "## Effect-declaration A/B (almide-dojo#2)"))
  assert(string.contains(tbl, "A/B verdict: `comparable`"))
  assert(string.contains(tbl, "| Almide · `shipped` |"))
  assert(string.contains(tbl, "| Almide · `unmentioned` |"))
  assert(string.contains(tbl, "| `b` | FAIL | pass@1 |"), "per task, A beside B")
  // The A/B section comes after the cross-language table, never inside it.
  assert((string.index_of(tbl, "## Per task") ?? 0) < (string.index_of(tbl, "## Effect-declaration A/B") ?? 0))
  // B cells do not move the cross-language verdict or its rows.
  let with_b = cells + b
  assert_eq(verdict_core([("almide", "Almide"), ("rust", "Rust")], 2, shipped_cells(with_b)).id, v.id)
  assert(string.contains(language_row(t_probe(plugins.find("almide")!), tasks, with_b), "1/2 (50%)"))
  // A run without the B arm renders no A/B section.
  let plain = render_table({ ...o, conditions: ["shipped"] }, "2026-09-25", "rev", probes, tasks, cells, [], v)
  assert(not string.contains(plain, "Effect-declaration A/B"))
  // The missing B cell is synthesised with its reason, like full_grid.
  let grid = condition_grid(probes, tasks, [t_bcell("a", true, true)], COND_UNMENTIONED)
  assert_eq(list.len(grid), 2)
  assert(list.any(grid, (r) => r.task == "b" and list.is_empty(r.attempts) and r.condition == COND_UNMENTIONED))
}
