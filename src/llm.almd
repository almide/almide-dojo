// Model access shared by the daily lane (main.almd) and the cross-language
// lane (msr/run.almd).
//
// Model specs are `provider:model`:
//   cf:@cf/meta/llama-3.3-70b-instruct-fp8-fast   Cloudflare Workers AI
//   anthropic:claude-sonnet-5                      Anthropic Messages API
//   openrouter:meta-llama/llama-3.3-70b-instruct   OpenRouter
//   openai:<model>                                 OpenAI API
//   cli:claude                                     Claude Code CLI (`claude -p`, no API key)
// An unprefixed `claude-*` is the Anthropic Messages API (ANTHROPIC_API_KEY),
// NOT the Claude CLI; any other unprefixed name is OpenAI.

import almai
import json

fn strip_code_fences(s: String) -> String =
  s
    |> string.split("\n")
    |> list.filter((line) => not string.starts_with(string.trim(line), "```"))
    |> string.join("\n")

fn to_almai_spec(model: String) -> String = {
  // "cf:@cf/meta/..." → "cf/@cf/meta/..."
  // "anthropic:claude-..." → "anthropic/claude-..."
  // "cli:claude" → "cli/claude"
  // "claude-sonnet-5" (no prefix) → "anthropic/claude-sonnet-5"
  let colon = string.index_of(model, ":")
  match colon {
    some(i) => string.take(model, i) + "/" + string.drop(model, i + 1)
    none => if string.starts_with(model, "claude") then "anthropic/" + model
      else "openai/" + model
  }
}

// The provider half of a spec, as almai dispatches on it.
fn provider_of(model: String) -> String = {
  let spec = to_almai_spec(model)
  match string.index_of(spec, "/") {
    some(i) => string.take(spec, i)
    none => "openai"
  }
}

// The seed every measured call is pinned at.
//
// A cross-language table is only citable if a third party can re-run it, so
// the run asks for a fixed seed rather than letting each provider roll its
// own. 0 is almai's "unset" sentinel and would silently mean "no seed", so
// the value is deliberately non-zero; Cloudflare documents the valid range
// as 1..=9_999_999_999 and this sits inside it. `seed_sent` in the manifest
// says whether the provider actually wrote it into the request body —
// asking is not the same as being honoured, and neither is the same as the
// model obeying it (see almai's Sampling doc).
let SEED: Int = 20260922

// The output-token cap a model is asked for.
//
// almai's default is 4096, and a reasoning model spends its scratchpad out
// of the same cap before it writes a single character of the answer.
// Measured on @cf/zai-org/glm-5.3-flash (daily lane, 38 tasks, 2026-09-23):
// at 4096, 24 of 24 empty completions stopped at exactly 4096 completion
// tokens with finish_reason `length`; at 16384 the empties went to 0. The
// cap is raised only for the reasoning families, not for everyone: a Llama
// on Workers AI has a context window smaller than 16384 (llama-3.1-8b's is
// about 8k), so a global raise would trade a measured fix for an untested
// rejection on the nightly lane.
let REASONING_TOKEN_CAP: Int = 16384

fn is_reasoning_model(model: String) -> Bool =
  string.contains(model, "/glm-")

fn token_cap_for(model: String) -> Int =
  if is_reasoning_model(model) then REASONING_TOKEN_CAP else almai.defaults().max_tokens

// ONE construction of the request options, used by every call this harness
// makes and by the probe that reports them. Two expressions would be two
// places to remember, and the manifest would describe a request nobody sent.
fn opts_for(model: String, system: String, temperature: Float) -> almai.CallOptions =
  almai.defaults()
    |> almai.with_max_tokens(token_cap_for(model))
    |> almai.with_system(system)
    |> almai.with_temperature(temperature)
    |> almai.with_seed(SEED)

// What the provider PUT ON THE WIRE for these options, as a manifest-ready
// object.
//
// This used to be a table in this file that said, per provider, whether
// temperature reached the wire. It was written when almai's Cloudflare
// provider sent no sampling fields, it was pinned by a test asserting
// exactly that, and when almai started sending them the table kept printing
// `temperature_sent: false` — green tests, stale answer, and a run that WAS
// pinned published a manifest declaring it was not. A local mirror of a
// remote fact drifts silently; this reads the fact.
//
// `r.sampling` is almai's echo of the request it built, so the values below
// are a projection of it and cannot disagree with it.
// A value is printed only when its `*_sent` companion says it was written:
// a number beside `sent: false` is the provider's default, not this run's
// setting, and printing one would claim a pinned run.
fn sent_or_null(sent: Bool, v: Value) -> Value = if sent then v else value.null()

fn sampling_fields(s: almai.Sampling) -> List[(String, Value)] = [
  ("temperature_sent", value.bool(s.temperature_sent)),
  ("temperature", sent_or_null(s.temperature_sent, value.float(s.temperature))),
  ("top_p_sent", value.bool(s.top_p_sent)),
  ("top_p", sent_or_null(s.top_p_sent, value.float(s.top_p))),
  ("max_tokens_sent", value.bool(s.max_tokens_sent)),
  ("max_tokens", sent_or_null(s.max_tokens_sent, value.int(s.max_tokens))),
  ("seed_sent", value.bool(s.seed_sent)),
  ("seed", sent_or_null(s.seed_sent, value.int(s.seed))),
]

// Resolve the echo by making one real, tiny call with the run's own options.
//
// Deriving it instead — a second dispatch on the provider name — would be
// the same mirror one level up. This asks the wire. It doubles as the
// credential preflight the empty-completion guard below exists for: a run
// on a dead key fails here, before it has scored a single task as 0.
effect fn probe_sampling(model: String, temperature: Float) -> Result[List[(String, Value)], String] = {
  let opts = opts_for(model, "Reply with the single word OK.", temperature)
  match almai.call_retry(to_almai_spec(model), [almai.user("OK")], opts, 2) {
    err(e) => err("sampling probe failed for '" + model + "': " + e)
    ok(r) => ok(sampling_fields(r.sampling))
  }
}

// A completion that is empty once the fences are stripped is NOT a
// measurement, and must never reach the scorer.
//
// Cloudflare Workers AI answers a bad credential, an exhausted quota or an
// unknown model name with HTTP 200 and a body that carries no `result`
// ({"success":false,"errors":[...]}), which almai's cloudflare provider maps
// to `ok(LLMResponse { content: "" })`. Handed to the judge, an empty source
// file is a compile failure, so a whole run on a broken key publishes a
// table of 0% as if the model had been measured — the failure mode is
// silent and the number looks like evidence. Refuse it here: the caller
// records a harness error, which both lanes count as "not measured".
fn is_empty_completion(content: String) -> Bool = string.trim(strip_code_fences(content)) == ""

// WHY it was empty, from the response, instead of a list of things it might
// have been.
//
// The message used to say "a credential, quota or model-name failure can
// answer 200 with no completion" and stop there. Measured 2026-09-23: GLM
// 5.3 Flash left 10 of 38 tasks unreached through this path, and **none of
// those three guesses was the cause** — the credential was good (other
// models ran on it in the same job) and the model name resolved. The message
// named three causes it had not checked and omitted the one that applied.
//
// What the response actually carries is enough to tell them apart, and it
// was already in scope:
//
//   finish_reason "length"  the generation hit the token cap. For a model
//                           with a reasoning scratchpad this is the likely
//                           shape — the budget goes to the scratchpad and
//                           `content` comes back empty — and it is a
//                           BUDGET problem, not a credential one.
//   finish_reason ""        the provider reported none (see almai#12: "" is
//                           "not reported", never the good case).
//   completion_tokens 0     nothing was generated at all, which IS the
//                           credential/quota/model-name shape.
//   completion_tokens > 0   tokens were spent and none of them reached
//                           `content`.
//
// This does not diagnose GLM here — it makes the next run say which it is,
// rather than this file guessing on the model's behalf.
fn empty_completion_reason(model: String, r: almai.LLMResponse) -> String = {
  let fr = if r.finish_reason == "" then "not reported" else r.finish_reason
  let spent = r.usage.completion_tokens
  let shape =
    if spent == 0 then "no tokens were generated at all — the credential, quota or model-name shape"
    else "the provider generated " + int.to_string(spent) + " completion token(s), none of which reached `content`"
  "empty completion from provider '" + provider_of(model) + "' (spec '" + model + "'): " + shape +
  "; finish_reason: " + fr +
  ". An empty file scored against the oracle would look like a model failure, so this is a harness error and the cell is not measured."
}

effect fn call(model: String, system: String, user_prompt: String, temperature: Float, max_attempts: Int) -> Result[String, String] = {
  let spec = to_almai_spec(model)
  let opts = opts_for(model, system, temperature)
  let msgs = [almai.user(user_prompt)]
  match almai.call_retry(spec, msgs, opts, max_attempts) {
    err(e) => err(e)
    ok(r) =>
      if is_empty_completion(r.content) then err(empty_completion_reason(model, r))
      else ok(strip_code_fences(r.content))
  }
}

test "an empty completion is a transport failure, never a scored attempt" {
  // The shape Cloudflare returns for a bad key, after almai maps it: 200 OK
  // with no `result`, i.e. an empty content string.
  assert(is_empty_completion(""))
  assert(is_empty_completion("   \n\n  "))
  // ...and the same once the model replies with nothing but a fence.
  assert(is_empty_completion("```almide\n```"))
  assert(not is_empty_completion("fn f() = 1"))
}

// The three shapes an empty completion can have. They used to produce ONE
// sentence naming three causes it had not checked; GLM 5.3 Flash then left 10
// of 38 tasks unreached (2026-09-23) for a cause that sentence did not list.
fn mk_response(content: String, finish: String, out_tokens: Int) -> almai.LLMResponse =
  almai.LLMResponse {
    content: content, model: "m", finish_reason: finish, tool_calls: [],
    usage: almai.Usage { prompt_tokens: 0, completion_tokens: out_tokens, total_tokens: out_tokens },
    sampling: almai.Sampling { },
  }

test "no tokens generated reads as the credential shape" {
  let m = empty_completion_reason("cf:x", mk_response("", "", 0))
  assert(string.contains(m, "no tokens were generated at all"), "expected the credential shape")
  assert(string.contains(m, "finish_reason: not reported"), "an unreported finish reason must say so")
}

// The shape that actually happened: tokens were spent and none reached
// `content`. A budget problem must not read as a credential problem.
test "tokens spent with nothing in content does not read as a credential failure" {
  let m = empty_completion_reason("cf:x", mk_response("", "length", 4096))
  assert(string.contains(m, "4096 completion token(s)"), "the token count must be reported")
  assert(string.contains(m, "finish_reason: length"), "the finish reason must be reported")
  assert(not string.contains(m, "no tokens were generated"), "a budget failure must not read as a credential failure")
}

test "the two shapes are distinguishable, which is the whole point" {
  let credential = empty_completion_reason("cf:x", mk_response("", "", 0))
  let budget = empty_completion_reason("cf:x", mk_response("", "length", 4096))
  assert(credential != budget, "two different causes must not print the same sentence")
}

// Whitespace and a bare fence are empty too — the refusal still fires, and
// it is the reason text that changed, not what counts as empty.
test "a fence-only completion is still refused" {
  assert(is_empty_completion("```almide\n```"), "a bare fence is empty")
  assert(not is_empty_completion("fn f() = 1"), "real source is not empty")
}

test "strip_code_fences removes triple backtick lines" {
  let raw = "```almide\nfn f() = 1\n```"
  assert_eq(strip_code_fences(raw), "fn f() = 1")
}

test "strip_code_fences leaves non-fenced text alone" {
  assert_eq(strip_code_fences("plain text"), "plain text")
}

test "to_almai_spec routes Sonnet 5 to the Anthropic provider with or without prefix" {
  assert_eq(to_almai_spec("anthropic:claude-sonnet-5"), "anthropic/claude-sonnet-5")
  assert_eq(to_almai_spec("claude-sonnet-5"), "anthropic/claude-sonnet-5")
  assert_eq(to_almai_spec("cf:@cf/meta/llama-3.1-8b-instruct"), "cf/@cf/meta/llama-3.1-8b-instruct")
}

test "the Claude CLI is spelled cli:claude, not a bare claude-* name" {
  assert_eq(to_almai_spec("cli:claude"), "cli/claude")
  assert_eq(provider_of("cli:claude"), "cli")
  assert_eq(provider_of("claude-sonnet-5"), "anthropic")
  assert_eq(provider_of("cf:@cf/meta/llama-3.1-8b-instruct"), "cf")
}

// The test that stood here asserted the deleted table: `not
// temperature_sent("cf")`. It was green on the day it was written and green
// on the day almai started sending temperature to Cloudflare, because what
// it checked was this file's memory of almai, not almai. A test over a
// mirror can only ever confirm the mirror.
//
// What is checkable locally is the projection: given an echo, the manifest
// object says exactly what the echo says. Whether the echo is true of the
// wire is almai's own test's job (spec/sampling_wire_test.almd), and which
// echo applies to a run is answered by probing, not by asserting.
test "the manifest fields report the echo, including a seed that went out" {
  let j = value.object(sampling_fields(almai.Sampling {
    temperature_sent: true, temperature: 0.0,
    max_tokens_sent: true, max_tokens: 4096, seed_sent: true, seed: SEED }))
  assert((json.get_bool(j, "temperature_sent") ?? false), "temperature_sent must follow the echo")
  assert((json.get_bool(j, "seed_sent") ?? false), "seed_sent must follow the echo")
  assert((json.get_int(j, "seed") ?? 0) == SEED, "the recorded seed is the one asked for")
  assert((json.get_int(j, "max_tokens") ?? 0) == 4096, "a sent value is printed")
}

// A provider that writes nothing must read as nothing — and each value must
// be null rather than its zero, so "not sent" and "sent as 0" stop looking
// alike. A `temperature: 0.0` beside `temperature_sent: false` is exactly
// the sentence that made a previous manifest unreadable: it looks like a
// pinned greedy run and means "the provider's default applied".
test "an echo that claims nothing records null, not zero" {
  let j = value.object(sampling_fields(almai.Sampling { }))
  assert(not (json.get_bool(j, "temperature_sent") ?? true), "temperature_sent must be false")
  assert(not (json.get_bool(j, "seed_sent") ?? true), "seed_sent must be false")
  assert(json.get_int(j, "seed") == none, "an unsent seed is null, never 0")
  assert(json.get_float(j, "temperature") == none, "an unsent temperature is null, never 0.0")
}

test "every measured call and the probe share one options construction" {
  // Not a style point: the probe's echo is only evidence about the run if
  // the run's requests are built by the same expression.
  let a = opts_for("cf:@cf/meta/llama-3.1-8b-instruct", "sys", 0.0)
  assert(a.seed == SEED, "the run pins a seed")
  assert(a.temperature == 0.0, "the requested temperature is carried")
  assert(a.system == "sys", "the system prompt is carried")
}

test "only a reasoning model gets the raised token cap" {
  assert(opts_for("cf:@cf/zai-org/glm-5.3-flash", "sys", 0.0).max_tokens == REASONING_TOKEN_CAP, "GLM spends its scratchpad out of the cap")
  assert(opts_for("cf:@cf/meta/llama-3.1-8b-instruct", "sys", 0.0).max_tokens == almai.defaults().max_tokens, "a Llama keeps almai's default, which its context window accepts")
  assert(opts_for("cf:@cf/meta/llama-3.3-70b-instruct-fp8-fast", "sys", 0.0).max_tokens == 4096, "the nightly lane's request is unchanged")
}
